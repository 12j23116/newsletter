---
import BaseLayout from '../../layouts/BaseLayout.astro';
import './contact-styles.css';
---
<BaseLayout title="Contact" description="Get in touch with the TechScope team. We love hearing from our readers.">
  <div class="container contact-page">
    <h1 class="contact-title">Contact Us</h1>
    <p class="contact-subtitle">
      Have a question, suggestion, or partnership idea? We would love to hear from you.
      Fill out the form below and we will get back to you within 48 hours.
    </p>

    <form class="contact-form" action="/api/contact" method="POST">
      <div class="contact-field">
        <label class="contact-label" for="name">Name</label>
        <input class="contact-input" type="text" id="name" name="name" required placeholder="Your name" />
      </div>
      <div class="contact-field">
        <label class="contact-label" for="email">Email</label>
        <input class="contact-input" type="email" id="email" name="email" required placeholder="you@example.com" />
      </div>
      <div class="contact-field">
        <label class="contact-label" for="subject">Subject</label>
        <input class="contact-input" type="text" id="subject" name="subject" required placeholder="What is this about?" />
      </div>
      <div class="contact-field">
        <label class="contact-label" for="message">Message</label>
        <textarea class="contact-textarea" id="message" name="message" required placeholder="Tell us more..."></textarea>
      </div>
      <button class="contact-submit" type="submit">Send Message</button>
    </form>
  </div>
</BaseLayout>
