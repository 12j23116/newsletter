---
import BaseLayout from '../../layouts/BaseLayout.astro';
import './about-styles.css';
---
<BaseLayout title="About" description="About TechScope — our mission, our values, and the team behind the technology guides.">
  <div class="container about-page">
    <h1 class="about-title">About TechScope</h1>
    <p class="about-subtitle">
      TechScope is a platform dedicated to making emerging technologies accessible to everyone.
      We cover 12 technology frontiers — from AI to fusion energy — with deep-dive guides that are
      explained simply and backed by research.
    </p>

    <div class="about-section">
      <h2>Our Mission</h2>
      <p>
        To demystify emerging technologies and help people understand the innovations shaping our future.
        We believe that technology literacy is essential, and that complex topics can be explained clearly
        without dumbing them down.
      </p>
    </div>

    <div class="about-section">
      <h2>What We Cover</h2>
      <p>
        We cover 12 emerging technology categories: Artificial Intelligence, Cybersecurity, Space Exploration,
        Biotechnology, Nuclear Energy, Energy Storage, Robotics, Autonomous Vehicles, Quantum Computing,
        Advanced Materials, Brain-Computer Interfaces, and Nuclear Fusion.
      </p>
    </div>

    <div class="about-section">
      <h2>Our Values</h2>
      <div class="about-values">
        <div class="about-value-card">
          <h3>Accuracy</h3>
          <p>Every article is researched and fact-checked. We cite sources and update content as technology evolves.</p>
        </div>
        <div class="about-value-card">
          <h3>Accessibility</h3>
          <p>Complex topics explained simply. No jargon without explanation. No assumptions about prior knowledge.</p>
        </div>
        <div class="about-value-card">
          <h3>Independence</h3>
          <p>We are not sponsored by any company. Our guides are objective and unbiased.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
