---
/**
 * Footer Component
 * ────────────────
 * Edit this file and footer.css independently.
 * Changes here do NOT affect other pages or components.
 */
import './footer.css';

const footerLinks = {
  categories: [
    { label: 'Artificial Intelligence', href: '/categories/AI' },
    { label: 'Cybersecurity', href: '/categories/Cybersecurity' },
    { label: 'Space Exploration', href: '/categories/Space' },
    { label: 'Biotechnology', href: '/categories/Biotech' },
    { label: 'Nuclear Energy', href: '/categories/Nuclear' },
    { label: 'Robotics', href: '/categories/Robotics' },
  ],
  resources: [
    { label: 'Blog', href: '/blog' },
    { label: 'Guides', href: '/guides' },
    { label: 'Tools', href: '/tools' },
    { label: 'Newsletter', href: '/newsletter' },
    { label: 'About Us', href: '/about' },
    { label: 'Contact', href: '/contact' },
  ],
  legal: [
    { label: 'Privacy Policy', href: '/privacy' },
    { label: 'Terms of Service', href: '/terms' },
    { label: 'Cookie Policy', href: '/cookies' },
  ],
};

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="TechScope home">
          <svg class="footer-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 6L26 26H6L16 6Z" fill="url(#footer-grad)" stroke="url(#footer-grad)" stroke-width="1.5" stroke-linejoin="round"/>
            <circle cx="16" cy="20" r="3" fill="#fff" opacity="0.9"/>
            <defs>
              <linearGradient id="footer-grad" x1="6" y1="6" x2="26" y2="26">
                <stop stop-color="#3380ff"/>
                <stop offset="1" stop-color="#7c3aed"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="footer-logo-text">TechScope</span>
        </a>
        <p class="footer-tagline">
          Deep-dive guides on 12 emerging technology frontiers. Explained simply, backed by research.
        </p>
        <div class="footer-social">
          <a href="https://twitter.com/techscope" class="footer-social-link" aria-label="Twitter" rel="noopener" target="_blank">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.91l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://github.com/techscope" class="footer-social-link" aria-label="GitHub" rel="noopener" target="_blank">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <a href="/rss.xml" class="footer-social-link" aria-label="RSS Feed">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.503 20.752c0 1.426-1.158 2.585-2.583 2.585-1.425 0-2.583-1.159-2.583-2.585 0-1.425 1.158-2.584 2.583-2.584 1.425 0 2.583 1.159 2.583 2.584zm-5.503-12.572v3.811c5.361 0 9.72 4.359 9.72 9.721h3.811c.001-7.466-6.065-13.532-13.531-13.532zm0-6.68v3.808c9.617 0 17.448 7.831 17.448 17.448h3.807c0-11.726-9.529-21.256-21.255-21.256z"/></svg>
          </a>
        </div>
      </div>

      <!-- Categories Column -->
      <div>
        <h4 class="footer-col-title">Categories</h4>
        <div class="footer-col-links">
          {footerLinks.categories.map((link) => (
            <a href={link.href} class="footer-col-link">{link.label}</a>
          ))}
        </div>
      </div>

      <!-- Resources Column -->
      <div>
        <h4 class="footer-col-title">Resources</h4>
        <div class="footer-col-links">
          {footerLinks.resources.map((link) => (
            <a href={link.href} class="footer-col-link">{link.label}</a>
          ))}
        </div>
      </div>

      <!-- Legal Column -->
      <div>
        <h4 class="footer-col-title">Legal</h4>
        <div class="footer-col-links">
          {footerLinks.legal.map((link) => (
            <a href={link.href} class="footer-col-link">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {currentYear} TechScope. All rights reserved.
      </p>
      <div class="footer-legal">
        {footerLinks.legal.map((link) => (
          <a href={link.href} class="footer-legal-link">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
