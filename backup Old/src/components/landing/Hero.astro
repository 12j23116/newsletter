---
const marqueeItems = [
  'Artificial Intelligence', 'Quantum Computing', 'Fusion Energy', 'Biotech',
  'Autonomous Vehicles', 'Space Tech', 'Cybersecurity', 'Brain-Computer Interfaces',
  'Robotics', 'Nuclear SMRs', 'Energy Storage', 'Advanced Materials',
];
---

<section class="hero" id="hero">
  <div class="hero-bg"></div>
  <img src="/images/001-ai-neural-agent-cluster.webp" alt="" class="hero-bg-img" loading="eager" />
  <div class="hero-grid-overlay"></div>
  <div class="lv-orb hero-orb-1"></div>
  <div class="lv-orb hero-orb-2"></div>
  <div class="lv-orb hero-orb-3"></div>

  <div class="lv-container">
    <div class="hero-inner">
      <div class="hero-left">
        <div class="hero-pill">
          <span class="hero-live-dot"></span>
          <span>Tracking 12 emerging tech frontiers in real-time</span>
        </div>

        <h1 class="hero-h1">
          Decode Tomorrow's<br />
          <span class="lv-grad-text">Technology Today</span><br />
          Before It Arrives
        </h1>

        <p class="hero-sub">
          Deep-dive analysis across AI, Quantum, Fusion, Biotech, Space, and 7 more frontiers.
          Expert-curated intelligence for builders, investors, and the endlessly curious.
        </p>

        <div class="hero-ctas">
          <a href="#cat-group-1" class="lv-btn lv-btn-primary">
            Explore Categories
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
          <a href="#trending" class="lv-btn lv-btn-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
            Trending Now
          </a>
        </div>

        <div class="hero-trust">
          <div class="avatar-stack">
            <div class="avatar">R</div>
            <div class="avatar">D</div>
            <div class="avatar">E</div>
            <div class="avatar">M</div>
            <div class="avatar">S</div>
          </div>
          <div class="hero-trust-text">
            <strong>50,000+ monthly readers</strong>
            <div class="hero-trust-stars">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              <span>4.9 / 5</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-card">
          <div class="hero-card-header">
            <span class="hero-card-dot"></span>
            <span style="font-size:.75rem;color:rgba(255,255,255,.55);letter-spacing:.05em">Tech Adoption Index</span>
            <span class="hero-card-live">Live</span>
          </div>

          <div style="margin-bottom:1.2rem">
            <div class="hero-card-label">Frontiers Tracked</div>
            <div class="hero-card-value">12<span style="font-size:1rem;color:rgba(255,255,255,.4)"> / 12</span></div>
            <div class="hero-card-change">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M23 6l-9.5 9.5-5-5L1 18" />
                <path d="M17 6h6v6" />
              </svg>
              <span>+3 new this quarter</span>
            </div>
          </div>

          <div class="hero-card-asset">
            <div class="hero-card-asset-row">
              <span>AI &amp; Machine Learning</span><span style="color:rgba(255,255,255,.8)">92%</span>
            </div>
            <div class="hero-card-bar">
              <div class="hero-card-bar-fill" style="width:92%;background:#3b82f6"></div>
            </div>
          </div>
          <div class="hero-card-asset">
            <div class="hero-card-asset-row">
              <span>Quantum Computing</span><span style="color:rgba(255,255,255,.8)">45%</span>
            </div>
            <div class="hero-card-bar">
              <div class="hero-card-bar-fill" style="width:45%;background:#8b5cf6"></div>
            </div>
          </div>
          <div class="hero-card-asset">
            <div class="hero-card-asset-row">
              <span>Fusion Energy</span><span style="color:rgba(255,255,255,.8)">28%</span>
            </div>
            <div class="hero-card-bar">
              <div class="hero-card-bar-fill" style="width:28%;background:#ec4899"></div>
            </div>
          </div>

          <div class="hero-card-footer">
            <span class="mini-tag">AI</span>
            <span class="mini-tag">Quantum</span>
            <span class="mini-tag">Fusion</span>
            <span class="mini-tag">Biotech</span>
          </div>
        </div>

        <div class="floating-badge badge-top">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
            <path d="M22 4L12 14.01l-3-3" />
          </svg>
          <span>Real-time data</span>
        </div>
        <div class="floating-badge badge-bottom">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="2.5">
            <path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z" />
          </svg>
          <span>Trending now</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<div class="marquee">
  <div class="marquee-track">
    {[...Array(3)].map(() => (
      <span class="marquee-group">
        {marqueeItems.map((item) => (
          <>
            <span>{item}</span>
            <span class="marquee-sep">✦</span>
          </>
        ))}
      </span>
    ))}
  </div>
</div>
