---
const tools = [
  { name: 'AI ROI Calculator', desc: 'Estimate AI implementation returns', cat: 'AI', rating: '4.9', users: '35K/mo', color: '#3b82f6', img: '/images/ai-05-chip-fabrication.webp' },
  { name: 'Quantum Readiness Score', desc: 'Assess your quantum adoption stage', cat: 'Quantum', rating: '4.8', users: '12K/mo', color: '#8b5cf6', img: '/images/quantum-02-ion-trap-processor.webp' },
  { name: 'Fusion Timeline Tracker', desc: 'Track fusion milestones & breakthroughs', cat: 'Fusion', rating: '4.9', users: '8K/mo', color: '#ec4899', img: '/images/fusion-03-control-room.webp' },
  { name: 'Cybersecurity Risk Audit', desc: 'Evaluate your threat surface area', cat: 'Security', rating: '4.9', users: '50K/mo', color: '#ef4444', img: '/images/cyber-03-firewall-shield.webp' },
  { name: 'Biotech Pipeline Viewer', desc: 'Map clinical trial progress', cat: 'Biotech', rating: '4.8', users: '15K/mo', color: '#10b981', img: '/images/biotech-08-dna-sequencer.webp' },
  { name: 'SMR Cost Calculator', desc: 'Compare nuclear energy options', cat: 'Nuclear', rating: '4.7', users: '6K/mo', color: '#f59e0b', img: '/images/nuclear-02-control-room.webp' },
  { name: 'AV Maturity Index', desc: 'Benchmark autonomous vehicle progress', cat: 'AV', rating: '4.8', users: '10K/mo', color: '#06b6d4', img: '/images/av-03-lidar-pointcloud.webp' },
  { name: 'BCI Adoption Tracker', desc: 'Monitor brain-computer interface trends', cat: 'BCI', rating: '4.9', users: '4K/mo', color: '#8b5cf6', img: '/images/bci-06-fmri-mapping.webp' },
];
---

<section class="lv-section lv-section-light" id="tools">
  <div class="lv-container">
    <div class="lv-section-head reveal">
      <div class="lv-eyebrow">Free Interactive Tools</div>
      <h2 class="lv-section-h2">
        8+ tools to run<br />
        <span class="lv-grad-text-dark">the numbers that matter.</span>
      </h2>
      <p class="lv-section-sub">
        From AI ROI to fusion timelines, cybersecurity risk to quantum readiness — every tool is free, instant, and built for real-world decisions.
      </p>
    </div>

    <div class="tools-grid">
      {tools.map((t, i) => (
        <a href="#" class="tool-card reveal" style={`transition-delay:${i * 0.05}s`}>
          <div class="tool-thumb" style={`background:linear-gradient(135deg,${t.color}30,${t.color}10)`}>
            <img src={t.img} alt={t.name} class="tool-thumb-img" loading="lazy" />
            <div class="tool-thumb-overlay"></div>
            <span class="tool-cat">{t.cat}</span>
            <div class="tool-rating">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
              <span>{t.rating}</span>
            </div>
          </div>
          <div class="tool-body">
            <h3 class="tool-name">{t.name}</h3>
            <p class="tool-desc">{t.desc}</p>
            <div class="tool-footer">
              <span class="tool-users">{t.users}</span>
              <span class="tool-link">
                Open tool
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M13 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div style="text-align:center;margin-top:2.5rem" class="reveal">
      <a href="#" class="lv-btn lv-btn-outline">
        Browse all tools
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
