<section class="lv-section lv-section-dark" id="trending">
  <div class="lv-orb" style="width:300px;height:300px;background:var(--accent-blue);top:10%;left:-50px"></div>
  <div class="lv-container" style="position:relative;z-index:1">
    <div class="lv-section-head reveal">
      <div class="lv-eyebrow">Latest</div>
      <h2 class="lv-section-h2 lv-section-h2-light">
        Trending Now<br />
        <span class="lv-grad-text">across all frontiers.</span>
      </h2>
      <p class="lv-section-sub" style="color:var(--text-muted)">
        The most-read articles this week — from AI breakthroughs to fusion milestones, quantum advances to cybersecurity threats.
      </p>
    </div>

    <div class="trending-grid">
      {trending.map((t, i) => (
        <article class="trending-card reveal" style={`--card-gradient:${t.gradient};transition-delay:${i * 0.06}s`}>
          <div class="trending-card-cover">
            <img src={t.img} alt={t.title} class="trending-card-cover-img" loading="lazy" />
            <span class="trending-card-rank">{t.rank}</span>
            <span class="trending-card-tag">{t.tag}</span>
          </div>
          <div class="trending-card-body">
            <h3 class="trending-card-title">{t.title}</h3>
            <p class="trending-card-excerpt">{t.excerpt}</p>
            <div class="trending-card-meta">
              <div class="trending-card-author">
                <div class="trending-card-avatar">{t.author}</div>
                <span>{t.authorName}</span>
              </div>
              <span>·</span>
              <span>{t.readTime}</span>
              <span>·</span>
              <span>{t.date}</span>
