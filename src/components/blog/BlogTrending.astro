---
import { trendingPosts } from '../../data/blog/blog-content';
---

<aside class="bl-trending">
  <div class="bl-trending-head">
    <span class="bl-trending-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 12h4l3-9 4 18 3-9h6"/>
      </svg>
    </span>
    <h2 class="bl-trending-title">Trending Now</h2>
  </div>
  <div class="bl-trending-list">
    {trendingPosts.map((post) => (
      <a href={`/blog/${post.slug}`} class="bl-trending-item" style={`--card-color:${post.topicColor}`}>
        <span class="bl-trending-rank">{post.trendingRank}</span>
        <div class="bl-trending-content">
          <span class="bl-trending-cat" style={`--cat-color:${post.topicColor}`}>{post.topic}</span>
          <h3 class="bl-trending-headline">{post.title}</h3>
          <span class="bl-trending-meta">{post.readTime} · {post.date}</span>
        </div>
      </a>
    ))}
  </div>
</aside>
