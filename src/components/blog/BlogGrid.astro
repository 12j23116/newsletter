---
import { allPosts } from '../../data/blog/blog-content';
---

<section class="bl-grid-section">
  <div class="bl-grid-head">
    <h2 class="bl-grid-title">All Articles</h2>
    <span class="bl-grid-count" id="bl-grid-count">Showing {allPosts.length} articles</span>
  </div>
  <div class="bl-grid" id="bl-grid">
    {allPosts.map((post) => (
      <a
        href={`/blog/${post.slug}`}
        class="bl-card"
        data-topic={post.topic}
        data-author={post.author}
        data-date={post.date}
        data-readtime={post.readTime.replace(/\D/g, '')}
        data-title={post.title}
        data-tags={(post.tags || []).join(',').toLowerCase()}
        data-excerpt={post.excerpt.toLowerCase()}
        style={`--card-color:${post.topicColor}`}
      >
        {post.image && (
          <div class="bl-card-img-wrap">
            <img src={post.image} alt={post.title} class="bl-card-img" loading="lazy" width="400" height="220" />
            <div class="bl-card-img-overlay"></div>
            <span class="bl-card-cat bl-card-cat-img" style={`--cat-color:${post.topicColor}`}>
              <span class="bl-cat-dot"></span>
              {post.topic}
            </span>
            <span class="bl-card-time bl-card-time-img">{post.readTime}</span>
          </div>
        )}
        <div class="bl-card-body">
          <div class="bl-card-top">
            <span class="bl-card-cat" style={`--cat-color:${post.topicColor}`}>
              <span class="bl-cat-dot"></span>
              {post.topic}
            </span>
            <span class="bl-card-time">{post.readTime}</span>
          </div>
          <h3 class="bl-card-title">{post.title}</h3>
          <p class="bl-card-excerpt">{post.excerpt}</p>
          <div class="bl-card-foot">
            <span class="bl-card-author">{post.author}</span>
            <span class="bl-card-date">{post.date}</span>
          </div>
          {post.tags && post.tags.length > 0 && (
            <div class="bl-card-tags">
              {post.tags.slice(0, 3).map((tag) => (
                <span class="bl-card-tag">#{tag}</span>
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
  <div class="bl-no-results" id="bl-no-results">
    <div class="bl-no-results-icon">📝</div>
    <h3>No articles found</h3>
    <p>Try selecting a different topic.</p>
  </div>
  <nav class="bl-pagination" id="bl-pagination" aria-label="Pagination"></nav>
</section>
