---
import { resourceStats } from '../../data/resources/resources-data';
---

<section class="res-hero">
  <div class="res-hero-orb res-hero-orb-1"></div>
  <div class="res-hero-orb res-hero-orb-2"></div>
  <div class="res-hero-orb res-hero-orb-3"></div>
  <div class="res-hero-inner">
    <span class="res-eyebrow">
      <span class="res-eyebrow-dot"></span>
      Knowledge Hub · Updated 2026
    </span>
    <h1>Emerging Tech <span class="res-grad">Resources</span></h1>
    <p class="res-hero-sub">
      120+ guides, reports, tools, and datasets across 12 technology frontiers —
      from AI agents to fusion energy, curated for builders, investors, and the endlessly curious.
    </p>
    <div class="res-search-wrap">
      <div class="res-search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input type="text" placeholder="Search resources..." id="res-search" />
        <button class="res-search-clear" id="res-search-clear" aria-label="Clear search">✕</button>
      </div>
    </div>
    <div class="res-hero-stats">
      {resourceStats.map((stat) => (
        <div class="res-hero-stat">
          <strong>{stat.value}{stat.suffix}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
