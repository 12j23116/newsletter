---
import { glossaryTerms, glossarytopics } from '../../data/glossary/glossary-content';
---

<section class="gl-section" id="gl-terms">
  <div class="gl-terms-header gl-reveal">
    <h2 class="gl-terms-title" id="gl-terms-title">All Terms</h2>
    <span class="gl-terms-count" id="gl-terms-count">Showing {glossaryTerms.length} terms</span>
  </div>

  <div class="gl-terms-toolbar gl-reveal">
    <div class="gl-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input type="text" placeholder="Search 216+ terms..." id="gl-search" />
      <button class="gl-search-clear" id="gl-search-clear" aria-label="Clear search">✕</button>
    </div>
    <div class="gl-filter-bar">
      <div class="gl-filter-group">
        <label class="gl-filter-label">Sort</label>
        <select id="gl-sort" class="gl-filter-select">
          <option value="default">Default</option>
          <option value="az">A → Z</option>
          <option value="za">Z → A</option>
          <option value="cat">By Category</option>
        </select>
      </div>
      <div class="gl-filter-group">
        <label class="gl-filter-label">View</label>
        <div class="gl-view-toggle">
          <button class="gl-view-btn gl-view-active" data-view="grid" aria-label="Grid view">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </button>
          <button class="gl-view-btn" data-view="list" aria-label="List view">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
        </div>
      </div>
      <button class="gl-filter-clear" id="gl-filter-clear">Reset</button>
    </div>
  </div>

  <div class="gl-terms-grid" id="gl-terms-grid">
    {glossaryTerms.map((term, i) => {
      const cat = glossarytopics.find(c => c.id === term.c);
      return (
        <div
          class="gl-term-card gl-reveal"
          data-cat={term.c}
          data-term={term.t.toLowerCase()}
          data-abbr={(term.a || '').toLowerCase()}
          data-def={term.d.toLowerCase()}
          data-full-term={term.t}
          data-full-abbr={term.a || ''}
          data-full-def={term.d}
          data-full-cat={cat?.name || ''}
          data-full-cat-id={term.c}
          data-full-cat-color={cat?.color || ''}
          data-full-cat-svg={cat?.svg || ''}
          data-full-related={term.r.join(',')}
          style={`--cat-color:${cat?.color}`}
          data-index={i}
        >
          <div class="gl-term-accent"></div>
          <div class="gl-term-top">
            <span class="gl-term-cat-icon" style={`color:${cat?.color}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={cat?.svg}/></svg>
            </span>
            {term.a && <span class="gl-term-abbr">{term.a}</span>}
          </div>
          <h3 class="gl-term-name">{term.t}</h3>
          <div class="gl-term-cat-badge">{cat?.name}</div>
        </div>
      );
    })}
  </div>
  <div class="gl-no-results" id="gl-no-results">
    <div class="gl-no-results-icon">🔍</div>
    <h3>No terms found</h3>
    <p>Try a different search or clear filters.</p>
    <button class="gl-btn gl-btn-primary" id="gl-clear-filters">Clear Filters</button>
  </div>
</section>

<!-- Modal -->
<div class="gl-modal-overlay" id="gl-modal-overlay">
  <div class="gl-modal" id="gl-modal">
    <button class="gl-modal-close" id="gl-modal-close" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="gl-modal-header">
      <div class="gl-modal-icon" id="gl-modal-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="gl-modal-icon-svg"></svg>
      </div>
      <div class="gl-modal-titles">
        <h2 id="gl-modal-title">Term</h2>
        <span class="gl-modal-abbr" id="gl-modal-abbr"></span>
      </div>
    </div>
    <div class="gl-modal-body">
      <div class="gl-modal-section">
        <div class="gl-modal-section-label">Definition</div>
        <p id="gl-modal-def"></p>
      </div>
      <div class="gl-modal-section">
        <div class="gl-modal-section-label">Category</div>
        <span class="gl-modal-cat-badge" id="gl-modal-cat"></span>
      </div>
      <div class="gl-modal-section" id="gl-modal-related-section">
        <div class="gl-modal-section-label">Related Terms</div>
        <div class="gl-modal-related" id="gl-modal-related"></div>
      </div>
    </div>
  </div>
</div>
