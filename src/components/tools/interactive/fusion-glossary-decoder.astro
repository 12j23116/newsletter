---
/**
 * Fusion Glossary Decoder — Interactive tool
 * Search and decode fusion energy terminology with plain-language explanations
 */
import './interactive-tools.css';

const glossary = [
  { term: 'Lawson Criterion', category: 'Physics', def: 'The minimum condition for fusion ignition: the product of plasma density, temperature, and confinement time must exceed a threshold value. For D-T fusion, nTτ ≥ 3×10²¹ keV·s/m³.', related: ['Triple Product', 'Ignition', 'Confinement'] },
  { term: 'Triple Product', category: 'Physics', def: 'The product n×T×τ (density × temperature × confinement time). The key figure of merit for fusion reactor performance. Higher is better.', related: ['Lawson Criterion', 'Confinement Time'] },
  { term: 'Ignition', category: 'Physics', def: 'The point where alpha particle heating from fusion reactions is sufficient to sustain the plasma temperature without external heating. Q = ∞.', related: ['Lawson Criterion', 'Alpha Heating', 'Q Factor'] },
  { term: 'Q Factor', category: 'Physics', def: 'The ratio of fusion power produced to external heating power input. Q=1 is break-even, Q>10 is burning plasma, Q=∞ is ignition.', related: ['Ignition', 'Alpha Heating'] },
  { term: 'Beta (β)', category: 'Physics', def: 'The ratio of plasma pressure to magnetic pressure. β = nkT / (B²/2μ₀). Higher beta means more efficient use of magnetic field. Typical limit: ~5% for tokamaks.', related: ['Magnetic Confinement', 'Plasma Pressure'] },
  { term: 'Tokamak', category: 'Device', def: 'Toroidal magnetic confinement device using external coils plus a central solenoid to create helical magnetic fields. The most studied fusion concept. ITER is a tokamak.', related: ['Stellarator', 'Magnetic Confinement', 'ITER'] },
  { term: 'Stellarator', category: 'Device', def: 'Toroidal magnetic confinement device using only external coils with complex 3D shapes to create the confining field. No plasma current needed — inherently steady-state. Wendelstein 7-X is the largest.', related: ['Tokamak', 'Magnetic Confinement'] },
  { term: 'ICF', category: 'Device', def: 'Inertial Confinement Fusion — uses high-power lasers or particle beams to compress and heat a small fuel pellet to fusion conditions in nanoseconds. NIF uses this approach.', related: ['NIF', 'Inertial Confinement'] },
  { term: 'Magnetic Confinement', category: 'Physics', def: 'Using strong magnetic fields to confine hot plasma, since material containers would melt. Fields create a "magnetic bottle" that traps charged particles.', related: ['Tokamak', 'Stellarator', 'Beta'] },
  { term: 'Bremsstrahlung', category: 'Physics', def: 'Electromagnetic radiation emitted when electrons are decelerated by the electric field of ions in plasma. A major energy loss mechanism, especially for high-Z fuels.', related: ['Radiation Loss', 'Synchrotron'] },
  { term: 'Alpha Heating', category: 'Physics', def: 'Energy deposited in the plasma by alpha particles (He-4 nuclei) produced in D-T fusion. Each D-T reaction releases a 3.5 MeV alpha particle that heats the plasma.', related: ['Ignition', 'Q Factor', 'D-T Fusion'] },
  { term: 'D-T Fusion', category: 'Reaction', def: 'Deuterium + Tritium → Helium-4 (3.5 MeV) + neutron (14.1 MeV). The easiest fusion reaction — lowest temperature threshold (~4 keV). Tritium must be bred from lithium.', related: ['Tritium Breeding', 'Lawson Criterion'] },
  { term: 'Tritium Breeding', category: 'Engineering', def: 'Producing tritium by neutron irradiation of lithium-6 in a blanket surrounding the reactor: ⁶Li + n → T + ⁴He. Essential for D-T fusion since tritium is rare.', related: ['D-T Fusion', 'Blanket', 'Lithium'] },
  { term: 'Blanket', category: 'Engineering', def: 'The region surrounding the plasma that captures fusion neutrons, breeds tritium from lithium, and converts neutron kinetic energy to heat. A critical engineering component.', related: ['Tritium Breeding', 'Neutron Shielding'] },
  { term: 'Divertor', category: 'Engineering', def: 'A magnetic field configuration at the edge of the plasma that directs exhaust particles and impurities to a target plate. Handles heat loads and removes helium ash.', related: ['Plasma Edge', 'Scrape-Off Layer'] },
  { term: 'Larmor Radius', category: 'Physics', def: 'The radius of the circular motion of a charged particle in a magnetic field. r = mv/(qB). Must be much smaller than the device size for good confinement.', related: ['Magnetic Confinement', 'Gyrofrequency'] },
  { term: 'Synchrotron Radiation', category: 'Physics', def: 'Electromagnetic radiation from relativistic electrons spiraling in magnetic fields. An energy loss mechanism in high-field, high-temperature plasmas.', related: ['Bremsstrahlung', 'Radiation Loss'] },
  { term: 'Cryostat', category: 'Engineering', def: 'The vacuum vessel that maintains cryogenic temperatures for superconducting magnets. Largest single component of a tokamak.', related: ['Superconducting Magnets', 'ITER'] },
  { term: 'Superconducting Magnets', category: 'Engineering', def: 'Electromagnets using superconducting materials (NbSn, NbTi, or REBCO) that carry current with zero resistance, enabling very high magnetic fields with no ohmic losses.', related: ['Cryostat', 'Magnetic Confinement'] },
  { term: 'ITER', category: 'Project', def: 'International Thermonuclear Experimental Reactor under construction in France. Designed to achieve Q=10 and demonstrate fusion at power-plant scale. First plasma expected ~2025-2026.', related: ['Tokamak', 'DEMO', 'Q Factor'] },
  { term: 'DEMO', category: 'Project', def: 'Demonstration fusion power plant — the step after ITER. Designed to produce net electricity and demonstrate fusion energy viability. Target: 2030s-2040s.', related: ['ITER', 'Tokamak'] },
  { term: 'NIF', category: 'Project', def: 'National Ignition Facility at Lawrence Livermore. 192-beam laser ICF system that achieved Q>1 in December 2022 — first fusion ignition in lab.', related: ['ICF', 'Inertial Confinement', 'Ignition'] },
  { term: 'Plasma Edge', category: 'Physics', def: 'The outer region of magnetically confined plasma where field lines intersect material surfaces. Key region for heat exhaust, impurity control, and stability.', related: ['Divertor', 'Scrape-Off Layer'] },
  { term: 'ELM', category: 'Physics', def: 'Edge-Localized Mode — periodic instability in H-mode plasma edge that releases bursts of particles and energy. Can damage reactor walls. Mitigation is a major research topic.', related: ['Plasma Edge', 'H-mode', 'Divertor'] },
  { term: 'H-mode', category: 'Physics', def: 'High-confinement mode — plasma operating regime with an edge transport barrier that improves confinement by ~2x over L-mode (low confinement).', related: ['ELM', 'Plasma Edge', 'Confinement'] },
  { term: 'Disruption', category: 'Physics', def: 'Sudden loss of plasma confinement in a tokamak, dumping thermal and magnetic energy to walls in milliseconds. A major challenge for tokamak operation.', related: ['Tokamak', 'Vertical Displacement Event'] },
  { term: 'Aneutronic Fusion', category: 'Reaction', def: 'Fusion reactions that produce few or no neutrons, such as p-B11 or D-He3. Advantages: direct energy conversion, no neutron damage, no tritium needed. Requires much higher temperatures.', related: ['D-He3', 'p-B11', 'Direct Conversion'] },
  { term: 'Direct Conversion', category: 'Engineering', def: 'Converting charged fusion products directly to electricity without a thermal cycle. Possible with aneutronic fuels. Theoretical efficiency: 80-90%.', related: ['Aneutronic Fusion', 'p-B11'] },
  { term: 'Gyrofrequency', category: 'Physics', def: 'The frequency at which a charged particle gyrates in a magnetic field. ω = qB/m. Important for heating methods like ECRH and ICRH.', related: ['Larmor Radius', 'ECRH', 'ICRH'] },
  { term: 'ECRH', category: 'Heating', def: 'Electron Cyclotron Resonance Heating — uses microwave radiation at the gyrofrequency of electrons to heat the plasma. A key auxiliary heating method.', related: ['Gyrofrequency', 'ICRH', 'NBI'] },
  { term: 'ICRH', category: 'Heating', def: 'Ion Cyclotron Resonance Heating — uses radio waves at ion gyrofrequency to heat ions. Another auxiliary heating method for tokamaks.', related: ['Gyrofrequency', 'ECRH', 'NBI'] },
  { term: 'NBI', category: 'Heating', def: 'Neutral Beam Injection — injects high-energy neutral atoms into the plasma to heat it and drive current. A primary heating and current drive method.', related: ['ECRH', 'ICRH', 'Current Drive'] },
];
---

<div class="it-container" id="fusion-glossary">
  <div class="it-card">
    <div class="it-header">
      <div class="it-header-icon">📖</div>
      <div>
        <h2>Fusion Glossary Decoder</h2>
        <p>Search and decode fusion energy terminology with plain-language explanations</p>
      </div>
    </div>

    <div class="it-form">
      <div class="it-field">
        <label class="it-label">Search Term</label>
        <input type="text" class="it-input" id="fgd-search" placeholder="e.g. tokamak, Lawson, tritium..." />
      </div>

      <div class="it-field">
        <label class="it-label">Filter by Category</label>
        <select class="it-select" id="fgd-category">
          <option value="all">All Categories</option>
          <option value="Physics">Physics</option>
          <option value="Device">Device Types</option>
          <option value="Engineering">Engineering</option>
          <option value="Reaction">Reactions</option>
          <option value="Heating">Heating Methods</option>
          <option value="Project">Projects</option>
        </select>
      </div>

      <div class="it-btn-row">
        <button class="it-btn it-btn-primary" id="fgd-search-btn">Search Glossary</button>
        <button class="it-btn it-btn-secondary" id="fgd-browse">Browse All Terms</button>
        <button class="it-btn it-btn-secondary" id="fgd-quiz">Take Quiz</button>
        <button class="it-btn it-btn-secondary" id="fgd-reset">Reset</button>
        <button class="it-btn it-btn-secondary" id="fgd-export" style="display:none;">📄 Export JSON</button>
      </div>
    </div>

    <div class="it-results" id="fgd-results">
      <div class="it-results-card">
        <div class="it-results-title" id="fgd-title">Glossary Results</div>
        <div id="fgd-terms"></div>
      </div>

      <!-- Feature 1: Category Statistics Dashboard -->
      <div class="it-results-card" id="fgd-stats-section" style="display:none;">
        <div class="it-results-title">📊 Glossary Statistics</div>
        <div id="fgd-stats-list"></div>
      </div>

      <!-- Feature 2: Term Relationship Graph -->
      <div class="it-results-card" id="fgd-graph-section" style="display:none;">
        <div class="it-results-title">🔗 Term Relationship Graph</div>
        <canvas id="fgd-graph-canvas" width="700" height="450" style="width:100%;border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);background:var(--tl-bg);margin-bottom:0.75rem;"></canvas>
        <div id="fgd-graph-list"></div>
      </div>

      <!-- Feature 3: Difficulty Level Explanations -->
      <div class="it-results-card" id="fgd-difficulty-section" style="display:none;">
        <div class="it-results-title">🎓 Multi-Level Explanations</div>
        <div id="fgd-difficulty-list"></div>
      </div>

      <!-- Feature 4: Formula Reference Table -->
      <div class="it-results-card" id="fgd-formula-section" style="display:none;">
        <div class="it-results-title">📐 Fusion Physics Formula Reference</div>
        <div id="fgd-formula-list"></div>
      </div>

      <!-- Feature 5: Fusion Timeline -->
      <div class="it-results-card" id="fgd-timeline-section" style="display:none;">
        <div class="it-results-title">📅 Fusion Energy Development Timeline</div>
        <div id="fgd-timeline-list"></div>
      </div>

      <!-- Feature 6: Concept Comparison Table -->
      <div class="it-results-card" id="fgd-compare-section" style="display:none;">
        <div class="it-results-title">⚖️ Concept Comparison Table</div>
        <div id="fgd-compare-list"></div>
      </div>

      <!-- Feature 7: Fusion Reactions Reference -->
      <div class="it-results-card" id="fgd-reactions-section" style="display:none;">
        <div class="it-results-title">⚛️ Fusion Reactions Reference</div>
        <div id="fgd-reactions-list"></div>
      </div>

      <!-- Feature 8: Key Parameters Quick Reference -->
      <div class="it-results-card" id="fgd-params-section" style="display:none;">
        <div class="it-results-title">📋 Key Parameters Quick Reference</div>
        <div id="fgd-params-list"></div>
      </div>

      <!-- Feature 9: Quiz Section -->
      <div class="it-results-card" id="fgd-quiz-section" style="display:none;">
        <div class="it-results-title">🧠 Fusion Knowledge Quiz</div>
        <div id="fgd-quiz-list"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const glossary = [
    { term: 'Lawson Criterion', category: 'Physics', def: 'The minimum condition for fusion ignition: the product of plasma density, temperature, and confinement time must exceed a threshold value. For D-T fusion, nTτ ≥ 3×10²¹ keV·s/m³.', related: ['Triple Product', 'Ignition', 'Confinement'] },
    { term: 'Triple Product', category: 'Physics', def: 'The product n×T×τ (density × temperature × confinement time). The key figure of merit for fusion reactor performance.', related: ['Lawson Criterion', 'Confinement Time'] },
    { term: 'Ignition', category: 'Physics', def: 'The point where alpha particle heating from fusion reactions is sufficient to sustain the plasma temperature without external heating. Q = ∞.', related: ['Lawson Criterion', 'Alpha Heating', 'Q Factor'] },
    { term: 'Q Factor', category: 'Physics', def: 'The ratio of fusion power produced to external heating power input. Q=1 is break-even, Q>10 is burning plasma, Q=∞ is ignition.', related: ['Ignition', 'Alpha Heating'] },
    { term: 'Beta (β)', category: 'Physics', def: 'The ratio of plasma pressure to magnetic pressure. β = nkT / (B²/2μ₀). Higher beta means more efficient use of magnetic field. Typical limit: ~5% for tokamaks.', related: ['Magnetic Confinement', 'Plasma Pressure'] },
    { term: 'Tokamak', category: 'Device', def: 'Toroidal magnetic confinement device using external coils plus a central solenoid to create helical magnetic fields. The most studied fusion concept. ITER is a tokamak.', related: ['Stellarator', 'Magnetic Confinement', 'ITER'] },
    { term: 'Stellarator', category: 'Device', def: 'Toroidal magnetic confinement device using only external coils with complex 3D shapes. No plasma current needed — inherently steady-state. Wendelstein 7-X is the largest.', related: ['Tokamak', 'Magnetic Confinement'] },
    { term: 'ICF', category: 'Device', def: 'Inertial Confinement Fusion — uses high-power lasers or particle beams to compress and heat a small fuel pellet to fusion conditions in nanoseconds. NIF uses this approach.', related: ['NIF', 'Inertial Confinement'] },
    { term: 'Magnetic Confinement', category: 'Physics', def: 'Using strong magnetic fields to confine hot plasma, since material containers would melt. Fields create a "magnetic bottle" that traps charged particles.', related: ['Tokamak', 'Stellarator', 'Beta'] },
    { term: 'Bremsstrahlung', category: 'Physics', def: 'Electromagnetic radiation emitted when electrons are decelerated by the electric field of ions in plasma. A major energy loss mechanism.', related: ['Radiation Loss', 'Synchrotron'] },
    { term: 'Alpha Heating', category: 'Physics', def: 'Energy deposited in the plasma by alpha particles (He-4 nuclei) produced in D-T fusion. Each D-T reaction releases a 3.5 MeV alpha particle that heats the plasma.', related: ['Ignition', 'Q Factor', 'D-T Fusion'] },
    { term: 'D-T Fusion', category: 'Reaction', def: 'Deuterium + Tritium → Helium-4 (3.5 MeV) + neutron (14.1 MeV). The easiest fusion reaction — lowest temperature threshold (~4 keV). Tritium must be bred from lithium.', related: ['Tritium Breeding', 'Lawson Criterion'] },
    { term: 'Tritium Breeding', category: 'Engineering', def: 'Producing tritium by neutron irradiation of lithium-6 in a blanket: ⁶Li + n → T + ⁴He. Essential for D-T fusion since tritium is rare.', related: ['D-T Fusion', 'Blanket', 'Lithium'] },
    { term: 'Blanket', category: 'Engineering', def: 'The region surrounding the plasma that captures fusion neutrons, breeds tritium from lithium, and converts neutron kinetic energy to heat.', related: ['Tritium Breeding', 'Neutron Shielding'] },
    { term: 'Divertor', category: 'Engineering', def: 'A magnetic field configuration at the edge of the plasma that directs exhaust particles and impurities to a target plate. Handles heat loads and removes helium ash.', related: ['Plasma Edge', 'Scrape-Off Layer'] },
    { term: 'Larmor Radius', category: 'Physics', def: 'The radius of the circular motion of a charged particle in a magnetic field. r = mv/(qB). Must be much smaller than the device size for good confinement.', related: ['Magnetic Confinement', 'Gyrofrequency'] },
    { term: 'Synchrotron Radiation', category: 'Physics', def: 'Electromagnetic radiation from relativistic electrons spiraling in magnetic fields. An energy loss mechanism in high-field, high-temperature plasmas.', related: ['Bremsstrahlung', 'Radiation Loss'] },
    { term: 'Cryostat', category: 'Engineering', def: 'The vacuum vessel that maintains cryogenic temperatures for superconducting magnets. Largest single component of a tokamak.', related: ['Superconducting Magnets', 'ITER'] },
    { term: 'Superconducting Magnets', category: 'Engineering', def: 'Electromagnets using superconducting materials (NbSn, NbTi, or REBCO) that carry current with zero resistance, enabling very high magnetic fields with no ohmic losses.', related: ['Cryostat', 'Magnetic Confinement'] },
    { term: 'ITER', category: 'Project', def: 'International Thermonuclear Experimental Reactor under construction in France. Designed to achieve Q=10 and demonstrate fusion at power-plant scale.', related: ['Tokamak', 'DEMO', 'Q Factor'] },
    { term: 'DEMO', category: 'Project', def: 'Demonstration fusion power plant — the step after ITER. Designed to produce net electricity and demonstrate fusion energy viability. Target: 2030s-2040s.', related: ['ITER', 'Tokamak'] },
    { term: 'NIF', category: 'Project', def: 'National Ignition Facility at Lawrence Livermore. 192-beam laser ICF system that achieved Q>1 in December 2022 — first fusion ignition in lab.', related: ['ICF', 'Inertial Confinement', 'Ignition'] },
    { term: 'Plasma Edge', category: 'Physics', def: 'The outer region of magnetically confined plasma where field lines intersect material surfaces. Key region for heat exhaust, impurity control, and stability.', related: ['Divertor', 'Scrape-Off Layer'] },
    { term: 'ELM', category: 'Physics', def: 'Edge-Localized Mode — periodic instability in H-mode plasma edge that releases bursts of particles and energy. Can damage reactor walls.', related: ['Plasma Edge', 'H-mode', 'Divertor'] },
    { term: 'H-mode', category: 'Physics', def: 'High-confinement mode — plasma operating regime with an edge transport barrier that improves confinement by ~2x over L-mode.', related: ['ELM', 'Plasma Edge', 'Confinement'] },
    { term: 'Disruption', category: 'Physics', def: 'Sudden loss of plasma confinement in a tokamak, dumping thermal and magnetic energy to walls in milliseconds. A major challenge for tokamak operation.', related: ['Tokamak', 'Vertical Displacement Event'] },
    { term: 'Aneutronic Fusion', category: 'Reaction', def: 'Fusion reactions that produce few or no neutrons, such as p-B11 or D-He3. Advantages: direct energy conversion, no neutron damage, no tritium needed.', related: ['D-He3', 'p-B11', 'Direct Conversion'] },
    { term: 'Direct Conversion', category: 'Engineering', def: 'Converting charged fusion products directly to electricity without a thermal cycle. Possible with aneutronic fuels. Theoretical efficiency: 80-90%.', related: ['Aneutronic Fusion', 'p-B11'] },
    { term: 'Gyrofrequency', category: 'Physics', def: 'The frequency at which a charged particle gyrates in a magnetic field. ω = qB/m. Important for heating methods like ECRH and ICRH.', related: ['Larmor Radius', 'ECRH', 'ICRH'] },
    { term: 'ECRH', category: 'Heating', def: 'Electron Cyclotron Resonance Heating — uses microwave radiation at the gyrofrequency of electrons to heat the plasma.', related: ['Gyrofrequency', 'ICRH', 'NBI'] },
    { term: 'ICRH', category: 'Heating', def: 'Ion Cyclotron Resonance Heating — uses radio waves at ion gyrofrequency to heat ions. Another auxiliary heating method for tokamaks.', related: ['Gyrofrequency', 'ECRH', 'NBI'] },
    { term: 'NBI', category: 'Heating', def: 'Neutral Beam Injection — injects high-energy neutral atoms into the plasma to heat it and drive current. A primary heating and current drive method.', related: ['ECRH', 'ICRH', 'Current Drive'] },
  ];

  const categoryColors = { Physics: '#7c3aed', Device: '#059669', Engineering: '#d97706', Reaction: '#dc2626', Heating: '#2563eb', Project: '#0891b2' };

  function renderTerms(terms) {
    const container = document.getElementById('fgd-terms');
    if (terms.length === 0) {
      container.innerHTML = '<div class="it-alert it-alert-warn">No matching terms found. Try a different search.</div>';
      return;
    }
    container.innerHTML = terms.map(t => {
      const color = categoryColors[t.category] || '#5c5c72';
      return `<div style="border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);padding:1rem 1.25rem;margin-bottom:0.75rem;border-left:4px solid ${color};">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:0.5rem;">
          <strong style="font-size:0.9375rem;">${t.term}</strong>
          <span class="it-badge" style="background:${color}22;color:${color};">${t.category}</span>
        </div>
        <p style="font-size:0.8125rem;color:var(--tl-text-sec);margin:0.5rem 0;line-height:1.5;">${t.def}</p>
        ${t.related.length > 0 ? `<div style="font-size:0.75rem;color:var(--tl-text-muted);margin-top:0.5rem;">
          <strong>Related:</strong> ${t.related.map(r => `<span class="it-badge it-badge-neutral" style="cursor:pointer;" onclick="document.getElementById('fgd-search').value='${r}';document.getElementById('fgd-search-btn').click();">${r}</span>`).join(' ')}
        </div>` : ''}
      </div>`;
    }).join('');
  }

  function search() {
    const query = document.getElementById('fgd-search').value.trim().toLowerCase();
    const category = document.getElementById('fgd-category').value;

    let results = glossary;
    if (category !== 'all') results = results.filter(t => t.category === category);
    if (query) {
      results = results.filter(t =>
        t.term.toLowerCase().includes(query) ||
        t.def.toLowerCase().includes(query) ||
        t.related.some(r => r.toLowerCase().includes(query))
      );
    }

    document.getElementById('fgd-title').textContent = query ? `Results for "${query}" (${results.length})` : `All Terms${category !== 'all' ? ' — ' + category : ''} (${results.length})`;
    renderTerms(results);
    document.getElementById('fgd-results').classList.add('show');

    // === Feature 1: Category Statistics ===
    const catCounts = {};
    glossary.forEach(t => { catCounts[t.category] = (catCounts[t.category] || 0) + 1; });
    const totalTerms = glossary.length;
    const allRelated = new Set();
    glossary.forEach(t => t.related.forEach(r => allRelated.add(r)));
    document.getElementById('fgd-stats-list').innerHTML = `
      <div class="it-results-grid" style="margin-bottom:1rem;">
        <div class="it-stat"><div class="it-stat-label">Total Terms</div><div class="it-stat-value">${totalTerms}</div></div>
        <div class="it-stat"><div class="it-stat-label">Categories</div><div class="it-stat-value">${Object.keys(catCounts).length}</div></div>
        <div class="it-stat"><div class="it-stat-label">Related Links</div><div class="it-stat-value">${allRelated.size}</div></div>
        <div class="it-stat"><div class="it-stat-label">Avg Related</div><div class="it-stat-value">${(glossary.reduce((s, t) => s + t.related.length, 0) / totalTerms).toFixed(1)}</div></div>
      </div>
      <table class="it-table"><thead><tr><th>Category</th><th>Count</th><th>% of Total</th><th>Distribution</th></tr></thead><tbody>
        ${Object.entries(catCounts).sort((a, b) => b[1] - a[1]).map(([cat, count]) => `<tr><td><span class="it-badge" style="background:${categoryColors[cat] || '#5c5c72'}22;color:${categoryColors[cat] || '#5c5c72'};">${cat}</span></td><td class="it-highlight">${count}</td><td>${(count / totalTerms * 100).toFixed(0)}%</td><td style="width:200px;"><div style="background:var(--tl-border);height:10px;border-radius:5px;overflow:hidden;"><div style="width:${count / totalTerms * 100}%;height:100%;background:${categoryColors[cat] || '#5c5c72'};"></div></div></td></tr>`).join('')}
      </tbody></table>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">Glossary covers ${totalTerms} terms across ${Object.keys(catCounts).length} categories. Physics terms dominate (${catCounts.Physics || 0}), reflecting the complexity of plasma physics. ${allRelated.size} unique related terms show the interconnected nature of fusion science.</div>
    `;
    document.getElementById('fgd-stats-section').style.display = 'block';

    // === Feature 2: Term Relationship Graph ===
    const graphCanvas = document.getElementById('fgd-graph-canvas');
    const gCtx = graphCanvas.getContext('2d');
    const gW = graphCanvas.width, gH = graphCanvas.height;
    gCtx.fillStyle = '#ebedf5'; gCtx.fillRect(0, 0, gW, gH);
    const nodePositions = {};
    const categories = Object.keys(catCounts);
    const catAngles = {};
    categories.forEach((cat, i) => { catAngles[cat] = (i / categories.length) * 2 * Math.PI; });
    glossary.forEach((t, i) => {
      const angle = catAngles[t.category] + (i / glossary.length) * 0.5;
      const r = 120 + (i % 3) * 50;
      nodePositions[t.term] = { x: gW / 2 + r * Math.cos(angle), y: gH / 2 + r * Math.sin(angle), cat: t.category };
    });
    gCtx.strokeStyle = '#94a3b8'; gCtx.lineWidth = 0.5; gCtx.globalAlpha = 0.3;
    glossary.forEach(t => {
      t.related.forEach(r => {
        if (nodePositions[r]) {
          gCtx.beginPath(); gCtx.moveTo(nodePositions[t.term].x, nodePositions[t.term].y);
          gCtx.lineTo(nodePositions[r].x, nodePositions[r].y); gCtx.stroke();
        }
      });
    });
    gCtx.globalAlpha = 1;
    Object.entries(nodePositions).forEach(([term, pos]) => {
      const color = categoryColors[pos.cat] || '#5c5c72';
      gCtx.fillStyle = color + '44'; gCtx.beginPath(); gCtx.arc(pos.x, pos.y, 8, 0, 2 * Math.PI); gCtx.fill();
      gCtx.strokeStyle = color; gCtx.lineWidth = 1.5; gCtx.stroke();
