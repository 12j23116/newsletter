          document.querySelectorAll('#fgd-quiz-options .it-checkbox-item').forEach((opt, i) => {
            opt.style.cursor = 'default';
            if (i === q.answer) { opt.style.background = '#05966922'; opt.style.borderColor = '#059669'; }
            else if (i === idx) { opt.style.background = '#dc262622'; opt.style.borderColor = '#dc2626'; }
          });
          const fb = document.getElementById('fgd-quiz-feedback');
          fb.style.display = 'block'; fb.className = `it-alert ${correct ? 'it-alert-good' : 'it-alert-bad'}`;
          fb.innerHTML = `${correct ? '✓ Correct!' : '✗ Incorrect.'} ${q.explanation} <button class="it-btn it-btn-primary" style="margin-top:0.5rem;" id="fgd-quiz-next">${quizIdx < quizQuestions.length - 1 ? 'Next Question' : 'See Results'}</button>`;
          document.getElementById('fgd-quiz-next').addEventListener('click', () => { quizIdx++; renderQuiz(); });
        });
      });
    }
    document.getElementById('fgd-quiz').addEventListener('click', () => {
      quizIdx = 0; quizScore = 0; renderQuiz();
      document.getElementById('fgd-results').classList.add('show');
      document.querySelectorAll('#fgd-results .it-results-card').forEach(c => c.style.display = 'none');
      document.getElementById('fgd-quiz-section').style.display = 'block';
    });
    document.getElementById('fgd-quiz-section').style.display = 'none';

    // === Feature 10: JSON Export ===
    document.getElementById('fgd-export').style.display = 'inline-flex';
    document.getElementById('fgd-export').onclick = () => {
      const report = { timestamp: new Date().toISOString(), glossary, statistics: { totalTerms, categories: catCounts, relatedTerms: allRelated.size }, formulas, timeline, reactions: fusionReactions, parameters: keyParams, comparisons };
      const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'fusion-glossary-report.json'; a.click();
    };
  }

  function browseAll() {
    document.getElementById('fgd-search').value = '';
    document.getElementById('fgd-category').value = 'all';
    search();
  }

  document.getElementById('fgd-search-btn').addEventListener('click', search);
  document.getElementById('fgd-browse').addEventListener('click', browseAll);
  document.getElementById('fgd-reset').addEventListener('click', () => {
    document.getElementById('fgd-search').value = '';
    document.getElementById('fgd-category').value = 'all';
    document.getElementById('fgd-results').classList.remove('show');
  });
  document.getElementById('fgd-search').addEventListener('keydown', e => { if (e.key === 'Enter') search(); });
})();
</script>
