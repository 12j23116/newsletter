---
/**
 * Protein Stability Predictor — Interactive tool
 * Predict protein thermal stability and folding free energy
 */
import './interactive-tools.css';
---

<div class="it-container" id="protein-stability">
  <div class="it-card">
    <div class="it-header">
      <div class="it-header-icon">🌡️</div>
      <div>
        <h2>Protein Stability Predictor</h2>
        <p>Predict thermal stability and folding free energy from protein sequence</p>
      </div>
    </div>

    <div class="it-form">
      <div class="it-field">
        <label class="it-label">Protein Sequence <span class="it-label-hint">(one-letter code)</span></label>
        <textarea class="it-textarea" id="psp-sequence" placeholder="MKVLWAALLVTFLAGCQAKVEQAVETEPEPELRQQTEWQSGQRWELALGRFW..." style="min-height: 100px; font-family: var(--tl-mono);"></textarea>
      </div>

      <div class="it-row">
        <div class="it-field">
          <label class="it-label">Temperature <span class="it-label-hint">(°C)</span></label>
          <input type="number" class="it-input" id="psp-temp" value="37" min="0" max="100" />
        </div>
        <div class="it-field">
          <label class="it-label">pH</label>
          <input type="number" class="it-input" id="psp-ph" value="7.0" min="0" max="14" step="0.1" />
        </div>
      </div>

      <div class="it-btn-row">
        <button class="it-btn it-btn-primary" id="psp-predict">Predict Stability</button>
        <button class="it-btn it-btn-secondary" id="psp-clear">Clear</button>
        <button class="it-btn it-btn-secondary" id="psp-export" style="display:none;">📄 Export</button>
      </div>
    </div>

    <div class="it-results" id="psp-results">
      <div class="it-results-card">
        <div class="it-results-title">Stability Prediction Report</div>

        <div class="it-results-grid" style="margin-bottom: 1.5rem;">
          <div class="it-stat">
            <div class="it-stat-label">Predicted Tm</div>
            <div class="it-stat-value" id="psp-tm">0<span class="it-stat-unit"> °C</span></div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">ΔG Folding</div>
            <div class="it-stat-value" id="psp-dg">0<span class="it-stat-unit"> kcal/mol</span></div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Stability Score</div>
            <div class="it-stat-value" id="psp-score">0<span class="it-stat-unit">/100</span></div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Stability Class</div>
            <div class="it-stat-value" id="psp-class" style="font-size:1.25rem;">—</div>
          </div>
        </div>

        <div id="psp-details"></div>
        <div class="it-alert" id="psp-alert"></div>
      </div>

      <!-- Feature 1: Secondary Structure -->
      <div class="it-results-card" id="psp-ss-section" style="display:none;">
        <div class="it-results-title">🧬 Secondary Structure Prediction</div>
        <div id="psp-ss-list"></div>
      </div>

      <!-- Feature 2: Disulfide Bond Map -->
      <div class="it-results-card" id="psp-disulfide-section" style="display:none;">
        <div class="it-results-title">🔗 Disulfide Bond Mapping</div>
        <div id="psp-disulfide-list"></div>
      </div>

      <!-- Feature 3: Mutation Scanner -->
      <div class="it-results-card" id="psp-mutation-section" style="display:none;">
        <div class="it-results-title">🔬 Point Mutation Stability Scanner (ΔΔG)</div>
        <div id="psp-mutation-list"></div>
      </div>

      <!-- Feature 4: Solvent Accessibility -->
      <div class="it-results-card" id="psp-solvent-section" style="display:none;">
        <div class="it-results-title">💧 Solvent Accessibility Prediction</div>
        <div id="psp-solvent-list"></div>
      </div>

      <!-- Feature 5: Aggregation Propensity -->
      <div class="it-results-card" id="psp-aggregation-section" style="display:none;">
        <div class="it-results-title">🧱 Aggregation Propensity</div>
        <div id="psp-aggregation-list"></div>
      </div>

      <!-- Feature 6: Engineering Suggestions -->
      <div class="it-results-card" id="psp-engineering-section" style="display:none;">
        <div class="it-results-title">🔧 Thermostability Engineering Suggestions</div>
        <div id="psp-engineering-list"></div>
      </div>

      <!-- Feature 7: pH Profile -->
      <div class="it-results-card" id="psp-ph-section" style="display:none;">
        <div class="it-results-title">⚗️ pH Stability Profile</div>
        <canvas id="psp-ph-canvas" width="800" height="200" style="width:100%;border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);background:var(--tl-bg);"></canvas>
        <div id="psp-ph-list" style="margin-top:0.75rem;"></div>
      </div>

      <!-- Feature 8: Charge & pI -->
      <div class="it-results-card" id="psp-charge-section" style="display:none;">
        <div class="it-results-title">⚡ Protein Charge & pI Calculator</div>
        <div id="psp-charge-list"></div>
      </div>

      <!-- Feature 9: Disorder Prediction -->
      <div class="it-results-card" id="psp-disorder-section" style="display:none;">
        <div class="it-results-title">🌀 Intrinsically Disordered Region Prediction</div>
        <div id="psp-disorder-list"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  // Amino acid properties (Kyte-Doolittle hydropathy, helix/sheet propensity)
  const aaProps = {
    A: { name: 'Alanine', hydropathy: 1.8, helix: 1.45, sheet: 0.97, mw: 89.09 },
    R: { name: 'Arginine', hydropathy: -4.5, helix: 0.98, sheet: 0.93, mw: 174.20 },
    N: { name: 'Asparagine', hydropathy: -3.5, helix: 0.67, sheet: 0.89, mw: 132.12 },
    D: { name: 'Aspartic Acid', hydropathy: -3.5, helix: 1.01, sheet: 0.54, mw: 133.10 },
    C: { name: 'Cysteine', hydropathy: 2.5, helix: 0.70, sheet: 1.19, mw: 121.16 },
    E: { name: 'Glutamic Acid', hydropathy: -3.5, helix: 1.51, sheet: 0.37, mw: 147.13 },
    Q: { name: 'Glutamine', hydropathy: -3.5, helix: 1.11, sheet: 1.10, mw: 146.15 },
    G: { name: 'Glycine', hydropathy: -0.4, helix: 0.53, sheet: 0.90, mw: 75.03 },
    H: { name: 'Histidine', hydropathy: -3.2, helix: 1.00, sheet: 0.87, mw: 155.16 },
    I: { name: 'Isoleucine', hydropathy: 4.5, helix: 1.00, sheet: 1.60, mw: 131.17 },
    L: { name: 'Leucine', hydropathy: 3.8, helix: 1.34, sheet: 1.30, mw: 131.17 },
    K: { name: 'Lysine', hydropathy: -3.9, helix: 1.16, sheet: 0.74, mw: 146.19 },
    M: { name: 'Methionine', hydropathy: 1.9, helix: 1.20, sheet: 1.45, mw: 149.21 },
    F: { name: 'Phenylalanine', hydropathy: 2.8, helix: 1.13, sheet: 1.38, mw: 165.19 },
    P: { name: 'Proline', hydropathy: -1.6, helix: 0.57, sheet: 0.55, mw: 115.13 },
    S: { name: 'Serine', hydropathy: -0.8, helix: 0.77, sheet: 0.82, mw: 105.09 },
    T: { name: 'Threonine', hydropathy: -0.7, helix: 0.83, sheet: 1.19, mw: 119.12 },
    W: { name: 'Tryptophan', hydropathy: -0.9, helix: 1.08, sheet: 1.37, mw: 204.23 },
    Y: { name: 'Tyrosine', hydropathy: -1.3, helix: 0.69, sheet: 1.47, mw: 181.19 },
    V: { name: 'Valine', hydropathy: 4.2, helix: 1.06, sheet: 1.70, mw: 117.15 },
  };

  function predict() {
    const seq = document.getElementById('psp-sequence').value.trim().toUpperCase().replace(/[^ACDEFGHIKLMNPQRSTVWY]/g, '');
    if (seq.length < 10) { alert('Please enter a protein sequence of at least 10 residues.'); return; }

    const temp = parseFloat(document.getElementById('psp-temp').value) || 37;
    const pH = parseFloat(document.getElementById('psp-ph').value) || 7.0;

    // Calculate properties
    let totalHydropathy = 0, totalHelix = 0, totalSheet = 0, totalMW = 0;
    const aaCount = {};
    let hydrophobicCount = 0, chargedCount = 0, polarCount = 0;

    seq.split('').forEach(aa => {
      const props = aaProps[aa];
      if (props) {
        totalHydropathy += props.hydropathy;
        totalHelix += props.helix;
        totalSheet += props.sheet;
        totalMW += props.mw;
        aaCount[aa] = (aaCount[aa] || 0) + 1;
        if (props.hydropathy > 0) hydrophobicCount++;
        if (['R', 'K', 'D', 'E'].includes(aa)) chargedCount++;
        if (['S', 'T', 'N', 'Q', 'H', 'Y', 'W'].includes(aa)) polarCount++;
      }
    });

    const len = seq.length;
    const avgHydropathy = totalHydropathy / len;
    const avgHelix = totalHelix / len;
    const avgSheet = totalSheet / len;
    const mw = totalMW - (len - 1) * 18.02; // Subtract water for peptide bonds

    // Disulfide bond potential
    const cysCount = aaCount['C'] || 0;
    const disulfideBonds = Math.floor(cysCount / 2);

    // Proline content (kinks in helices)
    const proCount = aaCount['P'] || 0;
    const proContent = (proCount / len) * 100;

    // Glycine content (flexibility)
    const glyCount = aaCount['G'] || 0;
    const glyContent = (glyCount / len) * 100;

    // Predicted Tm (melting temperature)
    // Simplified model: based on hydrophobicity, disulfide bonds, proline content
    let tm = 50; // base
    tm += avgHydropathy * 3; // hydrophobic core stabilizes
    tm += disulfideBonds * 5; // each disulfide adds ~5°C
    tm -= proContent * 0.5; // prolines destabilize helices
    tm -= glyContent * 0.3; // glycines add flexibility
    tm += (hydrophobicCount / len) * 20; // hydrophobic fraction
    // Temperature correction
    tm -= (temp - 25) * 0.1;
    // pH correction (optimal at 7)
    tm -= Math.abs(pH - 7) * 2;

    // ΔG of folding (simplified)
    // Negative = stable, positive = unstable
    let dG = -avgHydropathy * 0.5; // hydrophobic effect drives folding
    dG -= disulfideBonds * 1.5; // disulfides stabilize
    dG += proContent * 0.1; // prolines cost entropy
    dG += glyContent * 0.05; // glycines cost entropy
    dG += (temp - 25) * 0.03; // temperature destabilizes
    dG += Math.abs(pH - 7) * 0.2; // pH deviation destabilizes

    // Stability score (0-100)
    let score = 50;
    score += avgHydropathy * 3;
    score += disulfideBonds * 4;
    score -= proContent * 1;
    score -= glyContent * 0.5;
    score += (avgHelix - 1) * 20; // helix propensity
    score -= (temp - 37) * 0.2;
    score -= Math.abs(pH - 7) * 3;
    score = Math.max(0, Math.min(100, score));

    // Stability class
    let stabilityClass, classColor;
    if (score >= 75) { stabilityClass = 'Highly Stable'; classColor = '#059669'; }
    else if (score >= 55) { stabilityClass = 'Stable'; classColor = '#84cc16'; }
    else if (score >= 40) { stabilityClass = 'Moderately Stable'; classColor = '#d97706'; }
    else { stabilityClass = 'Unstable'; classColor = '#dc2626'; }

    // Update UI
    document.getElementById('psp-tm').innerHTML = tm.toFixed(1) + '<span class="it-stat-unit"> °C</span>';
    document.getElementById('psp-dg').innerHTML = dG.toFixed(2) + '<span class="it-stat-unit"> kcal/mol</span>';
    document.getElementById('psp-score').innerHTML = score.toFixed(0) + '<span class="it-stat-unit">/100</span>';
    document.getElementById('psp-class').textContent = stabilityClass;
    document.getElementById('psp-class').style.color = classColor;

    // Details
    const details = document.getElementById('psp-details');
    details.innerHTML = `
      <table class="it-table">
        <thead><tr><th>Property</th><th>Value</th></tr></thead>
        <tbody>
          <tr><td>Sequence Length</td><td>${len} residues</td></tr>
          <tr><td>Molecular Weight</td><td>${(mw / 1000).toFixed(2)} kDa</td></tr>
          <tr><td>Avg Hydropathy (GRAVY)</td><td>${avgHydropathy.toFixed(3)}</td></tr>
          <tr><td>Alpha-Helix Propensity</td><td>${avgHelix.toFixed(3)}</td></tr>
          <tr><td>Beta-Sheet Propensity</td><td>${avgSheet.toFixed(3)}</td></tr>
          <tr><td>Hydrophobic Residues</td><td>${hydrophobicCount} (${(hydrophobicCount / len * 100).toFixed(1)}%)</td></tr>
          <tr><td>Charged Residues</td><td>${chargedCount} (${(chargedCount / len * 100).toFixed(1)}%)</td></tr>
          <tr><td>Polar Residues</td><td>${polarCount} (${(polarCount / len * 100).toFixed(1)}%)</td></tr>
          <tr><td>Cysteine Count</td><td>${cysCount} (${disulfideBonds} potential disulfide bonds)</td></tr>
          <tr><td>Proline Content</td><td>${proContent.toFixed(1)}% ${proContent > 5 ? '⚠️ High — may disrupt helices' : '✓ Normal'}</td></tr>
          <tr><td>Glycine Content</td><td>${glyContent.toFixed(1)}% ${glyContent > 10 ? '⚠️ High — increased flexibility' : '✓ Normal'}</td></tr>
          <tr><td class="it-highlight">Predicted Tm</td><td class="it-highlight">${tm.toFixed(1)} °C</td></tr>
          <tr><td class="it-highlight">ΔG Folding</td><td class="it-highlight">${dG.toFixed(2)} kcal/mol ${dG < 0 ? '(stable)' : '(unstable)'}</td></tr>
        </tbody>
      </table>
    `;

    const alert = document.getElementById('psp-alert');
    if (score >= 55) {
      alert.className = 'it-alert it-alert-good';
      alert.innerHTML = `✓ <strong>${stabilityClass}.</strong> Predicted Tm of ${tm.toFixed(1)}°C suggests the protein will remain folded at ${temp}°C. ${disulfideBonds > 0 ? `${disulfideBonds} disulfide bond(s) contribute to stability. ` : ''}ΔG = ${dG.toFixed(2)} kcal/mol.`;
    } else if (score >= 40) {
      alert.className = 'it-alert it-alert-warn';
      alert.innerHTML = `⚠️ <strong>${stabilityClass}.</strong> The protein may partially unfold at ${temp}°C. Consider ${proContent > 5 ? 'reducing proline content, ' : ''}${disulfideBonds === 0 && cysCount < 2 ? 'introducing disulfide bonds, ' : ''}or increasing hydrophobic core residues.`;
    } else {
      alert.className = 'it-alert it-alert-bad';
      alert.innerHTML = `✗ <strong>${stabilityClass}.</strong> The protein is likely unfolded at ${temp}°C (Tm = ${tm.toFixed(1)}°C). Significant engineering needed: increase hydrophobic core, add disulfide bonds, reduce proline/glycine content.`;
    }

    document.getElementById('psp-results').classList.add('show');

    // === Feature 1: Secondary Structure Prediction ===
    const ssWindow = 6;
    const ssRegions = [];
    for (let i = 0; i < seq.length; i++) {
      const props = aaProps[seq[i]];
      if (!props) continue;
      let ssType;
      if (props.helix > 1.1 && props.sheet < 1.0) ssType = 'H'; // Helix
      else if (props.sheet > 1.2 && props.helix < 1.0) ssType = 'E'; // Sheet
      else if (seq[i] === 'P' || seq[i] === 'G') ssType = 'C'; // Coil
      else ssType = 'C';
      ssRegions.push({ pos: i, ss: ssType, aa: seq[i] });
    }
    // Smooth regions (minimum 4 consecutive)
    const ssSummary = { H: 0, E: 0, C: 0 };
    ssRegions.forEach(r => ssSummary[r.ss]++);
    const helixPct = (ssSummary.H / seq.length * 100).toFixed(1);
    const sheetPct = (ssSummary.E / seq.length * 100).toFixed(1);
    const coilPct = (ssSummary.C / seq.length * 100).toFixed(1);
    // Visual track
    const ssTrack = ssRegions.map(r => r.ss === 'H' ? '<span style="color:#06b6d4;">█</span>' : r.ss === 'E' ? '<span style="color:#d97706;">█</span>' : '<span style="color:var(--tl-text-muted);">·</span>').join('');
    document.getElementById('psp-ss-list').innerHTML = `
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Alpha-Helix</span><strong style="color:#06b6d4;">${helixPct}%</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Beta-Sheet</span><strong style="color:#d97706;">${sheetPct}%</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Coil/Loop</span><strong style="color:var(--tl-text-muted);">${coilPct}%</strong></div>
      <div style="margin-top:0.5rem;font-size:0.75rem;color:var(--tl-text-muted);margin-bottom:0.25rem;">Structure track (█=helix, █=sheet, ·=coil):</div>
      <div style="font-family:var(--tl-mono);font-size:0.625rem;line-height:1.4;padding:0.5rem;background:var(--tl-bg);border-radius:var(--tl-radius-sm);word-break:break-all;">${ssTrack}</div>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">Secondary structure predicted from Chou-Fasman-like propensities. Helix-rich proteins tend to be more thermostable.</div>
    `;
    document.getElementById('psp-ss-section').style.display = 'block';

    // === Feature 2: Disulfide Bond Mapping ===
    const cysPositions = [];
    seq.split('').forEach((aa, i) => { if (aa === 'C') cysPositions.push(i); });
    const disulfidePairs = [];
    for (let i = 0; i < cysPositions.length - 1; i += 2) {
      disulfidePairs.push({ cys1: cysPositions[i], cys2: cysPositions[i + 1], distance: cysPositions[i + 1] - cysPositions[i] });
    }
    document.getElementById('psp-disulfide-list').innerHTML = cysPositions.length === 0 ?
      '<div class="it-alert it-alert-info">ℹ️ No cysteine residues — no disulfide bonds possible.</div>' :
      `<div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Cysteine Residues</span><strong>${cysPositions.length}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Potential Disulfide Bonds</span><strong>${disulfidePairs.length}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Unpaired Cysteines</span><strong>${cysPositions.length % 2}</strong></div>
      ${disulfidePairs.map((p, i) => `<div style="display:flex;justify-content:space-between;padding:0.375rem 0;border-bottom:1px solid var(--tl-border);font-size:0.8125rem;"><span>Bond ${i+1}: Cys${p.cys1} — Cys${p.cys2}</span><span>${p.distance} residues apart</span></div>`).join('')}
      <div class="it-alert ${disulfidePairs.length > 0 ? 'it-alert-good' : 'it-alert-warn'}" style="margin-top:0.5rem;">${disulfidePairs.length > 0 ? `✓ ${disulfidePairs.length} disulfide bond(s) predicted — each adds ~5°C to Tm.` : '⚠️ No disulfide bonds possible — consider adding cysteine pairs for stability.'}</div>`;
    document.getElementById('psp-disulfide-section').style.display = 'block';

    // === Feature 3: Mutation Scanner ===
    const mutationResults = [];
    const aaList = 'ACDEFGHIKLMNPQRSTVWY';
    // Sample positions (every 5th residue to limit computation)
    for (let i = 0; i < seq.length; i += Math.max(1, Math.floor(seq.length / 20))) {
      const original = seq[i];
      const originalProps = aaProps[original];
      let worstMutation = null;
      for (const mutAA of 'FWYIVLMC') { // Test hydrophobic mutations
        if (mutAA === original) continue;
        const mutProps = aaProps[mutAA];
        const ddG = (mutProps.hydropathy - originalProps.hydropathy) * 0.3 + (original === 'P' ? -1.0 : 0) + (mutAA === 'P' ? 1.0 : 0);
        if (!worstMutation || ddG > worstMutation.ddG) worstMutation = { pos: i, from: original, to: mutAA, ddG };
      }
      if (worstMutation) mutationResults.push(worstMutation);
    }
    mutationResults.sort((a, b) => b.ddG - a.ddG);
    document.getElementById('psp-mutation-list').innerHTML = `
      <div style="font-size:0.8125rem;color:var(--tl-text-muted);margin-bottom:0.5rem;">Top destabilizing mutations (sampled positions):</div>
      ${mutationResults.slice(0, 10).map(m => `<div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span style="font-family:var(--tl-mono);">${m.from}${m.pos + 1}${m.to}</span><strong style="color:${m.ddG > 1 ? '#dc2626' : m.ddG > 0 ? '#d97706' : '#059669'};">ΔΔG = ${m.ddG >= 0 ? '+' : ''}${m.ddG.toFixed(2)} kcal/mol</strong></div>`).join('')}
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">Positive ΔΔG = destabilizing mutation. Negative = stabilizing. Sampled at ~20 positions — full scan requires computational tools (FoldX, Rosetta).</div>
    `;
    document.getElementById('psp-mutation-section').style.display = 'block';

    // === Feature 4: Solvent Accessibility ===
    const solventRegions = [];
    for (let i = 0; i < seq.length; i++) {
      const props = aaProps[seq[i]];
      const isBuried = props.hydropathy > 1.0;
      solventRegions.push({ pos: i, aa: seq[i], buried: isBuried, hydropathy: props.hydropathy });
    }
    const buriedCount = solventRegions.filter(r => r.buried).length;
    const exposedCount = seq.length - buriedCount;
    const buriedPct = (buriedCount / seq.length * 100).toFixed(1);
    const exposedPct = (exposedCount / seq.length * 100).toFixed(1);
    const solventTrack = solventRegions.map(r => r.buried ? '<span style="color:#475569;">■</span>' : '<span style="color:#06b6d4;">□</span>').join('');
    document.getElementById('psp-solvent-list').innerHTML = `
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Buried Residues</span><strong>${buriedCount} (${buriedPct}%)</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Exposed Residues</span><strong>${exposedCount} (${exposedPct}%)</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Core:Surface Ratio</span><strong>${(buriedCount / Math.max(exposedCount, 1)).toFixed(2)}</strong></div>
      <div style="margin-top:0.5rem;font-size:0.75rem;color:var(--tl-text-muted);margin-bottom:0.25rem;">Accessibility track (■=buried, □=exposed):</div>
      <div style="font-family:var(--tl-mono);font-size:0.625rem;line-height:1.4;padding:0.5rem;background:var(--tl-bg);border-radius:var(--tl-radius-sm);word-break:break-all;">${solventTrack}</div>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">Buried hydrophobic core is essential for folding. Typical stable proteins have 30-50% buried residues.</div>
    `;
    document.getElementById('psp-solvent-section').style.display = 'block';

    // === Feature 5: Aggregation Propensity ===
    const aggWindow = 7;
    const aggRegions = [];
    for (let i = 0; i <= seq.length - aggWindow; i++) {
      const window = seq.substring(i, i + aggWindow);
      let aggScore = 0;
      for (const aa of window) {
        const props = aaProps[aa];
        if (props.hydropathy > 2) aggScore += 2;
        if (['V', 'I', 'L', 'F', 'W', 'Y'].includes(aa)) aggScore += 1.5;
        if (['R', 'K', 'D', 'E'].includes(aa)) aggScore -= 1.5;
        if (aa === 'P') aggScore -= 2;
      }
      if (aggScore > 5) aggRegions.push({ start: i, score: aggScore, seq: window });
    }
    const overallAggScore = avgHydropathy > 0.5 ? 'High' : avgHydropathy > 0 ? 'Moderate' : 'Low';
    const aggColor = overallAggScore === 'High' ? '#dc2626' : overallAggScore === 'Moderate' ? '#d97706' : '#059669';
    document.getElementById('psp-aggregation-list').innerHTML = `
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Overall Aggregation Risk</span><strong style="color:${aggColor};">${overallAggScore}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Aggregation-Prone Regions</span><strong>${aggRegions.length}</strong></div>
      ${aggRegions.slice(0, 5).map(r => `<div style="display:flex;justify-content:space-between;padding:0.375rem 0;border-bottom:1px solid var(--tl-border);font-family:var(--tl-mono);font-size:0.75rem;"><span>Pos ${r.start}: ${r.seq}</span><span style="color:#dc2626;">Score: ${r.score}</span></div>`).join('')}
      <div class="it-alert ${overallAggScore === 'High' ? 'it-alert-bad' : 'it-alert-good'}" style="margin-top:0.5rem;">${overallAggScore === 'High' ? '🚨 High aggregation risk — protein may form inclusion bodies. Consider adding solubility tags (MBP, SUMO).' : '✓ Low aggregation risk.'}</div>
    `;
    document.getElementById('psp-aggregation-section').style.display = 'block';

    // === Feature 6: Engineering Suggestions ===
    const suggestions = [];
    if (disulfidePairs.length === 0) suggestions.push({ priority: 'High', suggestion: 'Introduce cysteine pairs at buried positions (i, i+3 or i, i+4 in helices) to form disulfide bonds (+5°C Tm each).' });
    if (proContent > 5) suggestions.push({ priority: 'Medium', suggestion: `Reduce proline content (${proContent.toFixed(1)}%) — prolines disrupt helices. Replace with alanine or leucine.` });
    if (glyContent > 10) suggestions.push({ priority: 'Medium', suggestion: `Reduce glycine content (${glyContent.toFixed(1)}%) — glycines increase backbone flexibility. Replace with alanine for rigidity.` });
    if (avgHydropathy < 0) suggestions.push({ priority: 'High', suggestion: 'Increase hydrophobic core residues (Val, Leu, Ile, Phe) — current hydropathy is low, suggesting weak core packing.' });
    if (chargedCount / len < 0.15) suggestions.push({ priority: 'Low', suggestion: 'Increase surface charged residues (Asp, Glu, Lys, Arg) for better solubility and salt bridge formation.' });
    if (score < 55) suggestions.push({ priority: 'High', suggestion: 'Consider consensus sequence engineering — align homologous thermophilic proteins and adopt their residues at weak positions.' });
    if (suggestions.length === 0) suggestions.push({ priority: 'Low', suggestion: 'Protein is already stable. Consider optimizing expression yield or activity instead.' });
    const prioColor = { High: '#dc2626', Medium: '#d97706', Low: '#059669' };
    document.getElementById('psp-engineering-list').innerHTML = suggestions.map(s => `<div style="border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);padding:0.625rem;margin-bottom:0.5rem;"><div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;"><strong>${s.priority} Priority</strong><span style="color:${prioColor[s.priority]};">${s.priority}</span></div><div style="font-size:0.8125rem;">${s.suggestion}</div></div>`).join('');
    document.getElementById('psp-engineering-section').style.display = 'block';

    // === Feature 7: pH Profile ===
    const phCanvas = document.getElementById('psp-ph-canvas');
    const phCtx = phCanvas.getContext('2d');
    const pw = phCanvas.width, ph = phCanvas.height;
    phCtx.fillStyle = '#ebedf5'; phCtx.fillRect(0, 0, pw, ph);
    phCtx.strokeStyle = 'rgba(15,23,42,0.1)';
    phCtx.lineWidth = 1;
    for (let i = 0; i <= 14; i += 2) { phCtx.beginPath(); phCtx.moveTo(i / 14 * pw, 0); phCtx.lineTo(i / 14 * pw, ph); phCtx.stroke(); }
    phCtx.strokeStyle = '#06b6d4'; phCtx.lineWidth = 2;
    phCtx.beginPath();
    const phData = [];
    for (let pHval = 0; pHval <= 14; pHval += 0.5) {
      const phScore = Math.max(0, score - Math.abs(pHval - 7) * 3);
      phData.push({ pH: pHval, score: phScore });
      const x = pHval / 14 * pw;
      const y = ph - (phScore / 100) * ph * 0.9 - 5;
      if (pHval === 0) phCtx.moveTo(x, y); else phCtx.lineTo(x, y);
    }
    phCtx.stroke();
    const optimalPH = phData.reduce((best, d) => d.score > best.score ? d : best, phData[0]);
    const stableRange = phData.filter(d => d.score >= 40);
    document.getElementById('psp-ph-list').innerHTML = `
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Optimal pH</span><strong>${optimalPH.pH.toFixed(1)}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Stable pH Range (score ≥ 40)</span><strong>${stableRange.length > 0 ? stableRange[0].pH.toFixed(1) + ' — ' + stableRange[stableRange.length - 1].pH.toFixed(1) : 'None'}</strong></div>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">Protein stability peaks near pH 7. Extreme pH disrupts ionic interactions and can denature the protein.</div>
    `;
    document.getElementById('psp-ph-section').style.display = 'block';

    // === Feature 8: Charge & pI ===
    const posCharges = (aaCount['K'] || 0) + (aaCount['R'] || 0) + (aaCount['H'] || 0) * 0.5;
    const negCharges = (aaCount['D'] || 0) + (aaCount['E'] || 0);
    const netCharge = posCharges - negCharges;
    // Simplified pI: find pH where net charge ≈ 0
    let pI = 7.0;
    for (let pHval = 0; pHval <= 14; pHval += 0.1) {
      const pos = (aaCount['K'] || 0) / (1 + Math.pow(10, pHval - 10.5)) + (aaCount['R'] || 0) / (1 + Math.pow(10, pHval - 12.5)) + (aaCount['H'] || 0) / (1 + Math.pow(10, pHval - 6.0));
      const neg = (aaCount['D'] || 0) / (1 + Math.pow(10, 3.9 - pHval)) + (aaCount['E'] || 0) / (1 + Math.pow(10, 4.1 - pHval));
      if (Math.abs(pos - neg) < 0.5) { pI = pHval; break; }
    }
    document.getElementById('psp-charge-list').innerHTML = `
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Positive Charges (K+R+H)</span><strong>${posCharges.toFixed(1)}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Negative Charges (D+E)</span><strong>${negCharges}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Net Charge at pH 7</span><strong style="color:${netCharge > 0 ? '#06b6d4' : netCharge < 0 ? '#d97706' : 'var(--tl-text)'};">${netCharge > 0 ? '+' : ''}${netCharge.toFixed(1)}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Estimated pI</span><strong>${pI.toFixed(1)}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Charge Density</span><strong>${(Math.abs(netCharge) / len * 100).toFixed(2)} /residue</strong></div>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">pI = ${pI.toFixed(1)}. Protein is ${netCharge > 0 ? 'positively' : 'negatively'} charged at pH 7.0. Use pI for isoelectric focusing and ion exchange chromatography design.</div>
    `;
    document.getElementById('psp-charge-section').style.display = 'block';

    // === Feature 9: Disorder Prediction ===
    const disorderRegions = [];
    for (let i = 0; i < seq.length; i++) {
      const props = aaProps[seq[i]];
      let disorderScore = 0;
      if (['P', 'G', 'S', 'Q', 'E', 'K'].includes(seq[i])) disorderScore += 2;
      if (props.hydropathy < -1) disorderScore += 1.5;
      if (['W', 'C', 'F', 'I', 'Y', 'V'].includes(seq[i])) disorderScore -= 2;
      if (props.helix < 0.8) disorderScore += 1;
      disorderRegions.push({ pos: i, score: disorderScore, aa: seq[i] });
    }
    // Smooth with window
    const disorderSmooth = [];
    const smoothWin = 5;
    for (let i = 0; i < disorderRegions.length; i++) {
      let sum = 0, count = 0;
      for (let j = Math.max(0, i - smoothWin); j <= Math.min(seq.length - 1, i + smoothWin); j++) { sum += disorderRegions[j].score; count++; }
      disorderSmooth.push({ pos: i, score: sum / count });
    }
    const disorderedSegments = [];
    let segStart = -1;
    for (let i = 0; i < disorderSmooth.length; i++) {
      if (disorderSmooth[i].score > 2 && segStart < 0) segStart = i;
      else if (disorderSmooth[i].score <= 2 && segStart >= 0) {
        if (i - segStart >= 10) disorderedSegments.push({ start: segStart, end: i - 1, length: i - segStart });
        segStart = -1;
      }
    }
    if (segStart >= 0 && seq.length - segStart >= 10) disorderedSegments.push({ start: segStart, end: seq.length - 1, length: seq.length - segStart });
    const disorderPct = (disorderSmooth.filter(d => d.score > 2).length / seq.length * 100).toFixed(1);
    document.getElementById('psp-disorder-list').innerHTML = `
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Disordered Residues</span><strong>${disorderPct}%</strong></div>
      <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Disordered Segments (≥10 aa)</span><strong>${disorderedSegments.length}</strong></div>
      ${disorderedSegments.slice(0, 5).map(s => `<div style="display:flex;justify-content:space-between;padding:0.375rem 0;border-bottom:1px solid var(--tl-border);font-size:0.8125rem;"><span>Positions ${s.start}-${s.end}</span><span>${s.length} residues</span></div>`).join('')}
      <div class="it-alert ${disorderedSegments.length > 0 ? 'it-alert-warn' : 'it-alert-good'}" style="margin-top:0.5rem;">${disorderedSegments.length > 0 ? '⚠️ Intrinsically disordered regions detected — these may be flexible linkers or binding interfaces.' : '✓ No significant disordered regions — protein likely well-folded.'}</div>
    `;
    document.getElementById('psp-disorder-section').style.display = 'block';

    // === Feature 10: Export ===
    document.getElementById('psp-export').style.display = 'inline-flex';
    document.getElementById('psp-export').onclick = () => {
      const report = { timestamp: new Date().toISOString(), sequence: seq.substring(0, 50) + '...', length: len, temperature: temp, pH, predictedTm: tm, dG, stabilityScore: score, stabilityClass, properties: { avgHydropathy, avgHelix, avgSheet, mw, disulfideBonds, proContent, glyContent }, secondaryStructure: { helixPct, sheetPct, coilPct }, disulfidePairs, aggregation: { risk: overallAggScore, regions: aggRegions.length }, charge: { netCharge, pI }, disorder: { disorderPct, segments: disorderedSegments }, engineeringSuggestions: suggestions };
      const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'protein-stability-report.json'; a.click();
    };
  }

  document.getElementById('psp-predict').addEventListener('click', predict);
  document.getElementById('psp-clear').addEventListener('click', () => {
    document.getElementById('psp-sequence').value = '';
    document.getElementById('psp-results').classList.remove('show');
  });
})();
</script>
