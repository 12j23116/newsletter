      fluorite: [{ plane: '{001}', direction: '<110>', count: 6, type: 'Cleavage', critical: 'High', ductility: 'Brittle (ionic)' }],
      perovskite: [{ plane: '{100}', direction: '<010>', count: 6, type: 'Cube', critical: 'High', ductility: 'Brittle (ceramic)' }],
      rocksalt: [{ plane: '{110}', direction: '<1-10>', count: 6, type: 'Cleavage', critical: 'High', ductility: 'Brittle (ionic)' }],
    };
    const slips = slipSystems[structId] || slipSystems.sc;
    document.getElementById('csv-slip-list').innerHTML = `
      <table class="it-table"><thead><tr><th>Slip Plane</th><th>Slip Direction</th><th># Systems</th><th>Type</th><th>CRSS</th><th>Ductility</th></tr></thead><tbody>
        ${slips.map(sl => `<tr><td style="font-family:var(--tl-mono);font-weight:700;">${sl.plane}</td><td style="font-family:var(--tl-mono);">${sl.direction}</td><td class="it-highlight">${sl.count}</td><td style="font-size:0.8125rem;">${sl.type}</td><td style="font-family:var(--tl-mono);font-size:0.8125rem;">${sl.critical}</td><td style="font-size:0.75rem;">${sl.ductility}</td></tr>`).join('')}
      </tbody></table>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">${structId === 'fcc' ? 'FCC has 12 {111}<110> slip systems — highest ductility among metals. Close-packed planes + close-packed directions = easy dislocation motion. This is why Cu, Al, Au are highly formable.' : structId === 'bcc' ? 'BCC has 48 total slip systems ({110}, {112}, {123}) but no close-packed plane. Higher CRSS → stronger but less ductile than FCC. Ductile-to-brittle transition at low temperature.' : structId === 'hcp' ? 'HCP has only 3 basal slip systems — insufficient for von Mises criterion (5 needed). Limited ductility unless non-basal slip or twinning activates. Mg and Ti need alloy design for formability.' : structId === 'diamond' ? 'Diamond cubic is covalent — dislocations require breaking strong directional bonds. Brittle at room temperature. Si shows some plasticity at high T (>600°C).' : 'Ceramic/ionic structures are brittle — slip requires overcoming strong electrostatic barriers. Fracture before yield at room temperature.'} Von Mises criterion: ≥5 independent slip systems needed for general plasticity.</div>
    `;
    document.getElementById('csv-slip-section').style.display = 'block';

    // === Feature 9: CIF Format Export ===
    const cifContent = `data_${element}_${structId}\n# Generated by Crystal Structure Visualizer\n_cell_length_a ${a}\n_cell_length_b ${structId === 'hcp' ? a : a}\n_cell_length_c ${structId === 'hcp' ? (a * 1.633).toFixed(4) : a}\n_cell_angle_alpha 90\n_cell_angle_beta 90\n_cell_angle_gamma ${structId === 'hcp' ? 120 : 90}\n_symmetry_space_group_name_H-M '${sym.hermannMauguin}'\n_symmetry_Int_Tables_number ${sym.spaceGroup}\n\nloop_\n_symmetry_equiv_pos_site_id\n_symmetry_equiv_pos_as_xyz\n1 'x, y, z'\n\nloop_\n_atom_site_label\n_atom_site_fract_x\n_atom_site_fract_y\n_atom_site_fract_z\n${s.positions.map((pos, i) => `${element}${i + 1} ${pos[0].toFixed(4)} ${pos[1].toFixed(4)} ${pos[2].toFixed(4)}`).join('\\n')}\n`;
    document.getElementById('csv-cif-list').innerHTML = `
      <div style="background:var(--tl-bg);border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);padding:1rem;overflow-x:auto;max-height:300px;overflow-y:auto;"><pre style="font-family:var(--tl-mono);font-size:0.75rem;white-space:pre-wrap;margin:0;">${cifContent}</pre></div>
      <div style="margin-top:0.75rem;"><button class="it-btn it-btn-secondary" id="csv-download-cif">⬇ Download CIF File</button></div>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">CIF (Crystallographic Information File) is the standard format for crystal structure data. Compatible with VESTA, Mercury, OLEX2, GSAS, and most crystallography software. Contains unit cell parameters, space group, and atomic positions. Use for DFT input generation or structure visualization in external tools.</div>
    `;
    document.getElementById('csv-cif-section').style.display = 'block';
    document.getElementById('csv-download-cif').addEventListener('click', () => { const blob = new Blob([cifContent], { type: 'chemical/x-cif' }); const dl = document.createElement('a'); dl.href = URL.createObjectURL(blob); dl.download = element + '_' + structId + '.cif'; dl.click(); });

    // === Feature 10: JSON Export ===
    document.getElementById('csv-export').style.display = 'inline-flex';
    document.getElementById('csv-export').onclick = () => {
      const report = { timestamp: new Date().toISOString(), structure: { id: structId, name: s.name, element, latticeParameter: a, atomicRadius: radius, atomicMass: mass }, results: { atomsPerCell: s.atoms, packingFactor: s.packing, density, coordinationNumber: s.coord, nearestNeighbor: structId === 'fcc' ? a / Math.sqrt(2) : structId === 'bcc' ? a * Math.sqrt(3) / 2 : structId === 'sc' ? a : structId === 'diamond' ? a * Math.sqrt(3) / 4 : a * 0.5 }, symmetry: sym, millerPlanes: millerPlanes.map(p => ({ ...p, dSpacing: dSpacingFormula(p.h, p.k, p.l), allowed: structId === 'bcc' ? (p.h + p.k + p.l) % 2 === 0 : structId === 'fcc' ? (p.h % 2 === p.k % 2 && p.k % 2 === p.l % 2) : true })), reciprocalSpace: recip, properties: propPredictions, defects: defectTypes, slipSystems: slips };
      const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
      const a2 = document.createElement('a'); a2.href = URL.createObjectURL(blob); a2.download = 'crystal-structure-report.json'; a2.click();
    };
  }

  document.getElementById('csv-visualize').addEventListener('click', visualize);
  document.getElementById('csv-reset').addEventListener('click', () => {
    document.getElementById('csv-results').classList.remove('show');
  });
})();
</script>
