---
/**
 * Crystal Structure Visualizer — Interactive tool
 * Visualize crystal lattices in 3D and calculate structural properties
 */
import './interactive-tools.css';

const structures = [
  { id: 'sc', name: 'Simple Cubic (SC)', atoms: 1, a: 1, b: 1, c: 1, angles: [90, 90, 90], packing: 0.52, examples: 'Po (Polonium)' },
  { id: 'bcc', name: 'Body-Centered Cubic (BCC)', atoms: 2, a: 1, b: 1, c: 1, angles: [90, 90, 90], packing: 0.68, examples: 'Fe, Cr, W, Mo' },
  { id: 'fcc', name: 'Face-Centered Cubic (FCC)', atoms: 4, a: 1, b: 1, c: 1, angles: [90, 90, 90], packing: 0.74, examples: 'Cu, Al, Au, Ag, Ni' },
  { id: 'hcp', name: 'Hexagonal Close-Packed (HCP)', atoms: 2, a: 1, b: 1, c: 1.633, angles: [90, 90, 120], packing: 0.74, examples: 'Mg, Ti, Zn, Co' },
  { id: 'diamond', name: 'Diamond Cubic', atoms: 8, a: 1, b: 1, c: 1, angles: [90, 90, 90], packing: 0.34, examples: 'Si, Ge, C (diamond)' },
  { id: 'fluorite', name: 'Fluorite (CaF2)', atoms: 12, a: 1, b: 1, c: 1, angles: [90, 90, 90], packing: 0.56, examples: 'CaF2, UO2, ZrO2' },
  { id: 'perovskite', name: 'Perovskite (ABO3)', atoms: 5, a: 1, b: 1, c: 1, angles: [90, 90, 90], packing: 0.62, examples: 'BaTiO3, SrTiO3' },
  { id: 'rocksalt', name: 'Rock Salt (NaCl)', atoms: 8, a: 1, b: 1, c: 1, angles: [90, 90, 90], packing: 0.64, examples: 'NaCl, KCl, MgO' },
];
---

<div class="it-container" id="crystal-viz">
  <div class="it-card">
    <div class="it-header">
      <div class="it-header-icon">💎</div>
      <div>
        <h2>Crystal Structure Visualizer</h2>
        <p>Visualize 3D crystal lattices and calculate structural properties</p>
      </div>
    </div>

    <div class="it-form">
      <div class="it-row">
        <div class="it-field">
          <label class="it-label">Crystal Structure</label>
          <select class="it-select" id="csv-structure">
            {structures.map(s => <option value={s.id}>{s.name}</option>)}
          </select>
        </div>
        <div class="it-field">
          <label class="it-label">Lattice Parameter a <span class="it-label-hint">(Å)</span></label>
          <input type="number" class="it-input" id="csv-a" value="4.05" min="1" max="20" step="0.01" />
        </div>
      </div>

      <div class="it-row">
        <div class="it-field">
          <label class="it-label">Atomic Radius <span class="it-label-hint">(Å)</span></label>
          <input type="number" class="it-input" id="csv-radius" value="1.43" min="0.3" max="5" step="0.01" />
        </div>
        <div class="it-field">
          <label class="it-label">Element Symbol</label>
          <input type="text" class="it-input" id="csv-element" value="Al" maxlength="2" />
        </div>
      </div>

      <div class="it-btn-row">
        <button class="it-btn it-btn-primary" id="csv-visualize">Visualize & Calculate</button>
        <button class="it-btn it-btn-secondary" id="csv-reset">Reset</button>
        <button class="it-btn it-btn-secondary" id="csv-export" style="display:none;">📄 Export JSON</button>
      </div>
    </div>

    <div class="it-results" id="csv-results">
      <div class="it-results-card">
        <div class="it-results-title">Crystal Structure Analysis</div>

        <div class="it-results-grid" style="margin-bottom: 1.5rem;">
          <div class="it-stat">
            <div class="it-stat-label">Atoms/Unit Cell</div>
            <div class="it-stat-value" id="csv-atoms">0</div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Packing Factor</div>
            <div class="it-stat-value" id="csv-packing">0</div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Density</div>
            <div class="it-stat-value" id="csv-density">0<span class="it-stat-unit"> g/cm³</span></div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Coordination #</div>
            <div class="it-stat-value" id="csv-coord">0</div>
          </div>
        </div>

        <div class="it-results-title">Unit Cell Projection (2D view)</div>
        <canvas id="csv-canvas" width="800" height="350" style="width:100%;border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);background:var(--tl-bg);margin-bottom:1.5rem;"></canvas>

        <div id="csv-details"></div>
        <div class="it-alert it-alert-info" id="csv-insight"></div>
      </div>

      <!-- Feature 1: Miller Indices & Planes -->
      <div class="it-results-card" id="csv-miller-section" style="display:none;">
        <div class="it-results-title">📐 Miller Indices & Crystal Planes</div>
        <canvas id="csv-miller-canvas" width="700" height="300" style="width:100%;border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);background:var(--tl-bg);margin-bottom:0.75rem;"></canvas>
        <div id="csv-miller-list"></div>
      </div>

      <!-- Feature 2: Symmetry Operations -->
      <div class="it-results-card" id="csv-symmetry-section" style="display:none;">
        <div class="it-results-title">🔄 Point Group & Symmetry Operations</div>
        <div id="csv-symmetry-list"></div>
      </div>

      <!-- Feature 3: Interplanar Spacing & d-spacings -->
      <div class="it-results-card" id="csv-dspacing-section" style="display:none;">
        <div class="it-results-title">📏 d-Spacings & XRD Reflections</div>
        <div id="csv-dspacing-list"></div>
      </div>

      <!-- Feature 4: Brillouin Zone Visualization -->
      <div class="it-results-card" id="csv-brillouin-section" style="display:none;">
        <div class="it-results-title">🌐 Reciprocal Space & Brillouin Zone</div>
        <div id="csv-brillouin-list"></div>
      </div>

      <!-- Feature 5: Structure Comparison Table -->
      <div class="it-results-card" id="csv-structure-comp-section" style="display:none;">
        <div class="it-results-title">⚖️ Crystal Structure Comparison</div>
        <div id="csv-structure-comp-list"></div>
      </div>

      <!-- Feature 6: Material Properties Prediction -->
      <div class="it-results-card" id="csv-properties-section" style="display:none;">
        <div class="it-results-title">🔬 Predicted Material Properties</div>
        <div id="csv-properties-list"></div>
      </div>

      <!-- Feature 7: Defect Analysis -->
      <div class="it-results-card" id="csv-defects-section" style="display:none;">
        <div class="it-results-title">⚠️ Crystal Defects & Imperfections</div>
        <div id="csv-defects-list"></div>
      </div>

      <!-- Feature 8: Slip Systems & Mechanical Properties -->
      <div class="it-results-card" id="csv-slip-section" style="display:none;">
        <div class="it-results-title">🔩 Slip Systems & Deformation Analysis</div>
        <div id="csv-slip-list"></div>
      </div>

      <!-- Feature 9: CIF Format Export -->
      <div class="it-results-card" id="csv-cif-section" style="display:none;">
        <div class="it-results-title">📄 CIF Format Output</div>
        <div id="csv-cif-list"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const structureData = {
    sc: { name: 'Simple Cubic', atoms: 1, packing: 0.52, coord: 6, positions: [[0,0,0]] },
    bcc: { name: 'Body-Centered Cubic', atoms: 2, packing: 0.68, coord: 8, positions: [[0,0,0],[0.5,0.5,0.5]] },
    fcc: { name: 'Face-Centered Cubic', atoms: 4, packing: 0.74, coord: 12, positions: [[0,0,0],[0.5,0.5,0],[0.5,0,0.5],[0,0.5,0.5]] },
    hcp: { name: 'Hexagonal Close-Packed', atoms: 2, packing: 0.74, coord: 12, positions: [[0,0,0],[0.333,0.667,0.5]] },
    diamond: { name: 'Diamond Cubic', atoms: 8, packing: 0.34, coord: 4, positions: [[0,0,0],[0.25,0.25,0.25],[0.5,0.5,0],[0.5,0,0.5],[0,0.5,0.5],[0.75,0.75,0.5],[0.75,0.5,0.75],[0.5,0.75,0.75]] },
    fluorite: { name: 'Fluorite (CaF2)', atoms: 12, packing: 0.56, coord: 8, positions: [[0,0,0],[0.25,0.25,0.25],[0.75,0.75,0.25],[0.75,0.25,0.75],[0.25,0.75,0.75],[0.5,0.5,0.5],[0,0.5,0.5],[0.5,0,0.5],[0.5,0.5,0],[0.25,0.25,0.75],[0.75,0.75,0.75],[0.25,0.75,0.25]] },
    perovskite: { name: 'Perovskite (ABO3)', atoms: 5, packing: 0.62, coord: 6, positions: [[0,0,0],[0.5,0.5,0.5],[0.5,0.5,0],[0.5,0,0.5],[0,0.5,0.5]] },
    rocksalt: { name: 'Rock Salt (NaCl)', atoms: 8, packing: 0.64, coord: 6, positions: [[0,0,0],[0.5,0.5,0],[0.5,0,0.5],[0,0.5,0.5],[0.5,0,0],[0,0.5,0],[0,0,0.5],[0.5,0.5,0.5]] },
  };

  const atomicMasses = { Al: 26.98, Fe: 55.85, Cu: 63.55, Au: 197.0, Ag: 107.87, Ni: 58.69, Mg: 24.31, Ti: 47.87, Zn: 65.38, Co: 58.93, Si: 28.09, Ge: 72.63, C: 12.01, W: 183.84, Mo: 95.96, Cr: 52.0, Po: 209.0, Ca: 40.08, F: 19.0, U: 238.03, Zr: 91.22, O: 16.0, Ba: 137.33, Ti: 47.87, Sr: 87.62, Na: 22.99, K: 39.10, Cl: 35.45, Mg: 24.31 };

  function visualize() {
    const structId = document.getElementById('csv-structure').value;
    const s = structureData[structId];
    const a = parseFloat(document.getElementById('csv-a').value) || 4.05;
    const radius = parseFloat(document.getElementById('csv-radius').value) || 1.43;
    const element = document.getElementById('csv-element').value || 'Al';
    const mass = atomicMasses[element] || 50;

    // Calculate density: ρ = (n × M) / (V × Nₐ)
    const Na = 6.022e23;
    const volume = a * a * a * 1e-24; // cm³
    const density = (s.atoms * mass) / (volume * Na);

    // Lattice parameter relationships
    let relationText = '';
    if (structId === 'sc') relationText = `a = 2r (a = ${(2 * radius).toFixed(2)} Å)`;
    else if (structId === 'bcc') relationText = `a = 4r/√3 (a = ${(4 * radius / Math.sqrt(3)).toFixed(2)} Å)`;
    else if (structId === 'fcc') relationText = `a = 2√2·r (a = ${(2 * Math.sqrt(2) * radius).toFixed(2)} Å)`;
    else if (structId === 'hcp') relationText = `a = 2r, c = 1.633a (c = ${(1.633 * 2 * radius).toFixed(2)} Å)`;
    else if (structId === 'diamond') relationText = `a = 8r/√3 (a = ${(8 * radius / Math.sqrt(3)).toFixed(2)} Å)`;
    else relationText = 'Complex relationship (multi-element)';

    // Update UI
    document.getElementById('csv-atoms').textContent = s.atoms;
    document.getElementById('csv-packing').textContent = s.packing.toFixed(2);
    document.getElementById('csv-density').innerHTML = density.toFixed(2) + '<span class="it-stat-unit"> g/cm³</span>';
    document.getElementById('csv-coord').textContent = s.coord;

    // Draw projection (isometric-ish view)
    const canvas = document.getElementById('csv-canvas');
    const ctx = canvas.getContext('2d');
    const w = canvas.width, h = canvas.height;
    ctx.fillStyle = '#ebedf5';
    ctx.fillRect(0, 0, w, h);

    // Grid
    ctx.strokeStyle = 'rgba(15,23,42,0.06)';
    ctx.lineWidth = 1;
    for (let i = 0; i < w; i += 40) { ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, h); ctx.stroke(); }
    for (let i = 0; i < h; i += 40) { ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(w, i); ctx.stroke(); }

    // Draw unit cell cube (isometric projection)
    const cx = w / 2, cy = h / 2;
    const scale = Math.min(w, h) * 0.3;
    const dx = scale * 0.5, dy = scale * 0.3, dz = scale * 0.5;

    // Cube vertices
    const cube = [
      [-dx, -dy, -dz], [dx, -dy, -dz], [dx, dy, -dz], [-dx, dy, -dz],
      [-dx, -dy, dz], [dx, -dy, dz], [dx, dy, dz], [-dx, dy, dz]
    ];

    // Project 3D to 2D (simple isometric)
    function project(p) {
      return [cx + p[0] + p[2] * 0.5, cy + p[1] - p[2] * 0.5];
    }

    // Draw cube edges
    const edges = [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]];
    ctx.strokeStyle = '#7c3aed';
    ctx.lineWidth = 2;
    edges.forEach(([a, b]) => {
      const pa = project(cube[a]), pb = project(cube[b]);
      ctx.beginPath();
      ctx.moveTo(pa[0], pa[1]);
      ctx.lineTo(pb[0], pb[1]);
      ctx.stroke();
    });

    // Draw atoms
    const atomRadius = Math.max(8, scale * 0.12);
    s.positions.forEach(pos => {
      // Map fractional coordinates to cube space
      const px = (pos[0] - 0.5) * 2 * dx;
      const py = (pos[1] - 0.5) * 2 * dy;
      const pz = (pos[2] - 0.5) * 2 * dz;
      const [sx, sy] = project([px, py, pz]);

      // Draw atom with gradient
      const grad = ctx.createRadialGradient(sx - atomRadius * 0.3, sy - atomRadius * 0.3, 0, sx, sy, atomRadius);
      grad.addColorStop(0, '#a78bfa');
      grad.addColorStop(1, '#5b21b6');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(sx, sy, atomRadius, 0, 2 * Math.PI);
      ctx.fill();
      ctx.strokeStyle = '#4c1d95';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Label
      ctx.fillStyle = '#fff';
      ctx.font = 'bold 10px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(element, sx, sy + 3);
    });

    // Labels
    ctx.fillStyle = '#5c5c72';
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(s.name, 10, 20);
    ctx.fillText(`a = ${a} Å`, 10, 35);

    // Details
    const details = document.getElementById('csv-details');
    details.innerHTML = `
      <table class="it-table">
        <thead><tr><th>Property</th><th>Value</th></tr></thead>
        <tbody>
          <tr><td>Structure Type</td><td>${s.name}</td></tr>
          <tr><td>Element</td><td>${element} (M = ${mass} g/mol)</td></tr>
          <tr><td>Lattice Parameter (a)</td><td>${a} Å</td></tr>
          <tr><td>Atomic Radius (r)</td><td>${radius} Å</td></tr>
          <tr><td>r/a Relationship</td><td>${relationText}</td></tr>
          <tr><td>Atoms per Unit Cell</td><td>${s.atoms}</td></tr>
          <tr><td>Coordination Number</td><td>${s.coord}</td></tr>
          <tr><td class="it-highlight">Atomic Packing Factor</td><td class="it-highlight">${s.packing.toFixed(2)} (${(s.packing * 100).toFixed(0)}%)</td></tr>
          <tr><td>Unit Cell Volume</td><td>${(a * a * a).toFixed(2)} ų</td></tr>
          <tr><td class="it-highlight">Theoretical Density</td><td class="it-highlight">${density.toFixed(3)} g/cm³</td></tr>
          <tr><td>Number Density</td><td>${(s.atoms / (a * a * a) * 1e24).toExponential(2)} atoms/cm³</td></tr>
          <tr><td>Nearest Neighbor Distance</td><td>${structId === 'fcc' ? (a / Math.sqrt(2)).toFixed(3) : structId === 'bcc' ? (a * Math.sqrt(3) / 2).toFixed(3) : structId === 'sc' ? a.toFixed(3) : structId === 'diamond' ? (a * Math.sqrt(3) / 4).toFixed(3) : (a * 0.5).toFixed(3)} Å</td></tr>
        </tbody>
      </table>
    `;

    const insight = document.getElementById('csv-insight');
    insight.innerHTML = `<strong>💡 Structure Analysis:</strong> ${s.name} has ${s.atoms} atoms per unit cell with a packing factor of ${(s.packing * 100).toFixed(0)}% and coordination number ${s.coord}. ${s.packing >= 0.74 ? 'This is a close-packed structure — maximum packing efficiency.' : s.packing <= 0.52 ? 'Low packing efficiency — significant void space.' : 'Moderate packing efficiency.'} The calculated density of ${density.toFixed(2)} g/cm³ ${density > 5 ? 'is typical for transition metals.' : density > 2 ? 'is typical for light metals and semiconductors.' : 'is typical for very light elements.'}`;

    document.getElementById('csv-results').classList.add('show');

    // === Feature 1: Miller Indices & Crystal Planes ===
    const millerPlanes = [
      { h: 1, k: 0, l: 0, name: '(100)', color: '#dc2626' },
      { h: 1, k: 1, l: 0, name: '(110)', color: '#d97706' },
      { h: 1, k: 1, l: 1, name: '(111)', color: '#059669' },
      { h: 2, k: 0, l: 0, name: '(200)', color: '#2563eb' },
      { h: 2, k: 1, l: 0, name: '(210)', color: '#7c3aed' },
      { h: 2, k: 2, l: 0, name: '(220)', color: '#0891b2' },
      { h: 3, k: 1, l: 1, name: '(311)', color: '#db2777' },
      { h: 2, k: 2, l: 2, name: '(222)', color: '#65a30d' },
    ];
    const millerCanvas = document.getElementById('csv-miller-canvas');
    const mCtx = millerCanvas.getContext('2d');
    const mW = millerCanvas.width, mH = millerCanvas.height;
    mCtx.fillStyle = '#ebedf5'; mCtx.fillRect(0, 0, mW, mH);
    mCtx.strokeStyle = '#94a3b8'; mCtx.lineWidth = 1;
    mCtx.beginPath(); mCtx.moveTo(50, 10); mCtx.lineTo(50, mH - 30); mCtx.lineTo(mW - 10, mH - 30); mCtx.stroke();
    const dSpacingFormula = structId === 'hcp' ? (h, k, l) => 1 / Math.sqrt((4/3 * (h*h + h*k + k*k)) / (a*a) + l*l / (1.633*a*1.633*a)) : (h, k, l) => a / Math.sqrt(h*h + k*k + l*l);
    const allDSpacings = millerPlanes.map(p => dSpacingFormula(p.h, p.k, p.l));
    const maxD = Math.max(...allDSpacings);
    millerPlanes.forEach((p, i) => {
      const d = dSpacingFormula(p.h, p.k, p.l);
      const x = 60 + i * (mW - 70) / millerPlanes.length;
      const barH = (d / maxD) * (mH - 60);
      mCtx.fillStyle = p.color + '33'; mCtx.fillRect(x, mH - 30 - barH, (mW - 70) / millerPlanes.length - 8, barH);
      mCtx.strokeStyle = p.color; mCtx.lineWidth = 1.5; mCtx.strokeRect(x, mH - 30 - barH, (mW - 70) / millerPlanes.length - 8, barH);
      mCtx.fillStyle = p.color; mCtx.font = 'bold 10px sans-serif'; mCtx.textAlign = 'center'; mCtx.fillText(p.name, x + (mW - 70) / millerPlanes.length / 2 - 4, mH - 15);
      mCtx.fillStyle = '#111125'; mCtx.font = '8px sans-serif'; mCtx.fillText(d.toFixed(2) + ' Å', x + (mW - 70) / millerPlanes.length / 2 - 4, mH - 35 - barH);
    });
    mCtx.fillStyle = '#64748b'; mCtx.font = '10px sans-serif'; mCtx.textAlign = 'center'; mCtx.fillText('d-spacing (Å)', mW / 2, mH - 3);
    const millerAllowed = { sc: 'All hkl allowed', bcc: 'h+k+l = even', fcc: 'h,k,l all even or all odd', hcp: 'h+2k = 3n, l even (or all)', diamond: 'h,k,l all odd, or all even with h+k+l=4n', fluorite: 'h,k,l all even or all odd', perovskite: 'All hkl allowed', rocksalt: 'h,k,l all even or all odd' };
    document.getElementById('csv-miller-list').innerHTML = `
      <table class="it-table"><thead><tr><th>Plane (hkl)</th><th>d-spacing (Å)</th><th>2θ (Cu Kα, λ=1.54Å)</th><th>Relative Intensity</th><th>Allowed?</th></tr></thead><tbody>
        ${millerPlanes.map(p => { const d = dSpacingFormula(p.h, p.k, p.l); const twoTheta = 2 * Math.asin(1.54 / (2 * d)) * 180 / Math.PI; const allowed = structId === 'bcc' ? (p.h + p.k + p.l) % 2 === 0 : structId === 'fcc' ? (p.h % 2 === p.k % 2 && p.k % 2 === p.l % 2) : structId === 'diamond' ? ((p.h % 2 === 1 && p.k % 2 === 1 && p.l % 2 === 1) || (p.h % 2 === 0 && p.k % 2 === 0 && p.l % 2 === 0 && (p.h + p.k + p.l) % 4 === 0)) : true; const intensity = allowed ? (100 / (p.h*p.h + p.k*p.k + p.l*p.l)).toFixed(0) + '%' : '0% (forbidden)'; return `<tr${allowed ? '' : ' style="opacity:0.4;"'}><td style="font-family:var(--tl-mono);font-weight:700;">${p.name}</td><td class="it-highlight">${d.toFixed(3)}</td><td>${isNaN(twoTheta) ? '—' : twoTheta.toFixed(1) + '°'}</td><td style="color:${allowed ? '#059669' : '#94a3b8'};">${intensity}</td><td style="color:${allowed ? '#059669' : '#dc2626'};font-weight:700;">${allowed ? '✓' : '✗'}</td></tr>`; }).join('')}
      </tbody></table>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">Selection rules: ${millerAllowed[structId] || 'All hkl allowed'}. d-spacing formula: ${structId === 'hcp' ? '1/d² = (4/3)(h²+hk+k²)/a² + l²/c²' : '1/d² = (h²+k²+l²)/a²'}. XRD uses Cu Kα radiation (λ=1.54 Å) to measure 2θ angles. Forbidden reflections appear absent in diffraction patterns due to systematic extinction.</div>
    `;
    document.getElementById('csv-miller-section').style.display = 'block';

    // === Feature 2: Symmetry Operations ===
    const symmetryData = {
      sc: { pointGroup: 'm3m', hermannMauguin: 'Pm-3m', spaceGroup: 221, class: 'Cubic', operations: ['E (identity)', '8C3 (body diagonals)', '6C4 (axes)', '3C2 (=C4²)', '6C2 (edge diagonals)', 'i (inversion)', '8S6', '6S4', '3σh', '6σd'], order: 48, laue: 'm3m' },
      bcc: { pointGroup: 'm3m', hermannMauguin: 'Im-3m', spaceGroup: 229, class: 'Cubic', operations: ['E', '8C3', '6C4', '3C2', '6C2', 'i', '8S6', '6S4', '3σh', '6σd'], order: 48, laue: 'm3m' },
      fcc: { pointGroup: 'm3m', hermannMauguin: 'Fm-3m', spaceGroup: 225, class: 'Cubic', operations: ['E', '8C3', '6C4', '3C2', '6C2', 'i', '8S6', '6S4', '3σh', '6σd'], order: 48, laue: 'm3m' },
      hcp: { pointGroup: '6/mmm', hermannMauguin: 'P63/mmc', spaceGroup: 194, class: 'Hexagonal', operations: ['E', '2C6', '2C3', 'C2', '3C2\'', '3C2\"', 'i', '2S3', '2S6', 'σh', '3σd', '3σv'], order: 24, laue: '6/mmm' },
