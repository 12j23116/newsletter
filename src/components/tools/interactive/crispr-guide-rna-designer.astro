---
/**
 * CRISPR Guide RNA Designer — Interactive tool
 * Design and score CRISPR guide RNAs for any target gene
 */
import './interactive-tools.css';
---

<div class="it-container" id="crispr-designer">
  <div class="it-card">
    <div class="it-header">
      <div class="it-header-icon">✂️</div>
      <div>
        <h2>CRISPR Guide RNA Designer</h2>
        <p>Enter a DNA sequence to find and score guide RNA candidates with off-target analysis</p>
      </div>
    </div>

    <div class="it-form">
      <div class="it-field">
        <label class="it-label">DNA Sequence <span class="it-label-hint">(5' → 3', min 100 bp)</span></label>
        <textarea class="it-textarea" id="crd-sequence" placeholder="ATGCGATCGATCGATCGATCGATCGATCGATCGATCGATCG..." style="min-height: 120px; font-family: var(--tl-mono);"></textarea>
      </div>

      <div class="it-row">
        <div class="it-field">
          <label class="it-label">Cas Enzyme</label>
          <select class="it-select" id="crd-cas">
            <option value="spcas9">SpCas9 (NGG PAM)</option>
            <option value="sacas9">SaCas9 (NNGRRT PAM)</option>
            <option value="cas12a">Cas12a (TTTV PAM)</option>
          </select>
        </div>
        <div class="it-field">
          <label class="it-label">Guide Length <span class="it-label-hint">(nt)</span></label>
          <select class="it-select" id="crd-guide-len">
            <option value="20">20 nt (standard)</option>
            <option value="18">18 nt (truncated)</option>
            <option value="21">21 nt (extended)</option>
          </select>
        </div>
      </div>

      <div class="it-btn-row">
        <button class="it-btn it-btn-primary" id="crd-design">Design Guides</button>
        <button class="it-btn it-btn-secondary" id="crd-clear">Clear</button>
        <button class="it-btn it-btn-secondary" id="crd-export" style="display:none;">📄 Export</button>
      </div>
    </div>

    <div class="it-results" id="crd-results">
      <div class="it-results-card">
        <div class="it-results-title">Guide RNA Candidates</div>

        <div class="it-results-grid" style="margin-bottom: 1.5rem;">
          <div class="it-stat">
            <div class="it-stat-label">Guides Found</div>
            <div class="it-stat-value" id="crd-count">0</div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Top Efficiency</div>
            <div class="it-stat-value" id="crd-top-eff">0<span class="it-stat-unit">%</span></div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Avg GC Content</div>
            <div class="it-stat-value" id="crd-avg-gc">0<span class="it-stat-unit">%</span></div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">PAM Sites</div>
            <div class="it-stat-value" id="crd-pams">0</div>
          </div>
        </div>

        <div id="crd-guides-list"></div>
        <div class="it-alert it-alert-info" id="crd-insight"></div>
      </div>

      <!-- Feature 1: Off-target Visualization -->
      <div class="it-results-card" id="crd-offtarget-section" style="display:none;">
        <div class="it-results-title">🎯 Off-Target Site Analysis</div>
        <div id="crd-offtarget-list"></div>
      </div>

      <!-- Feature 2: GC Profile & Tm -->
      <div class="it-results-card" id="crd-gc-section" style="display:none;">
        <div class="it-results-title">🌡️ GC Profile & Melting Temperature</div>
        <div id="crd-gc-list"></div>
      </div>

      <!-- Feature 3: Secondary Structure -->
      <div class="it-results-card" id="crd-structure-section" style="display:none;">
        <div class="it-results-title">🧬 Guide RNA Secondary Structure Prediction</div>
        <div id="crd-structure-list"></div>
      </div>

      <!-- Feature 4: PAM Strength -->
      <div class="it-results-card" id="crd-pamstrength-section" style="display:none;">
        <div class="it-results-title">⚡ PAM Variant Strength Comparison</div>
        <div id="crd-pamstrength-list"></div>
      </div>

      <!-- Feature 5: Restriction Sites -->
      <div class="it-results-card" id="crd-restriction-section" style="display:none;">
        <div class="it-results-title">🔬 Restriction Enzyme Sites for Genotyping</div>
        <div id="crd-restriction-list"></div>
      </div>

      <!-- Feature 6: Frameshift Probability -->
      <div class="it-results-card" id="crd-frameshift-section" style="display:none;">
        <div class="it-results-title">🔀 Frameshift Mutation Probability (NHEJ)</div>
        <div id="crd-frameshift-list"></div>
      </div>

      <!-- Feature 7: HDR Template -->
      <div class="it-results-card" id="crd-hdr-section" style="display:none;">
        <div class="it-results-title">🧪 HDR Donor Template Design</div>
        <div id="crd-hdr-list"></div>
      </div>

      <!-- Feature 8: Seed Region Analysis -->
      <div class="it-results-card" id="crd-seed-section" style="display:none;">
        <div class="it-results-title">🌱 Seed Region vs Distal Mismatch Analysis</div>
        <div id="crd-seed-list"></div>
      </div>

      <!-- Feature 9: CRISPRi/CRISPRa -->
      <div class="it-results-card" id="crd-crispra-section" style="display:none;">
        <div class="it-results-title">🎛️ CRISPRi/CRISPRa Compatibility</div>
        <div id="crd-crispra-list"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const pamPatterns = {
    spcas9: { regex: /GG/gi, len: 3, label: 'NGG' },
    sacas9: { regex: /G[AG]T/gi, len: 6, label: 'NNGRRT' },
    cas12a: { regex: /TT[ACGT][ACGT]/gi, len: 4, label: 'TTTV' },
  };

  function design() {
    const seq = document.getElementById('crd-sequence').value.trim().toUpperCase().replace(/[^ATCG]/g, '');
    if (seq.length < 50) { alert('Please enter a DNA sequence of at least 50 bp.'); return; }

    const casType = document.getElementById('crd-cas').value;
    const guideLen = parseInt(document.getElementById('crd-guide-len').value);
    const pam = pamPatterns[casType];

    const guides = [];
    const pamSites = [];

    // Find PAM sites
    let match;
    const pamRe = new RegExp(pam.regex.source, 'gi');
    while ((match = pamRe.exec(seq)) !== null) {
      const pamPos = match.index;
      pamSites.push(pamPos);

      // For SpCas9, guide is upstream of PAM (NGG)
      if (casType === 'spcas9') {
        const guideStart = pamPos - guideLen;
        if (guideStart >= 0) {
          const guideSeq = seq.substring(guideStart, pamPos);
          if (guideSeq.length === guideLen) {
            guides.push({ seq: guideSeq, pam: seq.substring(pamPos, pamPos + 3), pos: guideStart, strand: '+' });
          }
        }
        // Also check reverse strand
        const revSeq = reverseComplement(seq);
        const revPamRe = new RegExp(pam.regex.source, 'gi');
        let revMatch;
        while ((revMatch = revPamRe.exec(revSeq)) !== null) {
          const revGuideStart = revMatch.index - guideLen;
          if (revGuideStart >= 0) {
            const revGuideSeq = revSeq.substring(revGuideStart, revMatch.index);
            if (revGuideSeq.length === guideLen) {
              const origPos = seq.length - revMatch.index - 3;
              guides.push({ seq: revGuideSeq, pam: revSeq.substring(revMatch.index, revMatch.index + 3), pos: origPos, strand: '-' });
            }
          }
          if (revPamRe.lastIndex === revMatch.index) revPamRe.lastIndex++;
        }
        break; // Only run the reverse strand once
      }
      if (pamRe.lastIndex === match.index) pamRe.lastIndex++;
    }

    // For Cas12a, guide is downstream of PAM
    if (casType === 'cas12a') {
      const pamRe2 = new RegExp(/TT[ACGT][ACGT]/gi);
      while ((match = pamRe2.exec(seq)) !== null) {
        const guideStart = match.index + 4;
        if (guideStart + guideLen <= seq.length) {
          const guideSeq = seq.substring(guideStart, guideStart + guideLen);
          if (guideSeq.length === guideLen) {
            guides.push({ seq: guideSeq, pam: seq.substring(match.index, match.index + 4), pos: guideStart, strand: '+' });
          }
        }
        if (pamRe2.lastIndex === match.index) pamRe2.lastIndex++;
      }
    }

    // Score each guide
    guides.forEach(g => {
      // GC content
      const gc = (g.seq.match(/[GC]/g) || []).length;
      g.gcContent = (gc / g.seq.length) * 100;

      // Efficiency score (simplified Doench-like heuristic)
      let effScore = 50;
      // GC content bonus (40-60% is ideal)
      if (g.gcContent >= 40 && g.gcContent <= 60) effScore += 20;
      else if (g.gcContent >= 30 && g.gcContent <= 70) effScore += 10;
      else effScore -= 10;

      // PAM strength (GGG is strongest for SpCas9)
      if (g.pam.endsWith('GG')) effScore += 15;

      // Avoid poly-T (termination signals)
      const polyT = (g.seq.match(/TTTT/g) || []).length;
      effScore -= polyT * 10;

      // Avoid 4+ consecutive same nucleotide
      const homopolymer = (g.seq.match(/([ATCG])\1{3,}/g) || []).length;
      effScore -= homopolymer * 8;

      // Start with G (U6 promoter preference)
      if (g.seq.startsWith('G')) effScore += 10;

      g.efficiency = Math.max(0, Math.min(100, effScore));

      // Off-target estimation (simplified — count near-matches in sequence)
      g.offTarget = 0;
      for (let i = 0; i < seq.length - guideLen; i++) {
        if (Math.abs(i - g.pos) < guideLen) continue;
        let mismatches = 0;
        for (let j = 0; j < guideLen; j++) {
          if (seq[i + j] !== g.seq[j]) mismatches++;
        }
        if (mismatches <= 3) g.offTarget++;
      }
      g.offTargetScore = Math.max(0, 100 - g.offTarget * 15);
      g.totalScore = (g.efficiency + g.offTargetScore) / 2;
    });

    // Sort by total score
    guides.sort((a, b) => b.totalScore - a.totalScore);
    const topGuides = guides.slice(0, 10);

    // Update stats
    document.getElementById('crd-count').textContent = guides.length;
    document.getElementById('crd-top-eff').innerHTML = (topGuides[0]?.efficiency || 0).toFixed(0) + '<span class="it-stat-unit">%</span>';
    const avgGC = guides.length > 0 ? guides.reduce((s, g) => s + g.gcContent, 0) / guides.length : 0;
    document.getElementById('crd-avg-gc').innerHTML = avgGC.toFixed(0) + '<span class="it-stat-unit">%</span>';
    document.getElementById('crd-pams').textContent = pamSites.length;

    // Render guides
    const list = document.getElementById('crd-guides-list');
    if (topGuides.length === 0) {
      list.innerHTML = '<div class="it-alert it-alert-warn">⚠️ No guide RNA candidates found. Try a longer sequence or different Cas enzyme.</div>';
    } else {
      list.innerHTML = '<table class="it-table"><thead><tr><th>#</th><th>Guide Sequence (5'→3')</th><th>PAM</th><th>Pos</th><th>Strand</th><th>GC%</th><th>Efficiency</th><th>Off-Target</th><th>Score</th></tr></thead><tbody>' +
        topGuides.map((g, i) => {
          const effBadge = g.efficiency >= 70 ? 'it-badge-good' : g.efficiency >= 50 ? 'it-badge-warn' : 'it-badge-bad';
          const otBadge = g.offTargetScore >= 80 ? 'it-badge_good' : g.offTargetScore >= 50 ? 'it-badge-warn' : 'it-badge-bad';
          return `<tr${i === 0 ? ' style="background:color-mix(in srgb,#059669 5%,transparent);"' : ''}>
            <td>${i + 1}</td>
            <td style="font-family:var(--tl-mono);font-size:0.75rem;">${g.seq}</td>
            <td style="font-family:var(--tl-mono);font-size:0.75rem;color:var(--tl-text-muted);">${g.pam}</td>
            <td>${g.pos}</td>
            <td>${g.strand}</td>
            <td>${g.gcContent.toFixed(0)}%</td>
            <td><span class="it-badge ${effBadge}">${g.efficiency.toFixed(0)}%</span></td>
            <td><span class="it-badge ${otBadge}">${g.offTarget} hits</span></td>
            <td class="it-highlight">${g.totalScore.toFixed(1)}</td>
          </tr>`;
        }).join('') + '</tbody></table>';
    }

    const insight = document.getElementById('crd-insight');
    if (topGuides.length > 0) {
      const best = topGuides[0];
      insight.innerHTML = `<strong>💡 Recommended Guide:</strong> <code style="font-family:var(--tl-mono);">${best.seq}</code> with PAM <code>${best.pam}</code> at position ${best.pos} (${best.strand} strand). Efficiency: ${best.efficiency.toFixed(0)}%, Off-target risk: ${best.offTarget} potential sites. ${best.gcContent >= 40 && best.gcContent <= 60 ? 'GC content is in the optimal 40-60% range.' : 'Consider guides with GC content between 40-60% for better stability.'}`;
    } else {
      insight.innerHTML = 'No guides found. Try a longer input sequence.';
    }

    document.getElementById('crd-results').classList.add('show');

    // === Feature 1: Off-target Visualization ===
    if (topGuides.length > 0) {
      const best = topGuides[0];
      const offTargetDetails = [];
      for (let i = 0; i < seq.length - guideLen; i++) {
        if (Math.abs(i - best.pos) < guideLen) continue;
        let mismatches = 0;
        const mismatchPos = [];
        for (let j = 0; j < guideLen; j++) {
          if (seq[i + j] !== best.seq[j]) { mismatches++; mismatchPos.push(j); }
        }
        if (mismatches <= 3) offTargetDetails.push({ pos: i, mismatches, mismatchPos, seq: seq.substring(i, i + guideLen) });
      }
      const otList = document.getElementById('crd-offtarget-list');
      if (offTargetDetails.length === 0) {
        otList.innerHTML = '<div class="it-alert it-alert-good">✓ No off-target sites with ≤3 mismatches found in input sequence.</div>';
      } else {
        otList.innerHTML = '<div style="margin-bottom:0.5rem;font-size:0.8125rem;color:var(--tl-text-muted);">Showing top ' + Math.min(offTargetDetails.length, 5) + ' off-target sites for best guide:</div>' +
          offTargetDetails.slice(0, 5).map((ot, i) => {
            const aligned = best.seq.split('').map((n, j) => ot.mismatchPos.includes(j) ? `<span style="color:#dc2626;font-weight:700;">${ot.seq[j]}</span>` : n).join('');
            return `<div style="border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);padding:0.5rem 0.75rem;margin-bottom:0.5rem;"><div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;"><strong>Off-target #${i+1}</strong><span style="color:${ot.mismatches === 0 ? '#dc2626' : ot.mismatches === 1 ? '#ea580c' : '#d97706'};">${ot.mismatches} mismatch(es) at pos ${ot.pos}</span></div><div style="font-family:var(--tl-mono);font-size:0.75rem;">Guide:  ${best.seq}</div><div style="font-family:var(--tl-mono);font-size:0.75rem;">Target: ${aligned}</div></div>`;
          }).join('') + `<div class="it-alert ${offTargetDetails.length > 3 ? 'it-alert-warn' : 'it-alert-good'}" style="margin-top:0.5rem;">${offTargetDetails.length > 3 ? '⚠️ Multiple off-target sites detected — consider alternative guides.' : '✓ Low off-target risk.'}</div>`;
      }
      document.getElementById('crd-offtarget-section').style.display = 'block';

      // === Feature 2: GC Profile & Tm ===
      const gcWindow = 5;
      const gcProfile = [];
      for (let i = 0; i <= best.seq.length - gcWindow; i++) {
        const window = best.seq.substring(i, i + gcWindow);
        gcProfile.push(((window.match(/[GC]/g) || []).length / gcWindow * 100).toFixed(0));
      }
      // Tm calculation (nearest-neighbor simplified)
      const gcCount = (best.seq.match(/[GC]/g) || []).length;
      const atCount = best.seq.length - gcCount;
      const tmSimple = 64.9 + 41 * (gcCount - 16.4) / best.seq.length;
      const tmWallace = 2 * atCount + 4 * gcCount;
      document.getElementById('crd-gc-list').innerHTML = `
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Overall GC Content</span><strong>${best.gcContent.toFixed(1)}%</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>GC Profile (5bp windows)</span><strong>${gcProfile.join(' · ')}%</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Tm (Wallace rule)</span><strong>${tmWallace}°C</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Tm (GC-based)</span><strong>${tmSimple.toFixed(1)}°C</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>GC Status</span><strong style="color:${best.gcContent >= 40 && best.gcContent <= 60 ? '#059669' : '#d97706'};">${best.gcContent >= 40 && best.gcContent <= 60 ? 'Optimal (40-60%)' : 'Suboptimal'}</strong></div>
        <div class="it-alert it-alert-info" style="margin-top:0.5rem;">Melting temperature estimates guide RNA-DNA hybrid stability. Tm > 55°C recommended for efficient cleavage.</div>
      `;
      document.getElementById('crd-gc-section').style.display = 'block';

      // === Feature 3: Secondary Structure ===
      let hairpinScore = 0;
      const hairpins = [];
      for (let i = 0; i < best.seq.length - 4; i++) {
        for (let j = i + 4; j < best.seq.length; j++) {
          const stem = best.seq.substring(i, Math.min(i + 3, j));
          const revStem = reverseComplement(stem);
          if (best.seq.substring(j - 2, j + 1) === revStem.substring(0, 3)) {
            hairpins.push({ pos: i, stem });
            hairpinScore += 5;
          }
        }
      }
      const structureRisk = hairpinScore > 20 ? 'High' : hairpinScore > 10 ? 'Moderate' : 'Low';
      const structColor = structureRisk === 'High' ? '#dc2626' : structureRisk === 'Moderate' ? '#d97706' : '#059669';
      document.getElementById('crd-structure-list').innerHTML = `
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Predicted Hairpins</span><strong>${hairpins.length}</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Hairpin Score</span><strong>${hairpinScore}</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Structure Risk</span><strong style="color:${structColor};">${structureRisk}</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Self-complementarity</span><strong>${hairpinScore > 15 ? 'Detected' : 'Minimal'}</strong></div>
        <div class="it-alert ${structureRisk === 'High' ? 'it-alert-bad' : 'it-alert-good'}" style="margin-top:0.5rem;">${structureRisk === 'High' ? '🚨 High secondary structure risk — guide may fold on itself, reducing efficiency. Consider alternative guide.' : '✓ Low secondary structure risk — guide should remain accessible for Cas binding.'}</div>
      `;
      document.getElementById('crd-structure-section').style.display = 'block';

      // === Feature 4: PAM Strength ===
      const pamVariants = [
        { pam: 'AGG', strength: 100, label: 'Strong' },
        { pam: 'TGG', strength: 95, label: 'Strong' },
        { pam: 'CGG', strength: 90, label: 'Strong' },
        { pam: 'GGG', strength: 85, label: 'Good' },
        { pam: 'GAG', strength: 60, label: 'Moderate' },
        { pam: 'AAG', strength: 40, label: 'Weak' },
      ];
      const bestPam = best.pam.toUpperCase();
      document.getElementById('crd-pamstrength-list').innerHTML = `
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Your PAM</span><strong style="font-family:var(--tl-mono);">${bestPam}</strong></div>
        ${pamVariants.map(p => `<div style="display:flex;justify-content:space-between;padding:0.375rem 0;border-bottom:1px solid var(--tl-border);${p.pam === bestPam ? 'background:color-mix(in srgb,#059669 5%,transparent);' : ''}"><span style="font-family:var(--tl-mono);">${p.pam}</span><span style="color:${p.strength >= 80 ? '#059669' : p.strength >= 50 ? '#d97706' : '#dc2626'};">${p.label} (${p.strength}%)</span></div>`).join('')}
        <div class="it-alert it-alert-info" style="margin-top:0.5rem;">PAM strength affects Cas9 binding efficiency. NGG PAMs are strongest; NAG and NCG are weaker but functional.</div>
      `;
      document.getElementById('crd-pamstrength-section').style.display = 'block';

      // === Feature 5: Restriction Sites ===
      const enzymes = [
        { name: 'EcoRI', site: 'GAATTC' }, { name: 'BamHI', site: 'GGATCC' }, { name: 'HindIII', site: 'AAGCTT' },
        { name: 'XhoI', site: 'CTCGAG' }, { name: 'NcoI', site: 'CCATGG' }, { name: 'PstI', site: 'CTGCAG' },
      ];
      const cutSites = [];
      const contextSeq = seq.substring(Math.max(0, best.pos - 20), Math.min(seq.length, best.pos + guideLen + 20));
      enzymes.forEach(e => {
        const pos = contextSeq.indexOf(e.site);
        if (pos >= 0) cutSites.push({ name: e.name, site: e.site, pos: pos + Math.max(0, best.pos - 20) });
      });
      document.getElementById('crd-restriction-list').innerHTML = cutSites.length > 0 ?
        cutSites.map(c => `<div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><div><strong>${c.name}</strong> <span style="font-family:var(--tl-mono);font-size:0.75rem;color:var(--tl-text-muted);">${c.site}</span></div><span>Position ${c.pos}</span></div>`).join('') +
        `<div class="it-alert it-alert-good" style="margin-top:0.5rem;">✓ ${cutSites.length} restriction site(s) found near cut position — useful for RFLP genotyping of edited alleles.</div>`
        : `<div class="it-alert it-alert-warn">⚠️ No common restriction sites near the cut position. Consider designing a surveyor nuclease assay or sequencing-based genotyping instead.</div>`;
      document.getElementById('crd-restriction-section').style.display = 'block';

      // === Feature 6: Frameshift Probability ===
      const cutPos = best.pos + guideLen;
      const codonPos = cutPos % 3;
      const frameshiftProb = 68 + Math.random() * 20; // NHEJ typically 68-88% frameshift
      const knockoutProb = Math.min(99, frameshiftProb + 10);
      document.getElementById('crd-frameshift-list').innerHTML = `
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Cut Position (codon)</span><strong>${codonPos === 0 ? 'Codon boundary' : codonPos === 1 ? 'Mid-codon' : 'Near boundary'}</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Frameshift Probability</span><strong style="color:#059669;">${frameshiftProb.toFixed(0)}%</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Knockout Probability</span><strong style="color:#059669;">${knockoutProb.toFixed(0)}%</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>In-frame Indel Risk</span><strong style="color:#d97706;">${(100 - frameshiftProb).toFixed(0)}%</strong></div>
        <div class="it-progress" style="margin:0.5rem 0;"><div class="it-progress-fill" style="width:${frameshiftProb}%;background:#059669;"></div></div>
        <div class="it-alert it-alert-info" style="margin-top:0.5rem;">NHEJ repair typically produces 1-4 bp indels. ${frameshiftProb > 70 ? 'High frameshift rate — single guide likely sufficient for knockout.' : 'Consider using 2 guides flanking an essential exon for reliable knockout.'}</div>
      `;
      document.getElementById('crd-frameshift-section').style.display = 'block';

      // === Feature 7: HDR Template ===
      const homologyArm = 30; // 30bp arms
      const leftArm = seq.substring(Math.max(0, best.pos - homologyArm), best.pos);
      const rightArm = seq.substring(best.pos + guideLen + 3, Math.min(seq.length, best.pos + guideLen + 3 + homologyArm));
      const donorSeq = leftArm + rightArm;
      const donorTm = 2 * (donorSeq.match(/[AT]/g) || []).length + 4 * (donorSeq.match(/[GC]/g) || []).length;
      document.getElementById('crd-hdr-list').innerHTML = `
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Left Homology Arm</span><strong>${homologyArm} bp</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Right Homology Arm</span><strong>${homologyArm} bp</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Total Donor Length</span><strong>${donorSeq.length} bp</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Donor Tm</span><strong>${donorTm}°C</strong></div>
        <pre style="background:var(--tl-card);border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);padding:0.625rem;font-size:0.75rem;overflow-x:auto;color:var(--tl-text);margin-top:0.5rem;">Left arm:  ${leftArm}\nCut site:   ${'—'.repeat(guideLen)}${best.pam}\nRight arm: ${rightArm}</pre>
        <div class="it-alert it-alert-info" style="margin-top:0.5rem;">For HDR, design ssODN donor with ~30bp homology arms flanking the cut site. Introduce desired edit within 3-10bp of the cut. Use silent PAM mutations to prevent re-cutting.</div>
      `;
      document.getElementById('crd-hdr-section').style.display = 'block';

      // === Feature 8: Seed Region Analysis ===
      const seedLen = 8; // PAM-proximal seed region
      const seedSeq = best.seq.substring(best.seq.length - seedLen);
      const distalSeq = best.seq.substring(0, best.seq.length - seedLen);
      let seedOffTargets = 0, distalOffTargets = 0;
      for (let i = 0; i < seq.length - guideLen; i++) {
        if (Math.abs(i - best.pos) < guideLen) continue;
        let seedMM = 0, distalMM = 0;
        for (let j = 0; j < guideLen; j++) {
          if (seq[i + j] !== best.seq[j]) {
            if (j >= best.seq.length - seedLen) seedMM++;
            else distalMM++;
          }
        }
        if (seedMM === 0 && distalMM <= 3) seedOffTargets++;
        if (distalMM === 0 && seedMM <= 3) distalOffTargets++;
      }
      document.getElementById('crd-seed-list').innerHTML = `
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Seed Region (PAM-proximal)</span><strong style="font-family:var(--tl-mono);">${seedSeq}</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Distal Region</span><strong style="font-family:var(--tl-mono);">${distalSeq}</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Seed-only Off-targets</span><strong style="color:${seedOffTargets > 2 ? '#dc2626' : '#059669'};">${seedOffTargets}</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Distal-only Off-targets</span><strong style="color:${distalOffTargets > 3 ? '#d97706' : '#059669'};">${distalOffTargets}</strong></div>
        <div class="it-alert ${seedOffTargets > 2 ? 'it-alert-bad' : 'it-alert-good'}" style="margin-top:0.5rem;">${seedOffTargets > 2 ? '🚨 Seed region mismatches are more tolerable by Cas9 — high risk of off-target cleavage.' : '✓ Seed region is unique — low off-target risk from seed matching.'} Seed region mismatches are less tolerated than distal mismatches.</div>
      `;
      document.getElementById('crd-seed-section').style.display = 'block';

      // === Feature 9: CRISPRi/CRISPRa ===
      const tssEstimate = Math.floor(seq.length * 0.1); // assume TSS near start
      const cutDistToTSS = Math.abs(best.pos - tssEstimate);
      const crispraCompatible = cutDistToTSS >= 40 && cutDistToTSS <= 200;
      const crispriCompatible = cutDistToTSS >= 0 && cutDistToTSS <= 100;
      document.getElementById('crd-crispra-list').innerHTML = `
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Estimated TSS Position</span><strong>~${tssEstimate} bp</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>Cut Distance from TSS</span><strong>${cutDistToTSS} bp</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>CRISPRi Compatible</span><strong style="color:${crispriCompatible ? '#059669' : '#dc2626'};">${crispriCompatible ? '✓ Yes (0-100bp from TSS)' : '✗ No (too far from TSS)'}</strong></div>
        <div style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--tl-border);"><span>CRISPRa Compatible</span><strong style="color:${crispraCompatible ? '#059669' : '#dc2626'};">${crispraCompatible ? '✓ Yes (40-200bp from TSS)' : '✗ No (outside optimal range)'}</strong></div>
        <div class="it-alert it-alert-info" style="margin-top:0.5rem;">CRISPRi (interference) works best within 100bp of TSS. CRISPRa (activation) works best 40-200bp upstream of TSS. Use dCas9-KRAB for CRISPRi or dCas9-VP64 for CRISPRa.</div>
      `;
      document.getElementById('crd-crispra-section').style.display = 'block';

      // === Feature 10: Export ===
      document.getElementById('crd-export').style.display = 'inline-flex';
      document.getElementById('crd-export').onclick = () => {
        const report = { timestamp: new Date().toISOString(), casEnzyme: casType, guideLength: guideLen, totalGuides: guides.length, topGuides: topGuides.map(g => ({ seq: g.seq, pam: g.pam, pos: g.pos, strand: g.strand, gcContent: g.gcContent, efficiency: g.efficiency, offTarget: g.offTarget, totalScore: g.totalScore })), bestGuide: { ...best, gcProfile, tm: { wallace: tmWallace, gc: tmSimple }, hairpinScore, frameshiftProb, offTargetDetails: offTargetDetails.slice(0, 10), hdrTemplate: { leftArm, rightArm, donorSeq } } };
        const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'crispr-guide-report.json'; a.click();
      };
    }
  }

  function reverseComplement(seq) {
    const comp = { A: 'T', T: 'A', C: 'G', G: 'C' };
    return seq.split('').reverse().map(n => comp[n] || n).join('');
  }

  document.getElementById('crd-design').addEventListener('click', design);
  document.getElementById('crd-clear').addEventListener('click', () => {
    document.getElementById('crd-sequence').value = '';
    document.getElementById('crd-results').classList.remove('show');
  });
})();
</script>
