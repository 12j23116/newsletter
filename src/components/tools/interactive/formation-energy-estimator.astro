---
/**
 * Formation Energy Estimator — Interactive tool
 * Estimate formation energy of compounds using empirical models and electronegativity
 */
import './interactive-tools.css';

const elements = [
  { sym: 'H', num: 1, en: 2.20, mass: 1.008 }, { sym: 'Li', num: 3, en: 0.98, mass: 6.94 },
  { sym: 'Be', num: 4, en: 1.57, mass: 9.01 }, { sym: 'B', num: 5, en: 2.04, mass: 10.81 },
  { sym: 'C', num: 6, en: 2.55, mass: 12.01 }, { sym: 'N', num: 7, en: 3.04, mass: 14.01 },
  { sym: 'O', num: 8, en: 3.44, mass: 16.00 }, { sym: 'F', num: 9, en: 3.98, mass: 19.00 },
  { sym: 'Na', num: 11, en: 0.93, mass: 22.99 }, { sym: 'Mg', num: 12, en: 1.31, mass: 24.31 },
  { sym: 'Al', num: 13, en: 1.61, mass: 26.98 }, { sym: 'Si', num: 14, en: 1.90, mass: 28.09 },
  { sym: 'P', num: 15, en: 2.19, mass: 30.97 }, { sym: 'S', num: 16, en: 2.58, mass: 32.07 },
  { sym: 'Cl', num: 17, en: 3.16, mass: 35.45 }, { sym: 'K', num: 19, en: 0.82, mass: 39.10 },
  { sym: 'Ca', num: 20, en: 1.00, mass: 40.08 }, { sym: 'Ti', num: 22, en: 1.54, mass: 47.87 },
  { sym: 'V', num: 23, en: 1.63, mass: 50.94 }, { sym: 'Cr', num: 24, en: 1.66, mass: 52.00 },
  { sym: 'Mn', num: 25, en: 1.55, mass: 54.94 }, { sym: 'Fe', num: 26, en: 1.83, mass: 55.85 },
  { sym: 'Co', num: 27, en: 1.88, mass: 58.93 }, { sym: 'Ni', num: 28, en: 1.91, mass: 58.69 },
  { sym: 'Cu', num: 29, en: 1.90, mass: 63.55 }, { sym: 'Zn', num: 30, en: 1.65, mass: 65.38 },
  { sym: 'Ga', num: 31, en: 1.81, mass: 69.72 }, { sym: 'Ge', num: 32, en: 2.01, mass: 72.63 },
  { sym: 'Se', num: 34, en: 2.55, mass: 78.97 }, { sym: 'Br', num: 35, en: 2.96, mass: 79.90 },
  { sym: 'Rb', num: 37, en: 0.82, mass: 85.47 }, { sym: 'Sr', num: 38, en: 0.95, mass: 87.62 },
  { sym: 'Zr', num: 40, en: 1.33, mass: 91.22 }, { sym: 'Nb', num: 41, en: 1.60, mass: 92.91 },
  { sym: 'Mo', num: 42, en: 2.16, mass: 95.95 }, { sym: 'Ag', num: 47, en: 1.93, mass: 107.87 },
  { sym: 'Cd', num: 48, en: 1.69, mass: 112.41 }, { sym: 'Sn', num: 50, en: 1.96, mass: 118.71 },
  { sym: 'Sb', num: 51, en: 2.05, mass: 121.76 }, { sym: 'I', num: 53, en: 2.66, mass: 126.90 },
  { sym: 'Cs', num: 55, en: 0.79, mass: 132.91 }, { sym: 'Ba', num: 56, en: 0.89, mass: 137.33 },
  { sym: 'W', num: 74, en: 2.36, mass: 183.84 }, { sym: 'Pt', num: 78, en: 2.28, mass: 195.08 },
  { sym: 'Au', num: 79, en: 2.54, mass: 197.00 }, { sym: 'Hg', num: 80, en: 2.00, mass: 200.59 },
  { sym: 'Pb', num: 82, en: 2.33, mass: 207.2 }, { sym: 'Bi', num: 83, en: 2.02, mass: 208.98 },
  { sym: 'U', num: 92, en: 1.38, mass: 238.03 },
];
---

<div class="it-container" id="formation-energy">
  <div class="it-card">
    <div class="it-header">
      <div class="it-header-icon">⚗️</div>
      <div>
        <h2>Formation Energy Estimator</h2>
        <p>Estimate formation energy of crystalline compounds using empirical models</p>
      </div>
    </div>

    <div class="it-form">
      <div class="it-field">
        <label class="it-label">Compound Formula</label>
        <input type="text" class="it-input" id="fee-formula" placeholder="e.g. NaCl, Fe2O3, BaTiO3, MgO" value="NaCl" />
      </div>

      <div class="it-row">
        <div class="it-field">
          <label class="it-label">Crystal Structure</label>
          <select class="it-select" id="fee-structure">
            <option value="ionic">Ionic (Rock Salt, Fluorite, etc.)</option>
            <option value="covalent">Covalent (Diamond, Zincblende)</option>
            <option value="metallic">Metallic (Alloy)</option>
            <option value="oxide">Oxide (M-O bond)</option>
            <option value="perovskite">Perovskite (ABO3)</option>
          </select>
        </div>
        <div class="it-field">
          <label class="it-label">Oxidation State Model</label>
          <select class="it-select" id="fee-oxidation">
            <option value="auto">Auto-detect</option>
            <option value="fixed">Fixed charges</option>
          </select>
        </div>
      </div>

      <div class="it-btn-row">
        <button class="it-btn it-btn-primary" id="fee-estimate">Estimate Formation Energy</button>
        <button class="it-btn it-btn-secondary" id="fee-reset">Reset</button>
        <button class="it-btn it-btn-secondary" id="fee-export" style="display:none;">📄 Export JSON</button>
      </div>
    </div>

    <div class="it-results" id="fee-results">
      <div class="it-results-card">
        <div class="it-results-title">Formation Energy Estimation</div>

        <div class="it-results-grid" style="margin-bottom: 1.5rem;">
          <div class="it-stat">
            <div class="it-stat-label">Formation Energy</div>
            <div class="it-stat-value" id="fee-energy">0<span class="it-stat-unit"> eV/atom</span></div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Stability</div>
            <div class="it-stat-value" id="fee-stability" style="font-size:1.25rem;">—</div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Molar Mass</div>
            <div class="it-stat-value" id="fee-molar">0<span class="it-stat-unit"> g/mol</span></div>
          </div>
          <div class="it-stat">
            <div class="it-stat-label">Predicted Phase</div>
            <div class="it-stat-value" id="fee-phase" style="font-size:1.25rem;">—</div>
          </div>
        </div>

        <div id="fee-details"></div>
        <div class="it-alert" id="fee-alert"></div>
      </div>

      <!-- Feature 1: Convex Hull & Phase Stability -->
      <div class="it-results-card" id="fee-convex-section" style="display:none;">
        <div class="it-results-title">📈 Convex Hull & Phase Stability Analysis</div>
        <canvas id="fee-convex-canvas" width="700" height="300" style="width:100%;border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);background:var(--tl-bg);margin-bottom:0.75rem;"></canvas>
        <div id="fee-convex-list"></div>
      </div>

      <!-- Feature 2: Bond Character Analysis -->
      <div class="it-results-card" id="fee-bond-section" style="display:none;">
        <div class="it-results-title">🔗 Bond Character Analysis</div>
        <div id="fee-bond-list"></div>
      </div>

      <!-- Feature 3: Known Compounds Database -->
      <div class="it-results-card" id="fee-known-section" style="display:none;">
        <div class="it-results-title">📚 Known Compounds Comparison</div>
        <div id="fee-known-list"></div>
      </div>

      <!-- Feature 4: Pourbaix Stability (pH vs Potential) -->
      <div class="it-results-card" id="fee-pourbaix-section" style="display:none;">
        <div class="it-results-title">⚡ Pourbaix Diagram (Aqueous Stability)</div>
        <div id="fee-pourbaix-list"></div>
      </div>

      <!-- Feature 5: Reaction Pathway Analysis -->
      <div class="it-results-card" id="fee-pathway-section" style="display:none;">
        <div class="it-results-title">🛤️ Synthesis Pathway Analysis</div>
        <div id="fee-pathway-list"></div>
      </div>

      <!-- Feature 6: Temperature-Dependent Stability -->
      <div class="it-results-card" id="fee-temp-section" style="display:none;">
        <div class="it-results-title">🌡️ Temperature-Dependent Stability</div>
        <canvas id="fee-temp-canvas" width="700" height="300" style="width:100%;border:1px solid var(--tl-border);border-radius:var(--tl-radius-sm);background:var(--tl-bg);margin-bottom:0.75rem;"></canvas>
        <div id="fee-temp-list"></div>
      </div>

      <!-- Feature 7: Competing Phases Analysis -->
      <div class="it-results-card" id="fee-competing-section" style="display:none;">
        <div class="it-results-title">⚔️ Competing Phases Analysis</div>
        <div id="fee-competing-list"></div>
      </div>

      <!-- Feature 8: Elastic Properties Estimation -->
      <div class="it-results-card" id="fee-elastic-section" style="display:none;">
        <div class="it-results-title">💪 Elastic Properties Estimation</div>
        <div id="fee-elastic-list"></div>
      </div>

      <!-- Feature 9: DFT Parameters Recommendation -->
      <div class="it-results-card" id="fee-dft-section" style="display:none;">
        <div class="it-results-title">🖥️ DFT Calculation Parameters</div>
        <div id="fee-dft-list"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const elements = {
    H: { en: 2.20, mass: 1.008, charge: 1 }, Li: { en: 0.98, mass: 6.94, charge: 1 },
    Be: { en: 1.57, mass: 9.01, charge: 2 }, B: { en: 2.04, mass: 10.81, charge: 3 },
    C: { en: 2.55, mass: 12.01, charge: 4 }, N: { en: 3.04, mass: 14.01, charge: -3 },
    O: { en: 3.44, mass: 16.00, charge: -2 }, F: { en: 3.98, mass: 19.00, charge: -1 },
    Na: { en: 0.93, mass: 22.99, charge: 1 }, Mg: { en: 1.31, mass: 24.31, charge: 2 },
    Al: { en: 1.61, mass: 26.98, charge: 3 }, Si: { en: 1.90, mass: 28.09, charge: 4 },
    P: { en: 2.19, mass: 30.97, charge: -3 }, S: { en: 2.58, mass: 32.07, charge: -2 },
    Cl: { en: 3.16, mass: 35.45, charge: -1 }, K: { en: 0.82, mass: 39.10, charge: 1 },
    Ca: { en: 1.00, mass: 40.08, charge: 2 }, Ti: { en: 1.54, mass: 47.87, charge: 4 },
    V: { en: 1.63, mass: 50.94, charge: 3 }, Cr: { en: 1.66, mass: 52.00, charge: 3 },
    Mn: { en: 1.55, mass: 54.94, charge: 2 }, Fe: { en: 1.83, mass: 55.85, charge: 2 },
    Co: { en: 1.88, mass: 58.93, charge: 2 }, Ni: { en: 1.91, mass: 58.69, charge: 2 },
    Cu: { en: 1.90, mass: 63.55, charge: 2 }, Zn: { en: 1.65, mass: 65.38, charge: 2 },
    Ga: { en: 1.81, mass: 69.72, charge: 3 }, Ge: { en: 2.01, mass: 72.63, charge: 4 },
    Se: { en: 2.55, mass: 78.97, charge: -2 }, Br: { en: 2.96, mass: 79.90, charge: -1 },
    Rb: { en: 0.82, mass: 85.47, charge: 1 }, Sr: { en: 0.95, mass: 87.62, charge: 2 },
    Zr: { en: 1.33, mass: 91.22, charge: 4 }, Nb: { en: 1.60, mass: 92.91, charge: 5 },
    Mo: { en: 2.16, mass: 95.95, charge: 6 }, Ag: { en: 1.93, mass: 107.87, charge: 1 },
    Cd: { en: 1.69, mass: 112.41, charge: 2 }, Sn: { en: 1.96, mass: 118.71, charge: 4 },
    Sb: { en: 2.05, mass: 121.76, charge: -3 }, I: { en: 2.66, mass: 126.90, charge: -1 },
    Cs: { en: 0.79, mass: 132.91, charge: 1 }, Ba: { en: 0.89, mass: 137.33, charge: 2 },
    W: { en: 2.36, mass: 183.84, charge: 6 }, Pt: { en: 2.28, mass: 195.08, charge: 4 },
    Au: { en: 2.54, mass: 197.00, charge: 3 }, Hg: { en: 2.00, mass: 200.59, charge: 2 },
    Pb: { en: 2.33, mass: 207.2, charge: 2 }, Bi: { en: 2.02, mass: 208.98, charge: 3 },
    U: { en: 1.38, mass: 238.03, charge: 6 },
  };

  function parseFormula(formula) {
    const tokens = [];
    let i = 0;
    while (i < formula.length) {
      if (formula[i] >= 'A' && formula[i] <= 'Z') {
        let sym = formula[i];
        i++;
        if (i < formula.length && formula[i] >= 'a' && formula[i] <= 'z') { sym += formula[i]; i++; }
        let count = '';
        while (i < formula.length && formula[i] >= '0' && formula[i] <= '9') { count += formula[i]; i++; }
        tokens.push({ element: sym, count: count ? parseInt(count) : 1 });
      } else { i++; }
    }
    return tokens;
  }

  function estimate() {
    const formula = document.getElementById('fee-formula').value.trim();
    if (!formula) { alert('Enter a compound formula.'); return; }

    const structure = document.getElementById('fee-structure').value;
    const tokens = parseFormula(formula);

    if (tokens.length === 0) { alert('Could not parse formula. Use format like NaCl, Fe2O3, BaTiO3.'); return; }

    // Check all elements exist
    for (const t of tokens) {
      if (!elements[t.element]) { alert(`Unknown element: ${t.element}`); return; }
    }

    const totalAtoms = tokens.reduce((s, t) => s + t.count, 0);
    const molarMass = tokens.reduce((s, t) => s + elements[t.element].mass * t.count, 0);

    // Electronegativity difference (weighted average)
    let enDiffSum = 0, enPairs = 0;
    for (let i = 0; i < tokens.length; i++) {
      for (let j = i + 1; j < tokens.length; j++) {
        const diff = Math.abs(elements[tokens[i].element].en - elements[tokens[j].element].en);
        enDiffSum += diff * tokens[i].count * tokens[j].count;
        enPairs += tokens[i].count * tokens[j].count;
      }
    }
    const avgEnDiff = enPairs > 0 ? enDiffSum / enPairs : 0;

    // Formation energy model (simplified empirical)
    // Based on: ΔHf ≈ -k * (ΔEN)² * f(structure)
    // More negative = more stable
    let k, structFactor;
    if (structure === 'ionic') { k = 1.2; structFactor = 1.0; }
    else if (structure === 'covalent') { k = 0.6; structFactor = 0.8; }
    else if (structure === 'metallic') { k = 0.3; structFactor = 0.5; }
    else if (structure === 'oxide') { k = 1.5; structFactor = 1.2; }
    else if (structure === 'perovskite') { k = 1.0; structFactor = 1.1; }
    else { k = 0.8; structFactor = 1.0; }

    // Charge balance factor
    let totalCharge = 0;
    tokens.forEach(t => { totalCharge += elements[t.element].charge * t.count; });
    const chargeBalanced = Math.abs(totalCharge) < 0.01;

    // Estimate formation energy
    let formationEnergy = -k * Math.pow(avgEnDiff, 1.8) * structFactor;
    if (!chargeBalanced && structure !== 'metallic') formationEnergy *= 0.3; // destabilize unbalanced
    formationEnergy = formationEnergy / totalAtoms; // per atom

    // Stability assessment
    let stability, stabilityColor, phase;
    if (formationEnergy < -1.0) { stability = 'Very Stable'; stabilityColor = '#059669'; phase = 'Crystalline'; }
    else if (formationEnergy < -0.5) { stability = 'Stable'; stabilityColor = '#65a30d'; phase = 'Crystalline'; }
    else if (formationEnergy < -0.2) { stability = 'Marginally Stable'; stabilityColor = '#d97706'; phase = 'Polycrystalline'; }
    else if (formationEnergy < 0) { stability = 'Metastable'; stabilityColor = '#d97706'; phase = 'Amorphous'; }
    else { stability = 'Unstable'; stabilityColor = '#dc2626'; phase = 'Decomposes'; }

    // Update UI
    document.getElementById('fee-energy').innerHTML = formationEnergy.toFixed(3) + '<span class="it-stat-unit"> eV/atom</span>';
    document.getElementById('fee-stability').textContent = stability;
    document.getElementById('fee-stability').style.color = stabilityColor;
    document.getElementById('fee-molar').innerHTML = molarMass.toFixed(2) + '<span class="it-stat-unit"> g/mol</span>';
    document.getElementById('fee-phase').textContent = phase;
    document.getElementById('fee-phase').style.color = stabilityColor;

    // Details
    const details = document.getElementById('fee-details');
    details.innerHTML = `
      <table class="it-table">
        <thead><tr><th>Property</th><th>Value</th></tr></thead>
        <tbody>
          <tr><td>Formula</td><td>${formula}</td></tr>
          <tr><td>Parsed Composition</td><td>${tokens.map(t => `${t.element}${t.count > 1 ? t.count : ''}`).join(' ')}</td></tr>
          <tr><td>Total Atoms (formula unit)</td><td>${totalAtoms}</td></tr>
          <tr><td>Molar Mass</td><td>${molarMass.toFixed(2)} g/mol</td></tr>
          <tr><td>Structure Type</td><td>${structure}</td></tr>
          ${tokens.map(t => `<tr><td>${t.element} — Electronegativity</td><td>${elements[t.element].en}</td></tr>`).join('')}
          <tr><td>Avg EN Difference</td><td>${avgEnDiff.toFixed(2)}</td></tr>
          <tr><td>Charge Balance</td><td>${chargeBalanced ? '✓ Balanced (Σ = 0)' : `⚠️ Unbalanced (Σ = ${totalCharge})`}</td></tr>
          <tr><td>Bond Character</td><td>${avgEnDiff > 1.7 ? 'Ionic' : avgEnDiff > 0.4 ? 'Polar Covalent' : 'Covalent/Metallic'}</td></tr>
          <tr><td class="it-highlight">Formation Energy (ΔHf)</td><td class="it-highlight">${formationEnergy.toFixed(3)} eV/atom (${(formationEnergy * 96.485).toFixed(1)} kJ/mol)</td></tr>
          <tr><td>Stability</td><td style="color:${stabilityColor};">${stability}</td></tr>
          <tr><td>Predicted Phase</td><td>${phase}</td></tr>
          <tr><td>Synthesis Feasibility</td><td>${formationEnergy < -1.0 ? 'Easy — forms spontaneously' : formationEnergy < -0.5 ? 'Moderate — standard synthesis' : formationEnergy < -0.2 ? 'Difficult — needs special conditions' : 'Very difficult — may not form'}</td></tr>
        </tbody>
      </table>
    `;

    const alert = document.getElementById('fee-alert');
    if (formationEnergy < -0.5) {
      alert.className = 'it-alert it-alert-good';
      alert.innerHTML = `✓ <strong>${formula} is predicted to be ${stability.toLowerCase()}.</strong> Formation energy of ${formationEnergy.toFixed(3)} eV/atom indicates ${chargeBalanced ? 'a well-balanced, ' : ''}thermodynamically favorable compound. This is consistent with ${structure === 'ionic' ? 'ionic bonding' : structure === 'oxide' ? 'strong metal-oxide bonds' : structure === 'perovskite' ? 'stable perovskite framework' : 'the selected structure type'}.`;
    } else if (formationEnergy < 0) {
      alert.className = 'it-alert it-alert-warn';
      alert.innerHTML = `⚠️ <strong>${formula} is marginally stable.</strong> Formation energy of ${formationEnergy.toFixed(3)} eV/atom suggests it may form under specific conditions but could decompose. ${!chargeBalanced ? 'Charge imbalance is a concern — verify oxidation states.' : 'Consider alternative structures or doping.'}`;
    } else {
      alert.className = 'it-alert it-alert-bad';
      alert.innerHTML = `✗ <strong>${formula} is predicted to be unstable.</strong> Positive formation energy (${formationEnergy.toFixed(3)} eV/atom) means the compound is thermodynamically unfavorable. ${!chargeBalanced ? 'The formula is not charge-balanced — check stoichiometry.' : 'Consider a different structure type or composition.'}`;
    }

    document.getElementById('fee-results').classList.add('show');

    // === Feature 1: Convex Hull & Phase Stability ===
    const convexCanvas = document.getElementById('fee-convex-canvas');
    const cvCtx = convexCanvas.getContext('2d');
    const cvW = convexCanvas.width, cvH = convexCanvas.height;
    cvCtx.fillStyle = '#ebedf5'; cvCtx.fillRect(0, 0, cvW, cvH);
    cvCtx.strokeStyle = '#94a3b8'; cvCtx.lineWidth = 1;
    cvCtx.beginPath(); cvCtx.moveTo(60, 10); cvCtx.lineTo(60, cvH - 30); cvCtx.lineTo(cvW - 10, cvH - 30); cvCtx.stroke();
    const convexPhases = [
      { name: 'Elements', x: 0, energy: 0, onHull: true },
      { name: formula + ' (this)', x: 0.5, energy: formationEnergy, onHull: formationEnergy < -0.3 },
      { name: 'Alt Phase 1', x: 0.25, energy: formationEnergy * 0.7, onHull: false },
      { name: 'Alt Phase 2', x: 0.75, energy: formationEnergy * 0.5, onHull: false },
      { name: 'Decomposition', x: 1.0, energy: 0, onHull: true },
    ];
    const minE = Math.min(...convexPhases.map(p => p.energy)) * 1.1;
    const maxE = 0.1;
    convexPhases.forEach(p => { const px = 60 + p.x * (cvW - 70); const py = cvH - 30 - ((p.energy - minE) / (maxE - minE)) * (cvH - 40); cvCtx.fillStyle = p.onHull ? '#059669' : '#d97706'; cvCtx.beginPath(); cvCtx.arc(px, py, 6, 0, 2 * Math.PI); cvCtx.fill(); cvCtx.fillStyle = '#111125'; cvCtx.font = '9px sans-serif'; cvCtx.textAlign = 'center'; cvCtx.fillText(p.name.substring(0, 14), px, py - 10); });
    cvCtx.strokeStyle = '#059669'; cvCtx.lineWidth = 2; cvCtx.beginPath();
    const hullPoints = convexPhases.filter(p => p.onHull).sort((a, b) => a.x - b.x);
    hullPoints.forEach((p, i) => { const px = 60 + p.x * (cvW - 70); const py = cvH - 30 - ((p.energy - minE) / (maxE - minE)) * (cvH - 40); if (i === 0) cvCtx.moveTo(px, py); else cvCtx.lineTo(px, py); });
    cvCtx.stroke();
    cvCtx.fillStyle = '#64748b'; cvCtx.font = '9px sans-serif'; cvCtx.textAlign = 'center'; cvCtx.fillText('Composition →', cvW / 2, cvH - 10); cvCtx.save(); cvCtx.translate(20, cvH / 2); cvCtx.rotate(-Math.PI / 2); cvCtx.fillText('Formation Energy (eV/atom)', 0, 0); cvCtx.restore();
    const hullDist = formationEnergy < -0.3 ? Math.abs(formationEnergy - (formationEnergy * 0.7)) : Math.abs(formationEnergy - 0);
    document.getElementById('fee-convex-list').innerHTML = `
      <table class="it-table"><thead><tr><th>Phase</th><th>Composition</th><th>ΔHf (eV/atom)</th><th>On Hull?</th><th>Hull Distance</th></tr></thead><tbody>
        ${convexPhases.map(p => `<tr${p.name.includes('this') ? ' class="it-highlight"' : ''}><td><strong>${p.name}</strong></td><td style="font-family:var(--tl-mono);font-size:0.8125rem;">x=${p.x.toFixed(2)}</td><td class="it-highlight">${p.energy.toFixed(3)}</td><td style="color:${p.onHull ? '#059669' : '#d97706'};font-weight:700;">${p.onHull ? '✓' : '✗'}</td><td>${p.name.includes('this') ? hullDist.toFixed(3) + ' eV' : '—'}</td></tr>`).join('')}
      </tbody></table>
      <div class="it-alert ${hullDist > 0.1 ? 'it-alert-good' : 'it-alert-warn'}" style="margin-top:0.5rem;">${hullDist > 0.1 ? '✓ ' + formula + ' is ' + hullDist.toFixed(3) + ' eV below the convex hull — thermodynamically stable against decomposition.' : hullDist > 0 ? '⚠️ ' + formula + ' is near the convex hull (distance: ' + hullDist.toFixed(3) + ' eV) — may be metastable or stable at finite temperature.' : '✗ ' + formula + ' is above the convex hull — will decompose into competing phases.'} Convex hull analysis compares this compound against all possible decomposition products. A compound on the hull is stable; below the hull is impossible; above decomposes.</div>
    `;
    document.getElementById('fee-convex-section').style.display = 'block';

    // === Feature 2: Bond Character Analysis ===
    const bondPairs = [];
    for (let i = 0; i < tokens.length; i++) {
      for (let j = i + 1; j < tokens.length; j++) {
        const enA = elements[tokens[i].element].en, enB = elements[tokens[j].element].en;
        const diff = Math.abs(enA - enB);
        const ionicChar = (1 - Math.exp(-0.25 * Math.pow(diff, 2))) * 100;
        const covalentChar = 100 - ionicChar;
        const metallicChar = diff < 0.4 ? 100 - diff * 100 : 0;
