        ${dftParams.map(p => `<tr><td><strong>${p.param}</strong></td><td style="font-family:var(--tl-mono);font-size:0.8125rem;" class="it-highlight">${p.value}</td><td style="font-size:0.75rem;">${p.note}</td></tr>`).join('')}
      </tbody></table>
      <div class="it-alert it-alert-info" style="margin-top:0.5rem;">Recommended DFT parameters for ${formula} (${structure}, ${totalAtoms} atoms/unit cell). Use VASP, Quantum ESPRESSO, or ABINIT. Verify convergence: increase ENCUT by 20% and k-points by 50% — ΔHf should change <10 meV/atom. Compare with Materials Project (mpmaterials.org) for validation. For high-throughput: use AFLOW or OQMD workflows.</div>
    `;
    document.getElementById('fee-dft-section').style.display = 'block';

    // === Feature 10: JSON Export ===
    document.getElementById('fee-export').style.display = 'inline-flex';
    document.getElementById('fee-export').onclick = () => {
      const report = { timestamp: new Date().toISOString(), compound: { formula, structure, composition: tokens, totalAtoms, molarMass }, results: { formationEnergy, stability, phase, chargeBalanced, avgEnDiff, bondCharacter: avgEnDiff > 1.7 ? 'Ionic' : avgEnDiff > 0.4 ? 'Polar Covalent' : 'Covalent/Metallic' }, convexHull: convexPhases, bonds: bondPairs, knownCompounds: matchingKnown, pourbaix: pourbaixRegions, synthesis: synthesisRoutes, thermalStability: temps.map((T, i) => ({ T, gibbsEnergy: gibbsEnergies[i] })), competingPhases, elasticProperties: elasticProps, dftParameters: dftParams };
      const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'formation-energy-report.json'; a.click();
    };
  }

  document.getElementById('fee-estimate').addEventListener('click', estimate);
  document.getElementById('fee-reset').addEventListener('click', () => {
    document.getElementById('fee-results').classList.remove('show');
  });
  document.getElementById('fee-formula').addEventListener('keydown', e => { if (e.key === 'Enter') estimate(); });
})();
</script>
