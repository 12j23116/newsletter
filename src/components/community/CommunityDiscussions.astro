---

<section class="community-discussions-section">
  <div class="community-container">
    <div class="community-section-head">
      <span class="community-eyebrow">Active Threads</span>
      <h2 class="community-section-title">What People Are Talking About</h2>
      <p class="community-section-sub">
        Real discussions from our community — from technical deep dives to heated debates.
        Join the conversation or start your own thread.
      </p>
    </div>

    <div class="community-discussions-list">
      {discussions.map((d) => (
        <a href="#" class="community-discussion-card" style={`--card-color:${d.topicColor}`}>
          <div class="community-discussion-header">
            <span class="community-discussion-topic" style={`background:${d.topicColor}22;color:${d.topicColor}`}>{d.topic}</span>
            <span class="community-discussion-tag" style={`background:${d.tagColor}22;color:${d.tagColor}`}>{d.tag}</span>
          </div>
          <h3 class="community-discussion-title">{d.title}</h3>
          <p class="community-discussion-excerpt">{d.excerpt}</p>
          <div class="community-discussion-footer">
            <span class="community-discussion-author">by {d.author}</span>
            <span class="community-discussion-stats">
              <span class="community-discussion-replies">{d.replies} replies</span>
              <span class="community-discussion-views">{d.views} views</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
