    tag: 'Hot',
    tagColor: '#ef4444',
  },
  {
    topic: 'Fusion',
    topicColor: '#f59e0b',
    title: 'Helion 2028 deadline: realistic or hype?',
    author: 'FusionFanatic',
    replies: 89,
