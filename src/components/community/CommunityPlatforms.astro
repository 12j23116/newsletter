---
/**
 * CommunityPlatforms — Platform channels section
 * Independent component. Edits here do NOT affect other pages.
 */
const platforms = [
  {
    name: 'Discord Server',
    desc: 'Real-time chat, voice rooms, and study groups. The hub for daily discussions across all 12 topics.',
