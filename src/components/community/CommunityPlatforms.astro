    icon: 'M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zM8 12h.01M12 12h.01M16 12h.01',
    color: '#5865F2',
    href: '#discord',
    badge: 'Most Active',
  },
  {
    name: 'Reddit Community',
    desc: 'Long-form discussions, deep dives, and community-voted guides. r/TechNanoAI for weekly threads.',
    members: '25,000+',
    icon: 'M12 8c-2 0-3 1-3 3 0 2 1 3 3 3s3-1 3-3-1-3-3-3z',
    color: '#FF4500',
