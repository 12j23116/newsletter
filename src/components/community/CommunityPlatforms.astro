    href: '#youtube',
    badge: 'Video Series',
  },
  {
    name: 'Newsletter',
    desc: 'Weekly digest of the most important developments across all 12 frontiers. Curated, concise, free.',
    members: '50,000+',
    icon: 'M22 6l-10 7L2 6M2 6h20v12H2z',
    color: '#10b981',
    href: '/newsletter',
    badge: 'Weekly',
