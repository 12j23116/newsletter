---

<section class="community-platforms-section">
  <div class="community-container">
    <div class="community-section-head">
      <span class="community-eyebrow">Where We Hang Out</span>
      <h2 class="community-section-title">Six Platforms, One Community</h2>
      <p class="community-section-sub">
        Different platforms for different conversations. Pick the ones that fit your style —
        from real-time Discord chats to deep-dive Reddit threads to weekly newsletter digests.
      </p>
    </div>

    <div class="community-platforms-grid">
      {platforms.map((p) => (
        <a href={p.href} class="community-platform-card" style={`--card-color:${p.color}`}>
          <div class="community-platform-header">
            <div class="community-platform-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon} />
              </svg>
            </div>
            <span class="community-platform-badge">{p.badge}</span>
          </div>
          <h3 class="community-platform-name">{p.name}</h3>
          <p class="community-platform-desc">{p.desc}</p>
          <div class="community-platform-footer">
            <span class="community-platform-members">{p.members} members</span>
            <span class="community-platform-join">Join →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
