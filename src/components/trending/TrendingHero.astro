---
import { trendingStats, trendingTimeframes } from '../../data/trending/trending-content';
---

<section class="tr-hero">
  <div class="tr-hero-bg">
    <div class="tr-hero-grid"></div>
    <div class="tr-hero-beam tr-hero-beam-1"></div>
    <div class="tr-hero-beam tr-hero-beam-2"></div>
    <div class="tr-hero-orb tr-hero-orb-1"></div>
    <div class="tr-hero-orb tr-hero-orb-2"></div>
  </div>
  <div class="tr-hero-inner">
    <span class="tr-eyebrow">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
      </svg>
      Trending Now · Updated Hourly
    </span>
    <h1 class="tr-hero-title">
      What the tech world is<br />
      <span class="tr-grad">talking about right now.</span>
    </h1>
    <p class="tr-hero-sub">
      The most-read emerging tech articles across 12 frontiers — from AI breakthroughs to fusion milestones,
      quantum advances to cybersecurity threats. Ranked by real-time engagement data.
    </p>
    <div class="tr-hero-stats">
      {trendingStats.map((stat) => (
        <div class="tr-hero-stat">
          <strong>{stat.value}{stat.suffix}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
    <div class="tr-hero-timeframes">
      {trendingTimeframes.map((tf) => (
        <button class="tr-timeframe-pill" data-timeframe={tf.id}>{tf.label}</button>
      ))}
    </div>
  </div>
</section>
