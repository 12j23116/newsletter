---
/**
 * ContactFAQ — FAQ section specific to contact page
 * Independent component. Edits here do NOT affect other pages.
 */
const faqs = [
  {
    q: 'How long does it take to get a response?',
    a: 'We respond to all messages within 48 hours. General inquiries are usually answered within a few hours during business days. Partnership and contributor pitches may take longer as they involve multiple team members.',
  },
  {
    q: 'Can I suggest a topic for a guide?',
    a: 'Absolutely. Select "Topic Request" as the inquiry type and tell us what you want to learn about. We track all requests and prioritize topics with the most community interest.',
  },
  {
    q: 'Do you accept guest posts or contributor guides?',
    a: 'Yes. We have an active contributor program. Select "Contributor Pitch" and include your area of expertise, a brief outline, and any writing samples. Our editorial team will review and respond.',
  },
  {
    q: 'I found an error in an article. What should I do?',
    a: 'Select "Report an Issue" and include the article URL, the specific error, and a source contradicting our content if available. We take accuracy seriously and will correct it promptly.',
  },
  {
    q: 'Are you open to partnerships or sponsorships?',
    a: 'We partner with organizations that align with our values. We do not accept paid placements or sponsored content disguised as editorial. Select "Partnership Opportunity" to start the conversation.',
  },
  {
    q: 'Can I interview someone from TechNanoAI?',
    a: 'Yes. Select "Press / Media" and include the publication, interview format, deadline, and topics you want to cover. We will connect you with the right team member.',
  },
];
---

<section class="contact-faq-section">
  <div class="contact-container">
    <div class="contact-section-head contact-section-head-center">
      <span class="contact-eyebrow">Before You Ask</span>
      <h2 class="contact-section-title">Frequently Asked Questions</h2>
      <p class="contact-section-sub">
        Common questions about contacting us. If your question is not here, send us a message
        and we will get back to you.
      </p>
    </div>

    <div class="contact-faq-list">
      {faqs.map((faq, i) => (
        <details class="contact-faq-item" open={i === 0}>
          <summary class="contact-faq-question">
            <span>{faq.q}</span>
            <svg class="contact-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="contact-faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
