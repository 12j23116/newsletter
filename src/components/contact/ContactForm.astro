---
/**
 * ContactForm — Contact form section
 * Independent component. Edits here do NOT affect other pages.
 */
const inquiryTypes = [
  { value: 'general', label: 'General Inquiry' },
  { value: 'feedback', label: 'Content Feedback' },
  { value: 'partnership', label: 'Partnership Opportunity' },
  { value: 'contribute', label: 'Contributor Pitch' },
  { value: 'press', label: 'Press / Media' },
  { value: 'topic', label: 'Topic Request' },
  { value: 'bug', label: 'Report an Issue' },
  { value: 'other', label: 'Other' },
];
---

<section class="contact-form-section" id="contact-form">
  <div class="contact-container">
    <div class="contact-form-wrapper">
      <div class="contact-form-info">
        <span class="contact-eyebrow">Send a Message</span>
        <h2 class="contact-form-title">Tell Us What Is on Your Mind</h2>
        <p class="contact-form-sub">
          Fill out the form and we will get back to you within 48 hours. The more detail you
          provide, the better we can help.
        </p>

        <div class="contact-form-meta">
          <div class="contact-form-meta-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <div>
              <span class="contact-form-meta-label">Response Time</span>
              <span class="contact-form-meta-value">Within 48 hours</span>
            </div>
          </div>
          <div class="contact-form-meta-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            <div>
              <span class="contact-form-meta-label">Team</span>
              <span class="contact-form-meta-value">Real humans, not bots</span>
            </div>
          </div>
          <div class="contact-form-meta-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            <div>
              <span class="contact-form-meta-label">Privacy</span>
              <span class="contact-form-meta-value">Your data stays private</span>
            </div>
          </div>
        </div>
      </div>

      <form class="contact-form" action="/api/contact" method="POST">
        <div class="contact-form-row">
          <div class="contact-field">
            <label class="contact-label" for="name">Name <span class="contact-required">*</span></label>
            <input class="contact-input" type="text" id="name" name="name" required placeholder="Your full name" />
          </div>
          <div class="contact-field">
            <label class="contact-label" for="email">Email <span class="contact-required">*</span></label>
            <input class="contact-input" type="email" id="email" name="email" required placeholder="you@example.com" />
          </div>
        </div>

        <div class="contact-form-row">
          <div class="contact-field">
            <label class="contact-label" for="company">Company / Organization</label>
            <input class="contact-input" type="text" id="company" name="company" placeholder="Optional" />
          </div>
          <div class="contact-field">
            <label class="contact-label" for="inquiry-type">Inquiry Type <span class="contact-required">*</span></label>
            <select class="contact-select" id="inquiry-type" name="inquiry-type" required>
              <option value="" disabled selected>Select a type</option>
              {inquiryTypes.map((t) => (
                <option value={t.value}>{t.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="contact-field">
          <label class="contact-label" for="subject">Subject <span class="contact-required">*</span></label>
          <input class="contact-input" type="text" id="subject" name="subject" required placeholder="Brief summary of your message" />
        </div>

        <div class="contact-field">
          <label class="contact-label" for="message">Message <span class="contact-required">*</span></label>
          <textarea class="contact-textarea" id="message" name="message" required placeholder="Tell us more..."></textarea>
        </div>

        <div class="contact-field contact-checkbox-field">
          <label class="contact-checkbox-label">
            <input type="checkbox" id="consent" name="consent" required />
            <span class="contact-checkbox-custom"></span>
            <span>I agree to the <a href="/privacy">Privacy Policy</a> and consent to being contacted about my inquiry.</span>
          </label>
        </div>

        <button class="contact-submit" type="submit">
          Send Message
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>
      </form>
    </div>
  </div>
</section>
