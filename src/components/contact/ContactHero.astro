---
/**
 * ContactHero — Hero section for the Contact page
 * Independent component. Edits here do NOT affect other pages.
 */
---

<section class="contact-hero">
  <div class="contact-hero-bg"></div>
  <div class="contact-hero-grid-overlay"></div>
  <div class="contact-hero-orb contact-hero-orb-1"></div>
  <div class="contact-hero-orb contact-hero-orb-2"></div>

  <div class="contact-hero-inner">
    <span class="contact-hero-eyebrow">
      <span class="contact-hero-dot"></span>
      Get in Touch
    </span>
    <h1 class="contact-hero-title">
      We Would Love to
      <span class="contact-hero-grad">Hear From You</span>
    </h1>
    <p class="contact-hero-sub">
      Questions, feedback, partnership ideas, or topic requests — every message is read by a
      real person. We respond within 48 hours, usually much faster.
    </p>
    <div class="contact-hero-actions">
      <a href="#contact-form" class="contact-btn contact-btn-primary">
        Send a Message
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/community" class="contact-btn contact-btn-secondary">Join Community Instead</a>
    </div>
  </div>
</section>
