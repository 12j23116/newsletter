---
/**
 * ContactChannels — Contact channel options section
 * Independent component. Edits here do NOT affect other pages.
 */
const channels = [
  {
    icon: 'M22 6l-10 7L2 6M2 6h20v12H2z',
    title: 'General Inquiries',
    desc: 'Questions about our content, topics, or anything else.',
    value: 'hello@technanoai.com',
    href: 'mailto:hello@technanoai.com',
    color: '#3b82f6',
    label: 'Email Us',
  },
  {
    icon: 'M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z',
    title: 'Partnerships',
    desc: 'Collaborations, sponsorships, and strategic partnerships.',
    value: 'partners@technanoai.com',
    href: 'mailto:partners@technanoai.com',
    color: '#8b5cf6',
    label: 'Email Partnerships',
  },
  {
    icon: 'M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
    title: 'Contributor Pitches',
    desc: 'Want to write for us? Share your expertise with 240K+ readers.',
    value: 'contribute@technanoai.com',
    href: 'mailto:contribute@technanoai.com',
    color: '#10b981',
    label: 'Email Contributors',
  },
  {
    icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM22 6l-10 7L2 6',
    title: 'Press & Media',
    desc: 'Interview requests, press kits, and media inquiries.',
    value: 'press@technanoai.com',
    href: 'mailto:press@technanoai.com',
    color: '#f59e0b',
    label: 'Email Press',
  },
];

---

<section class="contact-channels-section">
  <div class="contact-container">
    <div class="contact-section-head contact-section-head-center">
      <span class="contact-eyebrow">Direct Channels</span>
      <h2 class="contact-section-title">Reach the Right Team</h2>
      <p class="contact-section-sub">
        Different questions go to different teams. Pick the channel that matches your
        inquiry for the fastest response.
      </p>
    </div>

    <div class="contact-channels-grid">
      {channels.map((ch) => (
        <a href={ch.href} class="contact-channel-card" style={`--card-color:${ch.color}`}>
          <div class="contact-channel-icon" style={`background:${ch.color}22;color:${ch.color}`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={ch.icon} />
            </svg>
          </div>
          <h3 class="contact-channel-title">{ch.title}</h3>
          <p class="contact-channel-desc">{ch.desc}</p>
          <div class="contact-channel-footer">
            <span class="contact-channel-value">{ch.value}</span>
            <span class="contact-channel-btn" style={`color:${ch.color}`}>{ch.label} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
