<section class="contact-social-section">
  <div class="contact-container">
    <div class="contact-social-card">
      <div class="contact-social-content">
        <span class="contact-eyebrow contact-eyebrow-center">Other Ways to Connect</span>
        <h2 class="contact-social-title">Follow Us on Social Media</h2>
        <p class="contact-social-sub">
          For quick updates, behind-the-scenes content, and real-time commentary, find us on
          your favorite platform.
        </p>
        <div class="contact-social-links">
          {socials.map((s) => (
            <a href={s.href} class="contact-social-link" style={`--social-color:${s.color}`} target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d={s.icon} />
              </svg>
              <span>{s.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
