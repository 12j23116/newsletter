---
/**
 * RecommendationsNewsletter — CTA for newsletter signup
 * Independent component. Edits here do NOT affect other pages.
 */
---

<section class="rec-newsletter-section">
  <div class="rec-container">
    <div class="rec-newsletter-card">
      <div class="rec-newsletter-bg"></div>
      <div class="rec-newsletter-content">
        <span class="rec-eyebrow rec-eyebrow-center">Stay Updated</span>
        <h2 class="rec-newsletter-title">Get New Recommendations First</h2>
        <p class="rec-newsletter-sub">
          We publish new tool reviews and comparison guides every week. Get them delivered
          to your inbox — free, no spam, unsubscribe anytime.
        </p>
        <form class="rec-newsletter-form" onsubmit="return false">
          <input type="email" class="rec-newsletter-input" placeholder="Enter your email address" required />
          <button type="submit" class="rec-btn rec-btn-primary rec-newsletter-submit">
            Subscribe Free
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
        <p class="rec-newsletter-fineprint">
          Join 50,000+ readers. By subscribing, you agree to our <a href="/privacy">Privacy Policy</a>.
        </p>
      </div>
    </div>
  </div>
</section>
