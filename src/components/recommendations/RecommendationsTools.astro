---

<section class="rec-tools-section" id="tools">
  <div class="rec-container">
    <div class="rec-section-head">
      <span class="rec-eyebrow">Tested and Recommended</span>
      <h2 class="rec-section-title">Top Tools by Technology topic</h2>
      <p class="rec-section-sub">
        We test dozens of tools in each topic and recommend only the ones we would use
        ourselves. Filter by topic to find the right tool for your project.
      </p>
    </div>

    <div class="rec-tools-topics">
      {tooltopics.map((cat) => (
        <div class="rec-tool-topic" style={`--cat-color:${cat.color}`}>
          <div class="rec-tool-topic-header">
            <span class="rec-tool-topic-icon">{cat.icon}</span>
            <h3 class="rec-tool-topic-title">{cat.topic}</h3>
          </div>
          <div class="rec-tool-grid">
            {cat.tools.map((tool) => (
              <a href={tool.href} class="rec-tool-card">
                <div class="rec-tool-card-header">
                  <h4 class="rec-tool-name">{tool.name}</h4>
                  <span class="rec-tool-rating">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {tool.rating}
                  </span>
                </div>
                <p class="rec-tool-desc">{tool.desc}</p>
                <span class="rec-tool-tag">{tool.tag}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
