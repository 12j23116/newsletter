---
import './navbar.css';
import BrandLogo from '../BrandLogo.astro';

const iconPaths: Record<string, string> = {
  cpu: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  dna: '<path d="M2 15c6.667-6 13.333 0 20-6-6.667 6-13.333 0-20 6z"/><path d="M9 22c1.798-1.998 2.518-3.995 2.807-5.993"/><path d="M15 2c-1.798 1.998-2.518 3.995-2.807 5.993"/><path d="m17 6-2.5-2.5"/><path d="m7 18 2.5 2.5"/>',
  atom: '<circle cx="12" cy="12" r="1"/><path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5z"/><path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5z"/>',
  battery: '<rect width="16" height="10" x="2" y="7" rx="2" ry="2"/><line x1="22" x2="16" y1="11" y2="11"/><line x1="6" x2="6" y1="11" y2="13"/><line x1="10" x2="10" y1="11" y2="13"/><line x1="14" x2="14" y1="11" y2="13"/>',
  bot: '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9L18.4 8.5c-.3-.8-1-1.3-1.9-1.3H7.5c-.8 0-1.6.5-1.9 1.3l-2.1 4.6C2.7 11.3 2 12.1 2 13v3c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  sparkles: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/>',
  flask: '<path d="M10 2v7.31"/><path d="M14 9.3V1.99"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><path d="M5.52 16h12.96"/>',
  chip: '<rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V4"/><path d="M8 4h8"/><circle cx="8" cy="14" r="1"/><circle cx="16" cy="14" r="1"/><path d="M8 17h8"/>',
  flame: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
};

const topics = [
  { label: 'Artificial Intelligence', href: '/topics/AI', icon: 'cpu', color: '#3b82f6', desc: 'LLMs, agents & the race to AGI' },
  { label: 'Cybersecurity', href: '/topics/Cybersecurity', icon: 'shield', color: '#ef4444', desc: 'Post-quantum crypto & AI defense' },
  { label: 'Space Exploration', href: '/topics/Space', icon: 'rocket', color: '#06b6d4', desc: 'Launch vehicles & lunar economy' },
  { label: 'Biotechnology', href: '/topics/Biotech', icon: 'dna', color: '#10b981', desc: 'CRISPR, mRNA & lab-grown organs' },
  { label: 'Nuclear Energy', href: '/topics/Nuclear', icon: 'atom', color: '#f59e0b', desc: 'SMRs & next-gen fission reactors' },
  { label: 'Energy Storage', href: '/topics/Energy-Storage', icon: 'battery', color: '#f97316', desc: 'Solid-state batteries & grid storage' },
  { label: 'Robotics', href: '/topics/Robotics', icon: 'bot', color: '#ec4899', desc: 'Humanoids, drones & automation' },
  { label: 'Autonomous Vehicles', href: '/topics/AV', icon: 'car', color: '#8b5cf6', desc: 'Robotaxis & Level 4 autonomy' },
  { label: 'Quantum Computing', href: '/topics/Quantum', icon: 'sparkles', color: '#a78bfa', desc: 'Qubits & quantum advantage' },
  { label: 'Advanced Materials', href: '/topics/Materials', icon: 'flask', color: '#f43f5e', desc: 'Graphene & superconductors' },
  { label: 'Brain-Computer Interfaces', href: '/topics/BCI', icon: 'chip', color: '#0ea5e9', desc: 'Neural implants & EEG control' },
  { label: 'Nuclear Fusion', href: '/topics/Fusion', icon: 'flame', color: '#fb923c', desc: 'Tokamaks & path to net power' },
];

const navLinks = [
  { label: 'Tools', href: '/tools' },
  { label: 'Trending', href: '/trending' },
];

const resourcesLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'Guides', href: '/guides' },
  { label: 'Podcast', href: '/podcast' },
];

const hubLinks = [
  { label: 'Resources', href: '/resources' },
  { label: 'Comparisons', href: '/comparisons' },
  { label: 'Glossary', href: '/glossary' },
];

const aboutLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'Community', href: '/community' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'Recommendations', href: '/recommendations' },
];
---

<nav class="navbar">
  <div class="lv-container">
    <div class="navbar-bar">
      <!-- Logo -->
      <a href="/" class="navbar-logo" aria-label="TechNanoAI home">
        <BrandLogo size={34} class="navbar-logo-icon" />
        <span class="navbar-logo-text">TechNanoAI</span>
      </a>

      <!-- Desktop Nav -->
      <div class="navbar-nav">
        <a href="/" class="navbar-link">Home</a>

        <!-- topics Mega Menu -->
        <div class="navbar-dd" id="nav-topics-dropdown">
          <button class="navbar-dd-btn" type="button" aria-expanded="false" aria-haspopup="true">
            topics
            <svg class="navbar-dd-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="navbar-mega" id="nav-mega-menu">
            <div class="navbar-mega-grid">
              {topics.map((cat) => (
                <a href={cat.href} class="navbar-mega-item">
                  <span class="navbar-mega-icon" style={`color:${cat.color}`}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[cat.icon]} />
                  </span>
                  <span class="navbar-mega-text">
                    <span class="navbar-mega-label">{cat.label}</span>
                    <span class="navbar-mega-desc">{cat.desc}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/tools" class="navbar-link">Tools</a>

        <!-- Resources Dropdown -->
        <div class="navbar-dd" id="nav-resources-dropdown">
          <button class="navbar-dd-btn" type="button" aria-expanded="false" aria-haspopup="true">
            Resources
            <svg class="navbar-dd-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="navbar-simple" id="nav-resources-menu">
            {resourcesLinks.map((link) => (
              <a href={link.href} class="navbar-simple-link">{link.label}</a>
            ))}
          </div>
        </div>

        <a href="/trending" class="navbar-link">Trending</a>

        <a href="/news" class="navbar-link">News</a>

        <!-- Hub Dropdown -->
        <div class="navbar-dd" id="nav-hub-dropdown">
          <button class="navbar-dd-btn" type="button" aria-expanded="false" aria-haspopup="true">
            Hub
            <svg class="navbar-dd-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="navbar-simple" id="nav-hub-menu">
            {hubLinks.map((link) => (
              <a href={link.href} class="navbar-simple-link">{link.label}</a>
            ))}
          </div>
        </div>

        <a href="/faq" class="navbar-link">FAQ</a>

        <!-- About Dropdown -->
        <div class="navbar-dd" id="nav-about-dropdown">
          <button class="navbar-dd-btn" type="button" aria-expanded="false" aria-haspopup="true">
            About
            <svg class="navbar-dd-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="navbar-simple" id="nav-about-menu">
            {aboutLinks.map((link) => (
              <a href={link.href} class="navbar-simple-link">{link.label}</a>
            ))}
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="navbar-actions">
        <a href="/search" class="navbar-search" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </a>
        <a href="/newsletter" class="navbar-cta">Subscribe</a>
        <button class="navbar-toggle" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="navbar-mobile">
    <a href="/search" class="navbar-mobile-link">🔍 Search</a>
    <a href="/" class="navbar-mobile-link">Home</a>
    <div class="navbar-mobile-label">topics</div>
    {topics.map((cat) => (
      <a href={cat.href} class="navbar-mobile-link">
        <svg class="navbar-mobile-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={cat.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[cat.icon]} />
        {cat.label}
      </a>
    ))}
    <a href="/tools" class="navbar-mobile-link">Tools</a>
    <div class="navbar-mobile-label">Resources</div>
    {resourcesLinks.map((link) => (
      <a href={link.href} class="navbar-mobile-link">{link.label}</a>
    ))}
    <a href="/trending" class="navbar-mobile-link">Trending</a>
    <a href="/news" class="navbar-mobile-link">News</a>
    <div class="navbar-mobile-label">Hub</div>
    {hubLinks.map((link) => (
      <a href={link.href} class="navbar-mobile-link">{link.label}</a>
    ))}
    <a href="/faq" class="navbar-mobile-link">FAQ</a>
    <div class="navbar-mobile-label">About</div>
    {aboutLinks.map((link) => (
      <a href={link.href} class="navbar-mobile-link">{link.label}</a>
    ))}
  </div>
</nav>

<script>
  // Desktop dropdowns (hover + click)
  const setupDropdown = (dropdownId, menuId) => {
    const dropdown = document.getElementById(dropdownId);
    const menu = document.getElementById(menuId);
    const trigger = dropdown?.querySelector('.navbar-dd-btn');
    if (!dropdown || !menu || !trigger) return;
    let timeout;
    dropdown.addEventListener('mouseenter', () => {
      clearTimeout(timeout);
      menu.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    });
    dropdown.addEventListener('mouseleave', () => {
      timeout = setTimeout(() => {
        menu.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }, 150);
    });
    trigger.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });
  };
  setupDropdown('nav-topics-dropdown', 'nav-mega-menu');
  setupDropdown('nav-resources-dropdown', 'nav-resources-menu');
  setupDropdown('nav-hub-dropdown', 'nav-hub-menu');
  setupDropdown('nav-about-dropdown', 'nav-about-menu');

  // Close dropdowns on outside click
  document.addEventListener('click', (e) => {
    const catDropdown = document.getElementById('nav-topics-dropdown');
    const catMenu = document.getElementById('nav-mega-menu');
    const catTrigger = catDropdown?.querySelector('.navbar-dd-btn');
    const resourcesDropdown = document.getElementById('nav-resources-dropdown');
    const resourcesMenu = document.getElementById('nav-resources-menu');
    const resourcesTrigger = resourcesDropdown?.querySelector('.navbar-dd-btn');
    const hubDropdown = document.getElementById('nav-hub-dropdown');
    const hubMenu = document.getElementById('nav-hub-menu');
    const hubTrigger = hubDropdown?.querySelector('.navbar-dd-btn');
    const aboutDropdown = document.getElementById('nav-about-dropdown');
    const aboutMenu = document.getElementById('nav-about-menu');
    const aboutTrigger = aboutDropdown?.querySelector('.navbar-dd-btn');
    if (catDropdown && !catDropdown.contains(e.target)) {
      catMenu?.classList.remove('open');
      catTrigger?.setAttribute('aria-expanded', 'false');
    }
    if (resourcesDropdown && !resourcesDropdown.contains(e.target)) {
      resourcesMenu?.classList.remove('open');
      resourcesTrigger?.setAttribute('aria-expanded', 'false');
    }
    if (hubDropdown && !hubDropdown.contains(e.target)) {
      hubMenu?.classList.remove('open');
      hubTrigger?.setAttribute('aria-expanded', 'false');
    }
    if (aboutDropdown && !aboutDropdown.contains(e.target)) {
      aboutMenu?.classList.remove('open');
      aboutTrigger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Mobile menu toggle
  const toggle = document.querySelector('.navbar-toggle');
  const mobileMenu = document.querySelector('.navbar-mobile');
  if (toggle && mobileMenu) {
    toggle.addEventListener('click', () => {
      toggle.classList.toggle('open');
      mobileMenu.classList.toggle('open');
    });
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.classList.remove('open');
        mobileMenu.classList.remove('open');
      });
    });
  }
</script>
