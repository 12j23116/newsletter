---
import './footer.css';
import BrandLogo from '../BrandLogo.astro';

const footerLinks = {
  topics: [
    { label: 'AI', href: '/topics/AI' },
    { label: 'Cybersecurity', href: '/topics/Cybersecurity' },
    { label: 'Space', href: '/topics/Space' },
    { label: 'Biotech', href: '/topics/Biotech' },
    { label: 'Nuclear', href: '/topics/Nuclear' },
    { label: 'Energy Storage', href: '/topics/Energy-Storage' },
    { label: 'Robotics', href: '/topics/Robotics' },
    { label: 'Quantum', href: '/topics/Quantum' },
    { label: 'Fusion', href: '/topics/Fusion' },
    { label: 'BCI', href: '/topics/BCI' },
  ],
  resources: [
    { label: 'News', href: '/news' },
    { label: 'Blog', href: '/blog' },
    { label: 'Guides', href: '/guides' },
    { label: 'Podcast', href: '/podcast' },
    { label: 'Tools', href: '/tools' },
    { label: 'Comparisons', href: '/comparisons' },
    { label: 'Glossary', href: '/glossary' },
    { label: 'Trending', href: '/trending' },
  ],
  company: [
    { label: 'About', href: '/about' },
    { label: 'Newsletter', href: '/newsletter' },
    { label: 'Community', href: '/community' },
    { label: 'Contact', href: '/contact' },
  ],
  legal: [
    { label: 'Privacy', href: '/privacy' },
    { label: 'Terms', href: '/terms' },
    { label: 'Cookies', href: '/cookies' },
  ],
};

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="TechNanoAI home">
          <BrandLogo size={28} class="footer-logo-icon" />
          <span class="footer-logo-text">TechNanoAI</span>
        </a>
        <p class="footer-tagline">12 emerging technology frontiers, explained simply.</p>
        <div class="footer-social">
          <a href="https://twitter.com/TechNanoAI" class="footer-social-link" aria-label="Twitter / X" rel="noopener" target="_blank">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.91l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://github.com/TechNanoAI" class="footer-social-link" aria-label="GitHub" rel="noopener" target="_blank">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <a href="https://www.youtube.com/@TechNanoAI" class="footer-social-link" aria-label="YouTube" rel="noopener" target="_blank">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="/rss.xml" class="footer-social-link" aria-label="RSS Feed">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M6.503 20.752c0 1.426-1.158 2.585-2.583 2.585-1.425 0-2.583-1.159-2.583-2.585 0-1.425 1.158-2.584 2.583-2.584 1.425 0 2.583 1.159 2.583 2.584zm-5.503-12.572v3.811c5.361 0 9.72 4.359 9.72 9.721h3.811c.001-7.466-6.065-13.532-13.531-13.532zm0-6.68v3.808c9.617 0 17.448 7.831 17.448 17.448h3.807c0-11.726-9.529-21.256-21.255-21.256z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">Topics</h4>
        <div class="footer-col-links">
          {footerLinks.topics.map((link) => (
            <a href={link.href} class="footer-col-link">{link.label}</a>
          ))}
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">Resources</h4>
        <div class="footer-col-links">
          {footerLinks.resources.map((link) => (
            <a href={link.href} class="footer-col-link">{link.label}</a>
          ))}
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">Company</h4>
        <div class="footer-col-links">
          {footerLinks.company.map((link) => (
            <a href={link.href} class="footer-col-link">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">&copy; {currentYear} TechNanoAI. All rights reserved.</p>
      <div class="footer-legal">
        {footerLinks.legal.map((link) => (
          <a href={link.href} class="footer-legal-link">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
