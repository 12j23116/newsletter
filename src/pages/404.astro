---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '404 — Page Not Found';
const description = 'The page you are looking for does not exist or has been moved.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="nf-page">
    <div class="nf-bg">
      <div class="nf-grid"></div>
      <div class="nf-orb nf-orb-1"></div>
      <div class="nf-orb nf-orb-2"></div>
    </div>
    <div class="nf-inner">
      <div class="nf-code">404</div>
      <h1 class="nf-title">Page Not Found</h1>
      <p class="nf-desc">The page you're looking for doesn't exist or has been moved. Let's get you back on track.</p>
      <div class="nf-actions">
        <a href="/" class="nf-btn nf-btn-primary">Back to Home</a>
        <a href="/search" class="nf-btn nf-btn-ghost">Search the site</a>
      </div>
      <div class="nf-links">
        <a href="/topics/AI">AI</a>
        <a href="/topics/Cybersecurity">Cybersecurity</a>
        <a href="/topics/Space">Space</a>
        <a href="/topics/Biotech">Biotech</a>
        <a href="/topics/Nuclear">Nuclear</a>
        <a href="/blog">Blog</a>
        <a href="/guides">Guides</a>
        <a href="/tools">Tools</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .nf-page {
    position: relative;
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0a0a0f;
  }
  .nf-bg { position: absolute; inset: 0; pointer-events: none; }
  .nf-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  .nf-orb {
    position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.3;
  }
  .nf-orb-1 { width: 400px; height: 400px; background: #3b82f6; top: 10%; left: 10%; }
  .nf-orb-2 { width: 350px; height: 350px; background: #8b5cf6; bottom: 10%; right: 10%; }
  .nf-inner { position: relative; z-index: 1; text-align: center; padding: 2rem; max-width: 600px; }
  .nf-code {
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }
  .nf-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .nf-desc {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .nf-actions { display: flex; gap: 1rem; justify-content: center; margin-bottom: 2.5rem; flex-wrap: wrap; }
  .nf-btn {
    padding: 0.75rem 1.75rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    text-decoration: none;
  }
  .nf-btn-primary {
    background: #3b82f6;
    color: #fff;
  }
  .nf-btn-primary:hover { background: #2563eb; transform: translateY(-2px); }
  .nf-btn-ghost {
    border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.8);
  }
  .nf-btn-ghost:hover { border-color: rgba(255,255,255,0.3); color: #fff; }
  .nf-links { display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap; }
  .nf-links a {
    color: rgba(255,255,255,0.5);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nf-links a:hover { color: #3b82f6; }
</style>
