---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Privacy Policy';
const description = 'TechNanoAI privacy policy — how we collect, use, and protect your data. Information on cookies, analytics, email subscriptions, and your rights under GDPR and CCPA.';
const keywords = 'privacy policy, TechNanoAI privacy, data protection, GDPR, CCPA, cookies, data collection';

const lastUpdated = 'January 2026';
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <div class="legal-page">
    <div class="legal-container">
      <h1>Privacy Policy</h1>
      <p class="legal-updated">Last updated: {lastUpdated}</p>

      <section>
        <h2>1. Information We Collect</h2>
        <p>TechNanoAI ("we", "us", "our") operates technanoai.com. We are committed to protecting your privacy. This policy explains what information we collect and how we use it.</p>
        <h3>Information You Provide</h3>
        <ul>
          <li><strong>Email address</strong> — when you subscribe to our newsletter or podcast notifications.</li>
          <li><strong>Contact form submissions</strong> — name, email, and message content when you reach out to us.</li>
          <li><strong>Tool requests</strong> — tool name, URL, topic, and your email when you recommend a tool.</li>
        </ul>
        <h3>Information Collected Automatically</h3>
        <ul>
          <li><strong>Usage data</strong> — pages visited, time on page, referral source, browser type, and device information.</li>
          <li><strong>IP address</strong> — used for analytics and security purposes, not stored permanently.</li>
        </ul>
      </section>

      <section>
        <h2>2. How We Use Your Information</h2>
        <ul>
          <li>To deliver and improve our content, tools, and services.</li>
          <li>To send our weekly newsletter and podcast notifications (only if you opt in).</li>
          <li>To respond to your inquiries and tool requests.</li>
          <li>To analyze website traffic and user behavior to improve user experience.</li>
          <li>To detect and prevent fraud, abuse, and security threats.</li>
        </ul>
      </section>

      <section>
        <h2>3. Cookies</h2>
        <p>We use minimal cookies and similar technologies. See our <a href="/cookies">Cookie Policy</a> for details. We do not sell your data to third parties.</p>
      </section>

      <section>
        <h2>4. Third-Party Services</h2>
        <p>We use the following third-party services that may collect limited data:</p>
        <ul>
          <li><strong>Google Analytics</strong> — anonymous usage statistics.</li>
          <li><strong>Email provider</strong> — to manage newsletter subscriptions.</li>
          <li><strong>Podcast hosting platforms</strong> — Apple Podcasts, Spotify, Google Podcasts (each has its own privacy policy).</li>
        </ul>
      </section>

      <section>
        <h2>5. Your Rights</h2>
        <h3>GDPR (EU/UK Users)</h3>
        <ul>
          <li>Right to access your personal data.</li>
          <li>Right to rectification of inaccurate data.</li>
          <li>Right to erasure ("right to be forgotten").</li>
          <li>Right to restrict or object to processing.</li>
          <li>Right to data portability.</li>
        </ul>
        <h3>CCPA (California Users)</h3>
        <ul>
          <li>Right to know what personal information we collect.</li>
          <li>Right to delete your personal information.</li>
          <li>Right to opt out of the sale of personal information (we do not sell your data).</li>
          <li>Right to non-discrimination for exercising your rights.</li>
        </ul>
        <p>To exercise any of these rights, contact us at <a href="mailto:privacy@technanoai.com">privacy@technanoai.com</a>.</p>
      </section>

      <section>
        <h2>6. Data Security</h2>
        <p>We implement industry-standard security measures including HTTPS encryption, secure data storage, and access controls. However, no method of transmission over the internet is 100% secure.</p>
      </section>

      <section>
        <h2>7. Children's Privacy</h2>
        <p>Our website is not directed to children under 13. We do not knowingly collect personal information from children. If you believe a child has provided us information, please contact us.</p>
      </section>

      <section>
        <h2>8. Changes to This Policy</h2>
        <p>We may update this Privacy Policy from time to time. We will notify you of significant changes by posting the new policy on this page and updating the "Last updated" date.</p>
      </section>

      <section>
        <h2>9. Contact Us</h2>
        <p>If you have questions about this Privacy Policy, please contact us at <a href="mailto:privacy@technanoai.com">privacy@technanoai.com</a> or visit our <a href="/contact">contact page</a>.</p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-page {
    padding: 2rem 1.5rem 4rem;
    background: var(--bg, #0a0a0f);
    color: var(--text, #e4e4e7);
    min-height: 60vh;
  }
  .legal-container {
    max-width: 760px;
    margin: 0 auto;
  }
  .legal-container h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .legal-updated {
    color: #888;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  .legal-container section {
    margin-bottom: 2rem;
  }
  .legal-container h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .legal-container h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 1rem 0 0.5rem;
  }
  .legal-container p {
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }
  .legal-container ul {
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .legal-container li {
    line-height: 1.7;
    margin-bottom: 0.4rem;
  }
  .legal-container a {
    color: #3b82f6;
    text-decoration: underline;
  }
</style>
