---
/**
 * [slug].astro — Individual Blog Post Page
 * ───────────────────────────────────────────
 * Uses getStaticPaths() to pre-generate one HTML file per article.
 * Data comes from blog-content.ts (metadata) + blog-posts.ts (body content).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import './blog-post.css';
import { allPosts, type BlogPost } from '../../data/blog/blog-content';
import { blogPostContent, type BlogPostSection } from '../../data/blog/blog-posts';

export function getStaticPaths() {
  return allPosts.map((post: BlogPost) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props as Props;
const article = blogPostContent[post.slug];
const hasContent = !!article;

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const formattedDate = formatDate(post.date);

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.topic === post.topic)
  .slice(0, 3);

const fallbackRelated = allPosts
  .filter((p) => p.slug !== post.slug && !relatedPosts.includes(p))
  .slice(0, 3);

const finalRelated = relatedPosts.length >= 3 ? relatedPosts : [...relatedPosts, ...fallbackRelated].slice(0, 3);

const readingProgressScript = `
window.addEventListener('scroll', () => {
  const bar = document.getElementById('bp-progress-bar');
  if (!bar) return;
  const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
  const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
  const scrolled = (winScroll / height) * 100;
  bar.style.width = scrolled + '%';
});
`;

const tocScript = `
document.querySelectorAll('.bp-toc-link').forEach(link => {
  link.addEventListener('click', (e) => {
    e.preventDefault();
    const targetId = link.getAttribute('href').slice(1);
    const target = document.getElementById(targetId);
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
});
`;

const shareScript = `
function copyLink() {
  navigator.clipboard.writeText(window.location.href).then(() => {
    const btn = document.querySelector('.bp-share-copy');
    if (btn) {
      const orig = btn.innerHTML;
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
      setTimeout(() => { btn.innerHTML = orig; }, 2000);
    }
  });
}
document.querySelector('.bp-share-copy')?.addEventListener('click', copyLink);
`;

const blogUrl = `https://technanoai.com/blog/${post.slug}`;
const blogImage = hasContent ? article.heroImage : (post.image ? post.image : '/images/og-default.webp');
const blogImageAbs = blogImage.startsWith('http') ? blogImage : `https://technanoai.com${blogImage}`;

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: hasContent ? article.subtitle : post.excerpt,
  author: { '@type': 'Person', name: post.author },
  publisher: {
    '@type': 'Organization',
    name: 'TechNanoAI',
    logo: { '@type': 'ImageObject', url: 'https://technanoai.com/images/logo/technanoai-icon-32.png' },
  },
  articleSection: post.topic,
  keywords: post.tags.join(', '),
  datePublished: post.date,
  dateModified: post.date,
  image: blogImageAbs,
  url: blogUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': blogUrl },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://technanoai.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://technanoai.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.title, item: blogUrl },
  ],
};
---

<BaseLayout title={post.title} description={hasContent ? article.subtitle : post.excerpt} type="article" image={blogImage} keywords={post.tags.join(', ')} publishedDate={post.date} section={post.topic}>
  <!-- Reading progress bar -->
  <div class="bp-progress-track" aria-hidden="true">
    <div class="bp-progress-bar" id="bp-progress-bar" style={`background: ${post.topicColor};`}></div>
  </div>

  <article class="bp-article" data-topic={post.topic.toLowerCase()}>
    <!-- Hero Section -->
    <header class="bp-hero" style={`--cat-color: ${post.topicColor};`}>
      <div class="bp-hero-bg">
        <img src={hasContent ? article.heroImage : '/images/001-ai-neural-agent-cluster.webp'} alt={post.title} loading="eager" class="bp-hero-img" />
        <div class="bp-hero-overlay"></div>
      </div>
      <div class="bp-hero-content">
        <a href="/blog" class="bp-back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Blog
        </a>
        <div class="bp-hero-meta">
          <span class="bp-topic-badge" style={`background: ${post.topicColor};`}>{post.topic}</span>
          <span class="bp-read-time">{post.readTime}</span>
        </div>
        <h1 class="bp-hero-title">{post.title}</h1>
        <p class="bp-hero-subtitle">{hasContent ? article.subtitle : post.excerpt}</p>
        <div class="bp-author-row">
          <div class="bp-author-avatar" style={`background: linear-gradient(135deg, ${post.topicColor}, ${post.topicColor}88);`}>
            {post.author.split(' ').map(n => n[0]).join('')}
          </div>
          <div class="bp-author-info">
            <span class="bp-author-name">{post.author}</span>
            <span class="bp-author-role">{post.authorRole} · {formattedDate}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Body: TOC sidebar + content -->
    <div class="bp-body">
      {hasContent ? (
        <>
          <!-- Table of Contents -->
          <aside class="bp-toc">
            <h3 class="bp-toc-title">Contents</h3>
            <nav class="bp-toc-nav">
              {article.sections
                .filter((s: BlogPostSection) => s.type === 'h2')
                .map((s: BlogPostSection, i: number) => (
                  <a href={`#section-${i}`} class="bp-toc-link" data-index={i}>
                    {s.text}
                  </a>
                ))}
            </nav>
          </aside>

          <!-- Main content -->
          <div class="bp-content">
            <!-- Key Takeaways -->
            <section class="bp-takeaways">
              <h2 class="bp-takeaways-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                Key Takeaways
              </h2>
              <ul class="bp-takeaways-list">
                {article.keyTakeaways.map((kt: string) => (
                  <li class="bp-takeaway-item">{kt}</li>
                ))}
              </ul>
            </section>

            <!-- Article sections -->
            {article.sections.map((section: BlogPostSection, i: number) => {
          if (section.type === 'h2') {
            return <h2 class="bp-section-h2" id={`section-${i}`} data-toc-index={i}>{section.text}</h2>;
          }
          if (section.type === 'h3') {
            return <h3 class="bp-section-h3">{section.text}</h3>;
          }
          if (section.type === 'p') {
            return <p class="bp-section-p">{section.text}</p>;
          }
          if (section.type === 'quote') {
            return (
              <blockquote class="bp-quote">
                <p class="bp-quote-text">{section.text}</p>
                {section.author && <cite class="bp-quote-author">— {section.author}</cite>}
              </blockquote>
            );
          }
          if (section.type === 'ul') {
            return (
              <ul class="bp-list">
                {section.items?.map((item: string) => <li class="bp-list-item">{item}</li>)}
              </ul>
            );
          }
          if (section.type === 'ol') {
            return (
              <ol class="bp-list bp-list-ordered">
                {section.items?.map((item: string) => <li class="bp-list-item">{item}</li>)}
              </ol>
            );
          }
          if (section.type === 'callout') {
            return (
              <div class={`bp-callout bp-callout-${section.variant || 'info'}`}>
                {section.title && <div class="bp-callout-title">{section.title}</div>}
                <div class="bp-callout-text">{section.text}</div>
              </div>
            );
          }
          if (section.type === 'stats') {
            return (
              <div class="bp-stats-grid">
                {section.stats?.map((stat: { label: string; value: string; change?: string }) => (
                  <div class="bp-stat-card">
                    <div class="bp-stat-value" style={`color: ${post.topicColor};`}>{stat.value}</div>
                    <div class="bp-stat-label">{stat.label}</div>
                    {stat.change && <div class="bp-stat-change">{stat.change}</div>}
                  </div>
                ))}
              </div>
            );
          }
          if (section.type === 'image') {
            return (
              <figure class="bp-figure">
                <img src={section.src} alt={section.caption || ''} loading="lazy" class="bp-figure-img" />
                {section.caption && <figcaption class="bp-figure-caption">{section.caption}</figcaption>}
              </figure>
            );
          }
          return null;
        })}

        <!-- Tags -->
        <div class="bp-tags">
          {post.tags.map((tag: string) => (
            <span class="bp-tag" style={`border-color: ${post.topicColor}44; color: ${post.topicColor};`}>{tag}</span>
          ))}
        </div>

        <!-- Share buttons -->
        <div class="bp-share">
          <span class="bp-share-label">Share this article</span>
          <div class="bp-share-buttons">
            <a class="bp-share-btn bp-share-twitter" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" aria-label="Share on Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a class="bp-share-btn bp-share-linkedin" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
            </a>
            <button class="bp-share-btn bp-share-copy" aria-label="Copy link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
          </div>
        </div>

        <!-- Author bio -->
        <div class="bp-author-bio" style={`border-left-color: ${post.topicColor};`}>
          <div class="bp-bio-avatar" style={`background: linear-gradient(135deg, ${post.topicColor}, ${post.topicColor}88);`}>
            {post.author.split(' ').map(n => n[0]).join('')}
          </div>
          <div class="bp-bio-content">
            <div class="bp-bio-name">{post.author}</div>
            <div class="bp-bio-role">{post.authorRole}</div>
            <p class="bp-bio-text">Contributing writer at TechNanoAI covering {post.topic} and emerging technologies. Bringing you the latest breakthroughs with rigorous analysis and expert commentary.</p>
          </div>
        </div>
      </div>
        </>
      ) : (
        <div class="bp-content">
          <div class="bp-callout bp-callout-info" style="margin-top: 2rem;">
            <div class="bp-callout-title">Article Coming Soon</div>
            <div class="bp-callout-text">This article is scheduled for publication. The full in-depth analysis will be available soon. In the meantime, explore related content below.</div>
          </div>
          <p class="bp-section-p" style="margin-top: 1.5rem;">{post.excerpt}</p>

          <div class="bp-tags" style="margin-top: 2rem;">
            {post.tags.map((tag: string) => (
              <span class="bp-tag" style={`border-color: ${post.topicColor}44; color: ${post.topicColor};`}>{tag}</span>
            ))}
          </div>

          <div class="bp-share" style="margin-top: 2rem;">
            <span class="bp-share-label">Share this article</span>
            <div class="bp-share-buttons">
              <a class="bp-share-btn bp-share-twitter" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" aria-label="Share on Twitter">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a class="bp-share-btn bp-share-linkedin" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
              </a>
              <button class="bp-share-btn bp-share-copy" aria-label="Copy link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              </button>
            </div>
          </div>

          <div class="bp-author-bio" style={`border-left-color: ${post.topicColor};`}>
            <div class="bp-bio-avatar" style={`background: linear-gradient(135deg, ${post.topicColor}, ${post.topicColor}88);`}>
              {post.author.split(' ').map(n => n[0]).join('')}
            </div>
            <div class="bp-bio-content">
              <div class="bp-bio-name">{post.author}</div>
              <div class="bp-bio-role">{post.authorRole}</div>
              <p class="bp-bio-text">Contributing writer at TechNanoAI covering {post.topic} and emerging technologies. Bringing you the latest breakthroughs with rigorous analysis and expert commentary.</p>
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Related Posts -->
    {finalRelated.length > 0 && (
      <section class="bp-related">
        <h2 class="bp-related-title">More from {post.topic}</h2>
        <div class="bp-related-grid">
          {finalRelated.map((rp: BlogPost) => (
            <a href={`/blog/${rp.slug}`} class="bp-related-card">
              <div class="bp-related-badge" style={`background: ${rp.topicColor};`}>{rp.topic}</div>
              <h3 class="bp-related-card-title">{rp.title}</h3>
              <p class="bp-related-card-excerpt">{rp.excerpt}</p>
              <div class="bp-related-card-meta">
                <span>{rp.readTime}</span>
                <span>·</span>
                <span>{formatDate(rp.date)}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Newsletter CTA -->
    <section class="bp-newsletter">
      <div class="bp-newsletter-inner">
        <h2 class="bp-newsletter-title">Stay on the frontier</h2>
        <p class="bp-newsletter-text">Get the latest in emerging tech — AI, fusion, quantum, biotech, and more — delivered to your inbox weekly.</p>
        <form class="bp-newsletter-form" onsubmit="return false;">
          <input type="email" placeholder="you@example.com" class="bp-newsletter-input" aria-label="Email address" />
          <button type="submit" class="bp-newsletter-btn" style={`background: ${post.topicColor};`}>Subscribe</button>
        </form>
      </div>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(blogLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script is:inline set:html={readingProgressScript + tocScript + shareScript}></script>
</BaseLayout>
