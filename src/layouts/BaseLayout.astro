---
/**
 * BaseLayout — HTML shell shared by all pages
 * ───────────────────────────────────────────
 * Loads global styles + Header + Footer.
 * Page-specific styles are imported by each page, not here.
 */
import '../styles/general.css';
import '../styles/desktop.css';
import '../styles/tablet.css';
import '../styles/phone.css';
import '../styles/phone-small.css';

import Navbar from '../components/landing/Navbar.astro';
import Footer from '../components/Footer/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'news';
  keywords?: string;
  publishedDate?: string;
  section?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Deep-dive guides on 12 emerging technology frontiers. Explained simply, backed by research.',
  image,
  type = 'website',
  keywords,
  publishedDate,
  section,
  noindex = false,
} = Astro.props;

const siteName = 'TechNanoAI';
const siteUrl = 'https://technanoai.com';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImage = image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : `${siteUrl}/images/001-ai-neural-agent-cluster.webp`;

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl,
  description: 'Deep-dive analysis across 12 emerging technology frontiers: AI, Robotics, Fusion, Biotech, BCI, Autonomous Vehicles, Space, Materials, Quantum, Nuclear, Energy Storage, and Cybersecurity.',
  publisher: { '@type': 'Organization', name: siteName },
};

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteUrl,
  logo: `${siteUrl}/images/logo/technanoai-icon-32.png`,
  sameAs: [
    'https://twitter.com/TechNanoAI',
    'https://github.com/TechNanoAI',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo/technanoai-icon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo/technanoai-apple-touch.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonicalUrl} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="language" content="English" />
    <meta name="rating" content="general" />
    <meta name="revisit-after" content="3 days" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {(type === 'article' || type === 'news') && publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {(type === 'article' || type === 'news') && section && <meta property="article:section" content={section} />}
    {(type === 'article' || type === 'news') && keywords && <meta property="article:tag" content={keywords} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@TechNanoAI" />
    <meta name="twitter:creator" content="@TechNanoAI" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Structured Data — WebSite + Organization (site-wide) -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Navbar />
    <main id="main-content" style="padding-top: 64px;">
      <slot />
    </main>
    <Footer />

    <!-- Floating Action Buttons -->
    <div class="floating-actions">
      <a href="/contact" aria-label="Contact us" class="floating-btn floating-btn-contact">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
      </a>
      <button id="scrollToTop" aria-label="Scroll to top" class="floating-btn scroll-to-top">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 15l-6-6-6 6" />
        </svg>
      </button>
    </div>
    <style>
      .floating-actions {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        z-index: 9999;
      }
      .floating-btn {
        width: 40px;
        height: 40px;
        border: none;
        border-radius: var(--radius-full);
        background: var(--grad-primary);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-md), var(--shadow-glow);
        transition: opacity var(--transition-base), visibility var(--transition-base), transform var(--transition-base), background var(--transition-fast), box-shadow var(--transition-fast);
        text-decoration: none;
      }
      .floating-btn:hover {
        background: var(--grad-primary-hover);
        box-shadow: var(--shadow-lg), var(--shadow-glow);
      }
      .floating-btn:active {
        transform: scale(0.95);
      }
      .scroll-to-top {
        opacity: 0;
        visibility: hidden;
        transform: translateY(12px);
      }
      .scroll-to-top.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      @media (max-width: 640px) {
        .floating-actions {
          bottom: 1rem;
          right: 1rem;
        }
        .floating-btn {
          width: 36px;
          height: 36px;
        }
      }
    </style>
    <script>
      const scrollBtn = document.getElementById('scrollToTop');
      if (scrollBtn) {
        const toggleVisibility = () => {
          if (window.scrollY > 400) {
            scrollBtn.classList.add('visible');
          } else {
            scrollBtn.classList.remove('visible');
          }
        };
        window.addEventListener('scroll', toggleVisibility, { passive: true });
        toggleVisibility();
        scrollBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
