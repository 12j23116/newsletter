# Blog post generation script API keys
# You only need ONE of these depending on which provider you use.
#
# OpenAI (default provider, --provider=openai):
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# GLM / Z.AI (use with --provider=glm):
# Get yours at: https://z.ai/manage-apikey/apikey-list
GLM_API_KEY=your-glm-api-key-here

# ─── Daily News Generator ───────────────────────────────────────────────────
# 100% FREE by default — no API key needed!
# The script fetches RSS feeds (free) and builds articles from the feed content.
#
# To ENHANCE articles with an LLM (optional, uses your existing key above):
#   node scripts/generate-daily-news.mjs --use-llm
#
# For GitHub Actions, add as repository secrets (optional):
#   OPENAI_API_KEY (or GLM_API_KEY)
# If no secrets are set, the workflow runs in free mode automatically.
#
# Usage:
#   node scripts/generate-daily-news.mjs                     # FREE — all topics, no API key
#   node scripts/generate-daily-news.mjs --use-llm           # Enhanced with LLM (needs key)
#   node scripts/generate-daily-news.mjs --topic=ai          # Single topic
#   node scripts/generate-daily-news.mjs --max-per-topic=5   # Limit per topic
#   node scripts/generate-daily-news.mjs --dry-run           # Fetch RSS only, no files saved
#   node scripts/generate-daily-news.mjs --cleanup-only      # Just delete old articles
#
# Articles auto-expire after 14 days (configured in the script as MAX_AGE_DAYS).

# ─── Newsletter Generator ────────────────────────────────────────────────────
# Weekly newsletter generation + email sending.
# You need ONE email provider to actually send emails.
#
# SMTP (recommended, no API key needed — use Gmail/Outlook):
# Gmail: Enable 2FA → https://myaccount.google.com/apppasswords → create app password
# Outlook: Use your email + password directly
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
#
# Resend (API alternative, free tier: 100 emails/day):
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Mailgun (alternative, 5,000 emails/month free for 3 months):
# Get yours at: https://app.mailgun.com/app/account/api-keys
MAILGUN_API_KEY=your-mailgun-key-here
MAILGUN_DOMAIN=mail.technanoai.com
#
# Usage:
#   node scripts/generate-newsletter.mjs --provider=console              # Preview only (no sending)
#   node scripts/generate-newsletter.mjs --provider=smtp --send          # Generate + send via Gmail SMTP
#   node scripts/generate-newsletter.mjs --provider=resend --send        # Generate + send via Resend API
#   node scripts/generate-newsletter.mjs --provider=mailgun --send       # Generate + send via Mailgun
#   node scripts/generate-newsletter.mjs --dry-run                       # Generate but don't save or send
#
# For GitHub Actions, add as repository secrets:
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS (for Gmail/Outlook)
#   OR RESEND_API_KEY (or MAILGUN_API_KEY + MAILGUN_DOMAIN)
# The workflow runs every Monday at 07:00 UTC automatically.
#
# For Cloudflare Pages Functions (subscribe endpoint):
#   Bind a KV namespace as NEWSLETTER_KV in Pages dashboard
#   Set RESEND_API_KEY for welcome emails (optional)
