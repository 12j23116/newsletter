---
import '../shared/tool-base.css';
interface Props { toolColor: string; }
const { toolColor } = Astro.props;
---

<div class="tool-container" style={`--tool-accent: ${toolColor}`}>
  <div class="tool-header">
    <div class="tool-header-icon">🔐</div>
    <div>
      <h3 class="tool-header-title">Password Strength Auditor</h3>
      <p class="tool-header-desc">Test password strength against modern cracking techniques</p>
    </div>
  </div>

  <div class="tool-grid">
    <div class="tool-card">
      <p class="tool-card-title">Password to Test</p>
      <div class="tool-field">
        <label class="tool-label">Enter password</label>
        <input type="text" class="tool-input" id="ps-input" placeholder="Type a password..." autocomplete="off" />
      </div>
      <div class="tool-field">
        <label class="tool-label">Guess rate (guesses/sec)</label>
        <select class="tool-select" id="ps-rate">
          <option value="1e4">10K — Online attack</option>
          <option value="1e9" selected>1B — GPU crack</option>
          <option value="1e11">100B — GPU cluster</option>
          <option value="1e14">100T — Nation-state</option>
        </select>
      </div>
    </div>

    <div class="tool-output" id="ps-results"></div>
  </div>
</div>

<script is:inline>
(function() {
  const commonPasswords = ['password', '123456', '12345678', 'qwerty', 'abc123', 'monkey', '1234567', 'letmein', 'trustno1', 'dragon', 'baseball', 'iloveyou', 'master', 'sunshine', 'ashley', 'bailey', 'passw0rd', 'shadow', '123123', '654321', 'superman', 'qazwsx', 'michael', 'football'];

  function analyze() {
    const pw = document.getElementById('ps-input')?.value || '';
    const rate = parseFloat(document.getElementById('ps-rate')?.value || '1e9');
    const container = document.getElementById('ps-results');
    if (!container) return;
    if (!pw) { container.innerHTML = '<div class="tool-note">Type a password to analyze.</div>'; return; }

    const len = pw.length;
    const hasLower = /[a-z]/.test(pw);
    const hasUpper = /[A-Z]/.test(pw);
    const hasDigit = /[0-9]/.test(pw);
    const hasSpecial = /[^a-zA-Z0-9]/.test(pw);
    const hasSequence = /(abc|bcd|cde|123|234|345|456|567|678|789|890|qwe|wer|ert|rty|asd|sdf)/i.test(pw);
    const hasRepeat = /(.)\1{2,}/.test(pw);
    const isCommon = commonPasswords.includes(pw.toLowerCase());

    let charsetSize = 0;
    if (hasLower) charsetSize += 26;
    if (hasUpper) charsetSize += 26;
    if (hasDigit) charsetSize += 10;
    if (hasSpecial) charsetSize += 32;

    const entropy = len * Math.log2(charsetSize || 1);
    const combinations = Math.pow(charsetSize || 1, len);
    const secondsToCrack = combinations / (2 * rate);
    const yearsToCrack = secondsToCrack / (365.25 * 24 * 3600);

    let timeText;
    if (secondsToCrack < 1) timeText = 'Instantly';
    else if (secondsToCrack < 60) timeText = `${Math.round(secondsToCrack)} seconds`;
    else if (secondsToCrack < 3600) timeText = `${Math.round(secondsToCrack / 60)} minutes`;
    else if (secondsToCrack < 86400) timeText = `${Math.round(secondsToCrack / 3600)} hours`;
    else if (yearsToCrack < 1) timeText = `${Math.round(secondsToCrack / 86400)} days`;
    else if (yearsToCrack < 1000) timeText = `${Math.round(yearsToCrack)} years`;
    else if (yearsToCrack < 1e6) timeText = `${Math.round(yearsToCrack / 1000)}K years`;
    else if (yearsToCrack < 1e9) timeText = `${Math.round(yearsToCrack / 1e6)}M years`;
    else if (yearsToCrack < 1e12) timeText = `${Math.round(yearsToCrack / 1e9)}B years`;
    else timeText = 'Centuries+';

    let score = 0;
    if (len >= 8) score += 20; if (len >= 12) score += 15; if (len >= 16) score += 10;
    if (hasLower) score += 5; if (hasUpper) score += 10;
    if (hasDigit) score += 10; if (hasSpecial) score += 15;
    if (hasSequence) score -= 10; if (hasRepeat) score -= 10;
    if (isCommon) score = 0;
    score = Math.max(0, Math.min(100, score));

    const level = score < 30 ? 'bad' : score < 60 ? 'warn' : 'good';
    const levelText = score < 30 ? 'WEAK' : score < 60 ? 'MODERATE' : 'STRONG';

    let html = `<div class="tool-result-big">${score}<span class="tool-result-unit">/100</span></div>`;
    html += `<div style="text-align:center; margin-bottom:1rem"><span class="tool-badge tool-badge-${level}">${levelText}</span></div>`;
    html += '<div class="tool-section-title">Analysis</div>';
    html += `<div class="tool-result-row"><span class="tool-result-label">Length</span><span class="tool-result-value">${len} chars</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">Entropy</span><span class="tool-result-value">${entropy.toFixed(1)} bits</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">Character set size</span><span class="tool-result-value">${charsetSize}</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">Time to crack</span><span class="tool-result-value tool-result-value-accent">${timeText}</span></div>`;
    html += '<div class="tool-section-title">Checks</div>';
    html += `<div class="tool-result-row"><span class="tool-result-label">${hasUpper ? '✅' : '❌'} Uppercase letters</span><span class="tool-result-value">${hasUpper ? 'Present' : 'Missing'}</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">${hasLower ? '✅' : '❌'} Lowercase letters</span><span class="tool-result-value">${hasLower ? 'Present' : 'Missing'}</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">${hasDigit ? '✅' : '❌'} Numbers</span><span class="tool-result-value">${hasDigit ? 'Present' : 'Missing'}</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">${hasSpecial ? '✅' : '❌'} Special characters</span><span class="tool-result-value">${hasSpecial ? 'Present' : 'Missing'}</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">${!hasSequence ? '✅' : '⚠️'} No sequences</span><span class="tool-result-value">${!hasSequence ? 'Clean' : 'Detected'}</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">${!hasRepeat ? '✅' : '⚠️'} No repeats</span><span class="tool-result-value">${!hasRepeat ? 'Clean' : 'Detected'}</span></div>`;
    html += `<div class="tool-result-row"><span class="tool-result-label">${!isCommon ? '✅' : '❌'} Not in common list</span><span class="tool-result-value">${!isCommon ? 'Unique' : 'COMMON!'}</span></div>`;

    if (score < 60) {
      html += '<div class="tool-note">💡 Tips: Use 12+ characters with a mix of uppercase, lowercase, numbers, and symbols. Avoid sequences (abc, 123), repeated characters, and common passwords. Consider a passphrase (4+ random words).</div>';
    }

    container.innerHTML = html;
  }

  document.getElementById('ps-input')?.addEventListener('input', analyze);
  document.getElementById('ps-rate')?.addEventListener('change', analyze);
})();
</script>
