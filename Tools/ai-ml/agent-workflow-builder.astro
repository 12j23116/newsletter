---
import '../shared/tool-base.css';
interface Props { toolColor: string; }
const { toolColor } = Astro.props;
---

<div class="tool-container" style={`--tool-accent: ${toolColor}`}>
  <div class="tool-coming-soon">
    <div class="tool-coming-soon-icon">🔗</div>
    <h3 class="tool-coming-soon-title">Agent Workflow Builder</h3>
    <p class="tool-coming-soon-desc">Drag-and-drop builder for multi-agent workflows — chain LLM calls, tool use, web search, code execution, and human-in-the-loop review steps. Export to JSON or deploy directly with API keys.</p>
    <form class="tool-coming-soon-form" id="awb-notify">
      <input type="email" placeholder="you@example.com" required />
      <button type="submit" class="tool-btn">Notify Me</button>
    </form>
    <div class="tool-coming-soon-success" id="awb-success">✓ Thanks! We'll email you when this tool is ready.</div>
  </div>
</div>

<script is:inline>
document.getElementById('awb-notify')?.addEventListener('submit', function(e) {
  e.preventDefault();
  this.querySelector('input').value = '';
  document.getElementById('awb-success')?.classList.add('show');
  setTimeout(() => document.getElementById('awb-success')?.classList.remove('show'), 4000);
});
</script>
